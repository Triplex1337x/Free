# Скопируй этот файл в .env и заполни. Файл .env никому не показывай.

# Ключи приложения Telegram: my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Необязательно: с каких слов начинается команда в «Избранном» (через запятую)
TRIGGERS=клод,claude,!

# Когда спрашивать подтверждение перед отправкой:
#   compose — только если текст сочинил Claude (по умолчанию)
#   always  — всегда
#   never   — никогда
CONFIRM=compose

# Необязательно: модель Claude (opus, sonnet, haiku). Пусто = по умолчанию
CLAUDE_MODEL=

# Необязательно: полный путь к claude, если скрипт его не находит
CLAUDE_CLI_PATH=
