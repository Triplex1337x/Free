# Скопируй этот файл в .env и заполни. Файл .env никому не показывай и не коммить.

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Кому бот отвечает: Telegram ID через запятую.
# Не знаешь свой ID? Запусти бота и напиши ему /id
ALLOWED_USER_IDS=

# cli = через Claude Code по твоей подписке (без API-ключа)
# api = через Claude API (нужен ANTHROPIC_API_KEY, платится отдельно)
CLAUDE_BACKEND=cli

# Только для режима api: ключ с console.anthropic.com
ANTHROPIC_API_KEY=

# Необязательно: модель (например opus, sonnet, haiku в режиме cli;
# полное имя вроде claude-opus-5-5 в режиме api). Пусто = по умолчанию.
CLAUDE_MODEL=

# Необязательно: свой характер бота
SYSTEM_PROMPT=

# Необязательно (режим cli): полный путь к claude, если бот его не находит
CLAUDE_CLI_PATH=

# Необязательно (режим api): глубина размышлений low/medium/high. Для чата хватает low
CLAUDE_EFFORT=low
