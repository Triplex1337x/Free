			local off = UI.Button({ Parent = rr, Text = "Снять", Color = UI.Colors.Red, Size = UDim2.fromOffset(100, 36), Position = UDim2.new(1, -108, 0, 6), TextSize = 16, Radius = 18 })
			off.Activated:Connect(function()
