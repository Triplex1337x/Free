<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Meta name="ExplicitAutoJoints">true</Meta><External>null</External><External>nil</External><Item class="Workspace" referent="RBX0000000000000000000000000000004D"><Properties><string name="Name">Workspace</string><bool name="StreamingEnabled">false</bool><float name="FallenPartsDestroyHeight">-500</float><float name="Gravity">196.2</float></Properties></Item><Item class="Lighting" referent="RBX0000000000000000000000000000004E"><Properties><string name="Name">Lighting</string><token name="Technology">4</token><float name="Brightness">2.4</float><float name="ClockTime">14.2</float><bool name="GlobalShadows">true</bool><float name="EnvironmentDiffuseScale">1</float><float name="EnvironmentSpecularScale">1</float></Properties></Item><Item class="ReplicatedStorage" referent="RBX0000000000000000000000000000004F"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX00000000000000000000000000000010"><Properties><string name="Name">Configs</string></Properties><Item class="ModuleScript" referent="RBX00000000000000000000000000000001"><Properties><string name="Name">BackpacksData</string><ProtectedString name="Source"><![CDATA[-- BackpacksData: рюкзаки. Вместимость — в единицах руды: рюкзак наполняется
-- на столько, сколько урона ты нанёс блокам (блок на 40 HP = 40 руды).
-- Покупать можно только по порядку.
local function c(r, g, b) return { r, g, b } end

local Packs = {
	{ Id = "Canvas", Name = "Холщовая сумка", Biome = 1, Capacity = 180, Price = 0, Look = { Body = c(196, 170, 120), Accent = c(130, 100, 70), Tier = 1 } },
	{ Id = "Basket", Name = "Плетёная корзина", Biome = 1, Capacity = 250, Price = 430, Look = { Body = c(173, 133, 90), Accent = c(110, 78, 53), Tier = 2 } },
	{ Id = "Leather", Name = "Кожаный рюкзак", Biome = 1, Capacity = 360, Price = 1000, Look = { Body = c(150, 96, 60), Accent = c(90, 56, 36), Tier = 3 } },
	{ Id = "Hiker", Name = "Походный рюкзак", Biome = 1, Capacity = 500, Price = 2500, Look = { Body = c(202, 138, 50), Accent = c(75, 58, 53), Tier = 4 } },
	{ Id = "Miner", Name = "Рюкзак шахтёра", Biome = 1, Capacity = 710, Price = 5900, Look = { Body = c(255, 180, 40), Accent = c(60, 60, 70), Tier = 5 } },
	{ Id = "Crate", Name = "Ящик-ранец", Biome = 1, Capacity = 1000, Price = 14000, Look = { Body = c(176, 120, 70), Accent = c(220, 220, 228), Tier = 6 } },

	{ Id = "Bonepack", Name = "Костяной ранец", Biome = 2, Capacity = 1900, Price = 21000, Look = { Body = c(246, 236, 214), Accent = c(150, 110, 80), Tier = 7 } },
	{ Id = "Sandbag", Name = "Песчаный мешок", Biome = 2, Capacity = 2700, Price = 73000, Look = { Body = c(250, 198, 127), Accent = c(130, 85, 50), Tier = 8 } },
	{ Id = "Amberpack", Name = "Янтарная капсула", Biome = 2, Capacity = 3800, Price = 180000, Look = { Body = c(255, 160, 40), Accent = c(110, 60, 20), Glow = true, Tier = 9 } },
	{ Id = "Archeo", Name = "Рюкзак археолога", Biome = 2, Capacity = 5400, Price = 410000, Look = { Body = c(182, 155, 60), Accent = c(165, 130, 85), Glow = true, Tier = 10 } },
	{ Id = "Dig", Name = "Экспедиционный рюкзак", Biome = 2, Capacity = 7700, Price = 970000, Look = { Body = c(110, 150, 80), Accent = c(220, 200, 150), Tier = 11 } },
	{ Id = "Fossilpack", Name = "Палео-контейнер", Biome = 2, Capacity = 11000, Price = 2100000, Look = { Body = c(220, 90, 50), Accent = c(250, 230, 200), Tier = 12 } },

	{ Id = "Frostpack", Name = "Морозный ранец", Biome = 3, Capacity = 20000, Price = 3200000, Look = { Body = c(200, 230, 255), Accent = c(80, 140, 220), Tier = 13 } },
	{ Id = "Snowbag", Name = "Снежный мешок", Biome = 3, Capacity = 29000, Price = 11000000, Look = { Body = c(145, 200, 247), Accent = c(155, 193, 237), Tier = 14 } },
	{ Id = "Cryopack", Name = "Крио-капсула", Biome = 3, Capacity = 41000, Price = 27000000, Look = { Body = c(90, 170, 240), Accent = c(230, 246, 255), Glow = true, Tier = 15 } },
	{ Id = "Thermo", Name = "Термо-ранец", Biome = 3, Capacity = 59000, Price = 63000000, Look = { Body = c(65, 120, 190), Accent = c(170, 243, 255), Glow = true, Tier = 16 } },
	{ Id = "Glacierpack", Name = "Ледниковый контейнер", Biome = 3, Capacity = 84000, Price = 14e7, Look = { Body = c(40, 70, 140), Accent = c(110, 240, 255), Glow = true, Tier = 17 } },
	{ Id = "Polar", Name = "Полярный модуль", Biome = 3, Capacity = 120000, Price = 35e7, Look = { Body = c(240, 250, 255), Accent = c(60, 120, 230), Glow = true, Tier = 18 } },

	{ Id = "Ashpack", Name = "Пепельный ранец", Biome = 4, Capacity = 210000, Price = 49e7, Look = { Body = c(80, 72, 80), Accent = c(255, 110, 40), Glow = true, Tier = 19 } },
	{ Id = "Coalbox", Name = "Угольный ящик", Biome = 4, Capacity = 300000, Price = 16e8, Look = { Body = c(140, 61, 55), Accent = c(255, 145, 50), Glow = true, Tier = 20 } },
	{ Id = "Lavapack", Name = "Лавовый бак", Biome = 4, Capacity = 420000, Price = 39e8, Look = { Body = c(200, 50, 30), Accent = c(255, 180, 60), Glow = true, Tier = 21 } },
	{ Id = "Magmacap", Name = "Магма-капсула", Biome = 4, Capacity = 600000, Price = 92e8, Look = { Body = c(120, 37, 43), Accent = c(217, 135, 157), Glow = true, Tier = 22 } },
	{ Id = "Obsidpack", Name = "Обсидиановый сейф", Biome = 4, Capacity = 850000, Price = 22e9, Look = { Body = c(40, 24, 56), Accent = c(180, 90, 255), Glow = true, Tier = 23 } },
	{ Id = "Corepack", Name = "Ядро-хранилище", Biome = 4, Capacity = 1200000, Price = 47e9, Look = { Body = c(255, 170, 40), Accent = c(60, 20, 20), Glow = true, Tier = 24 } },

	{ Id = "Voidpack", Name = "Пустотный карман", Biome = 5, Capacity = 2200000, Price = 74e9, Look = { Body = c(60, 40, 120), Accent = c(110, 240, 255), Glow = true, Tier = 25 } },
	{ Id = "Starbag", Name = "Звёздный мешок", Biome = 5, Capacity = 3100000, Price = 25e10, Look = { Body = c(140, 55, 160), Accent = c(70, 130, 152), Glow = true, Tier = 26 } },
	{ Id = "Riftpack", Name = "Карман Разлома", Biome = 5, Capacity = 4500000, Price = 61e10, Look = { Body = c(220, 70, 200), Accent = c(30, 20, 50), Glow = true, Tier = 27 } },
	{ Id = "Chronosafe", Name = "Хроно-сейф", Biome = 5, Capacity = 6400000, Price = 15e11, Look = { Body = c(225, 155, 227), Accent = c(60, 70, 152), Glow = true, Tier = 28 } },
	{ Id = "Tesseract", Name = "Тессеракт", Biome = 5, Capacity = 9100000, Price = 32e11, Look = { Body = c(230, 240, 255), Accent = c(90, 120, 255), Glow = true, Tier = 29 } },
	{ Id = "Singularity", Name = "Карманная сингулярность", Biome = 5, Capacity = 13000000, Price = 69e11, Look = { Body = c(20, 16, 40), Accent = c(255, 214, 90), Glow = true, Tier = 30 } },
}

local byId = {}
for i, p in ipairs(Packs) do
	p.Index = i
	byId[p.Id] = p
end

return { List = Packs, ById = byId, Starter = "Canvas" }
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000002"><Properties><string name="Name">Balance</string><ProtectedString name="Source"><![CDATA[-- Balance: все общие числа геймплея в одном месте.
-- Меняйте значения здесь — остальной код их подхватит.
return {
	-- Сетка шахты (ТЗ 1.1)
	GridSize = 40,          -- 40 x 40 блоков на слой
	Layers = 32,            -- глубина шахты в блоках (128 studs)
	BlockSize = 4,          -- 4 x 4 x 4 studs
	WallThickness = 8,      -- неразрушимая стена
	BiomeSpacing = 2400,    -- расстояние между ярусами по оси X (острова не видно друг с друга)

	-- Бурение (ТЗ 2)
	HitInterval = 0.25,     -- 4 удара в секунду на стартовой скорости
	MineReach = 18,         -- максимальная дистанция от персонажа до блока
	CritChance = 0.05,
	CritMult = 3,
	AntiStealTime = 1.5,    -- тег владельца блока (ТЗ 1.3)

	-- Хроно-Жилы (ТЗ 2.3)
	VeinChance = 0.02,
	VeinHpMult = 2,
	VeinCoinMult = 4,
	VeinSeedMult = 3,       -- "повышенный шанс" семян из жил

	-- Хроно-самородки: бонус, который подбирает магнит (ТЗ 8.4)
	NuggetChance = 0.10,
	NuggetValueMult = 1.5,  -- доля стоимости блока
	NuggetLifetime = 25,
	BasePickupRadius = 5,

	-- Вайп (ТЗ 6)
	ResetInterval = 1200,
	ResetWarn1 = 30,
	ResetWarn2 = 10,
	GoldRushDuration = 180,
	GoldRushMult = 2,
	ResetBatchSize = 1000,

	-- Питомцы (ТЗ 4)
	BasePetSlots = 3,
	MaxPetSlots = 5,
	-- Инвентарь питомцев: базовые места + докупка за монеты (+10 мест за раз) + геймпасс +100
	BasePetStorage = 50,
	PetStorageStep = 10,
	PetStorageMaxBuys = 35, -- до 400 мест за монеты (+100 геймпассом = максимум 500)
	PetStorageBaseCost = 2500,
	PetStorageCostGrow = 2.3,
	PetStorageMax = 500,
	-- Сила питомцев по яйцам: самый слабый пет яйца №e = EggBase * EggGrow^(e-1),
	-- самый редкий обычный — в EggSpan раз сильнее, мифик — ещё в MythicMult раз.
	EggBase = 0.05,
	EggGrow = 1.23,
	EggSpan = 6,
	MythicMult = 2.2,
	HugeMult = 1.8, -- «Огромный» питомец сильнее мифика своего яйца в 1.8 раза
	LuckyRareThreshold = 5, -- Lucky Charm усиливает петов с шансом <= 5%
	-- Питомец даёт два бонуса: к урону и к продаже. Бонусы экипированных складываются:
	-- три пета по x1.20 = x1.60 (а не x3.6, как раньше).
	-- Улучшения (крафт одинаковых): Cost — сколько питомцев этого уровня нужно.
	PetTiers = {
		{ Name = "", Short = "", Mult = 1 },
		{ Name = "★", Short = "★", Mult = 1.5, Cost = 5 },
		{ Name = "★★", Short = "★★", Mult = 2.2, Cost = 4 },
		{ Name = "★★★", Short = "★★★", Mult = 3.2, Cost = 4 },
		{ Name = "Золотой", Short = "ЗОЛ", Mult = 5, Cost = 3 },
		{ Name = "Радужный", Short = "РАД", Mult = 8, Cost = 3 },
		-- шайни: только выпадает из яйца (крафтом не получить), чуть сильнее золотого
		{ Name = "Шайни", Short = "ШАЙНИ", Mult = 5.6, NoCraft = true },
	},
	ShinyChance = 0.004, -- 1 из 250 питомцев из яйца — шайни (удача увеличивает, максимум x4)
	-- Уровни: опыт копится у экипированных питомцев за каждый сломанный блок.
	PetMaxLevel = 30,
	PetLevelBonus = 0.04,   -- +4% к силе за уровень (30 ур. = x2.16)
	PetXpBase = 15,         -- опыт до следующего уровня = Base * L^Exp
	PetXpExp = 1.7,
	PetXpPerBlock = 1,      -- за блок (+25% за каждый следующий ярус)

	-- Логистика
	TeleportCastTime = 0,   -- телепорт на базу мгновенный
	BaseWalkSpeed = 18,

	-- Квесты
	DynamicQuestCooldown = 60,

	-- Сохранение
	AutoSaveInterval = 120,
	DataStoreName = "ChronoDrill_PlayerData_v2", -- v2: новая экономика 1.4, старые сейвы не подходят

	-- Геймпасс на 3-й слот инкубатора (ТЗ 5.2). 0 = не настроен.
	IncubatorGamepassId = 0,

	-- Графика: гладкий мир из деталей (true) вместо текстурного ландшафта Terrain (false)
	SmoothWorld = true,
	MaxPetSlotsWithPasses = 8, -- потолок слотов питомцев с геймпассами
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000003"><Properties><string name="Name">BiomesData</string><ProtectedString name="Source"><![CDATA[-- BiomesData: 5 ярусов шахты (ТЗ 3) + визуальные палитры (ТЗ 9).
-- HP = {верхний слой, нижний слой}: прочность растёт экспоненциально с глубиной (x30 за ярус).
-- SellMult — множитель Репликатора продажи этого яруса (x1 … x2.5). Цены руды поделены на него,
-- поэтому продажа в своём ярусе даёт столько же, сколько раньше; руда, отвезённая в ярус выше, дороже.
-- Ore = {верх, низ}: цена одной единицы руды. Рюкзак наполняется нанесённым уроном:
-- блок на 40 HP даёт 40 единиц руды, значит глубже — дороже и крепче.
-- Kinds: типы блоков. Layers = {от, до} слоя (1..32), W = вес выпадения,
-- Hp/Val = множители HP и цены руды для этого типа.
local function rgb(r, g, b) return { r, g, b } end

