	local packTrack = UI.new("Frame", { BackgroundColor3 = Color3.fromRGB(8, 6, 22), BackgroundTransparency = 0.25, Size = UDim2.new(1, -58, 0, 26), Position = UDim2.fromOffset(46, 10), ZIndex = 2, Parent = packPill })
