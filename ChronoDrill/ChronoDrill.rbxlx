	return "Ребёрсы: " .. data.Rebirths
end)

cmd("quests", "", "выполнить текущие задания (динамические и недельные)", function(_, data)
	for _, q in pairs(data.Dynamic or {}) do
		if q.Target then
			q.Progress = q.Target
		end
	end
