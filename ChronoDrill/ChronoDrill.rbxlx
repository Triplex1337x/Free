			{ Name = "Медь", Material = "Pebble", Color = rgb(214, 128, 78), Layers = { 7, 32 }, W = 1, Hp = 1.25, Val = 1.6, Ore = true },
			{ Name = "Уголь", Material = "Basalt", Color = rgb(58, 58, 66), Layers = { 10, 32 }, W = 1.2, Hp = 1.1, Val = 1.4, Ore = true },
