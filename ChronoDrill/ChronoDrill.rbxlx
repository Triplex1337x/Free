-- Миры
---------------------------------------------------------------------------------------------
local WORLD_GLYPHS = { "Pickaxe", "Bone", "Snowflake", "Flame", "Saturn" }
local function buildWorlds(screen, ctx)
	local win = UI.Window(screen, { Name = "Worlds", Title = "ЯРУСЫ ШАХТЫ", Color = UI.Colors.Blue, Size = UDim2.fromOffset(900, 460) })
	local c = win.Content
	local row = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Parent = c })
	UI.List(row, 12, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
	local cards = {}
	for b, biome in ipairs(BiomesData) do
		local color = c3(biome.Theme.UI)
		local holder, face = UI.Plate(row, UDim2.fromOffset(162, 362), nil, Color3.new(1, 1, 1), 20)
		holder.LayoutOrder = b
		-- цветная «витрина» с эмблемой
		local top = UI.new("Frame", { BackgroundColor3 = color, Size = UDim2.new(1, -12, 0, 150), Position = UDim2.fromOffset(6, 6), Parent = face })
		UI.Corner(top, 16)
		UI.Gradient(top, UI.Lighter(color, 0.35), UI.Darker(color, 0.12))
		UI.Stroke(top, 3, UI.Edge(color), true)
		-- лучи за эмблемой
		local rays = UI.new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0, 72), Size = UDim2.fromOffset(130, 130), Parent = top })
		for k = 0, 3 do
			local r = UI.new("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.82, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 22, 1, 0), Rotation = k * 45, Parent = rays })
			UI.Corner(r, UDim.new(1, 0))
		end
		local emblem = UI.new("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0, 72), Size = UDim2.fromOffset(92, 92), ZIndex = 3, Parent = top })
		UI.Corner(emblem, UDim.new(1, 0))
		UI.Stroke(emblem, 4, UI.Edge(color), true)
		UI.Gradient(emblem, Color3.new(1, 1, 1), UI.Lighter(color, 0.65))
		local ic = Icons2D.New(emblem, WORLD_GLYPHS[b] or "Globe", 64, { Color = color, Ink = UI.Edge(color), ZIndex = 4 })
		ic.AnchorPoint = Vector2.new(0.5, 0.5)
		ic.Position = UDim2.fromScale(0.5, 0.48)
		local num = UI.new("Frame", { BackgroundColor3 = UI.Edge(color), Size = UDim2.fromOffset(34, 34), Position = UDim2.fromOffset(6, 6), ZIndex = 4, Parent = top })
		UI.Corner(num, UDim.new(1, 0))
		UI.Text(num, tostring(b), { Size = UDim2.new(1, -6, 1, -6), Position = UDim2.fromOffset(3, 3), MaxText = 24, ZIndex = 5 })
		local nameL = UI.Text(top, string.upper(biome.Short), { Size = UDim2.new(1, -12, 0, 28), Position = UDim2.new(0, 6, 1, -32), MaxText = 22, ZIndex = 4, StrokeThickness = 3 })
		local ns = nameL:FindFirstChildOfClass("UIStroke")
		if ns then
			ns.Color = UI.Edge(color)
		end
		-- информация
		UI.Text(face, biome.Name, { Size = UDim2.new(1, -14, 0, 20), Position = UDim2.fromOffset(7, 162), TextColor3 = Color3.fromRGB(80, 70, 104), Stroke = false, MaxText = 15, TextWrapped = true })
		local _, depthChip = chipText(face, Util.Commas(biome.MinDepth) .. "–" .. Util.Commas(biome.MaxDepth) .. " м", Color3.fromRGB(110, 104, 150), UDim2.new(1, -24, 0, 24), UDim2.fromOffset(12, 186), 3)
		local sellChip = pill(face, "Coin", Color3.fromRGB(255, 176, 30), UDim2.new(1, -24, 0, 34), UDim2.fromOffset(12, 216))
		sellChip.Text = "Продажа x" .. biome.SellMult
		local pod = UI.Button({ Parent = face, Text = "В шахту", Color = UI.Colors.Green, Size = UDim2.new(1, -20, 0, 42), Position = UDim2.new(0, 10, 1, -102), TextSize = 20, Radius = 21, Glyph = "Pickaxe" })
		local hub = UI.Button({ Parent = face, Text = "На базу", Color = UI.Colors.Teal, Size = UDim2.new(1, -20, 0, 42), Position = UDim2.new(0, 10, 1, -52), TextSize = 20, Radius = 21, Glyph = "Home" })
		pod.Activated:Connect(function()
			local res = invoke(ctx, "Travel", b, "Pod")
			if res and res.ok then
				win.Hide()
			end
		end)
		hub.Activated:Connect(function()
			local res = invoke(ctx, "Travel", b, "Hub")
			if res and res.ok then
				win.Hide()
			end
		end)
		local lock = UI.new("Frame", { BackgroundColor3 = Color3.fromRGB(40, 36, 64), BackgroundTransparency = 0.38, Size = UDim2.fromScale(1, 1), ZIndex = 8, Parent = face, Visible = false })
		UI.Corner(lock, 20)
		local lb = UI.new("Frame", { BackgroundColor3 = Color3.fromRGB(90, 86, 120), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, -30, 0, 34), Size = UDim2.fromOffset(52, 52), ZIndex = 9, Parent = lock })
		UI.Corner(lb, UDim.new(1, 0))
		UI.Stroke(lb, 3, Color3.fromRGB(30, 26, 48), true)
		local li = Icons2D.New(lb, "Lock", 36, { ZIndex = 10 })
		li.AnchorPoint = Vector2.new(0.5, 0.5)
		li.Position = UDim2.fromScale(0.5, 0.48)
		local need = b > 1 and Stats.GateDrill(b - 1) or nil
		local note = UI.new("Frame", { BackgroundColor3 = Color3.fromRGB(30, 26, 50), BackgroundTransparency = 0.1, Size = UDim2.new(1, -12, 0, 76), Position = UDim2.new(0, 6, 0.48, 0), ZIndex = 9, Parent = lock })
		UI.Corner(note, 14)
		UI.Text(note, "Сломай блок на дне\nпрошлого яруса" .. (need and ("\n(бур «" .. need.Name .. "»)") or ""), { Size = UDim2.new(1, -10, 1, -8), Position = UDim2.fromOffset(5, 4), ZIndex = 10, MaxText = 15, TextWrapped = true })
		cards[b] = { lock = lock }
	end
	local function render()
		local data = ctx.ClientState.Data
		if not data then
			return
		end
		for b, cc in ipairs(cards) do
			cc.lock.Visible = b > (data.UnlockedBiome or 1)
		end
	end
	win.Opened:Connect(render)
	ctx.ClientState.Changed:Connect(function()
		if win.IsOpen then
			render()
		end
	end)
	return win
end

---------------------------------------------------------------------------------------------
-- Диалог Drill-Bot 3000
---------------------------------------------------------------------------------------------
local LINES = {
	"Бип-буп! Шахта сама себя не выкопает.",
	"Мои сенсоры чуют Хроно-Жилы глубже. Копай!",
	"Каждые 20 минут шахта восстанавливается. Не забудь вылезти!",
	"Питомцы из семян сильнее магазинных. Проверь инкубатор!",
	"Полный рюкзак — на базу! Репликатор платит лучше в глубоких ярусах.",
}
local function rewardText(r)
	local parts = {}
	if r.Coins then
		table.insert(parts, Util.Format(r.Coins) .. " монет")
	end
	if r.Boosts then
		for id, n in pairs(r.Boosts) do
			table.insert(parts, n .. "x " .. BoostsData.ById[id].Name)
		end
	end
	if r.PetSlot then
		table.insert(parts, "+1 слот питомца")
	end
	return table.concat(parts, ", ")
end

local function buildNpc(screen, ctx)
	local win = UI.Window(screen, { Name = "Npc", Title = "DRILL-BOT 3000", Color = UI.Colors.Yellow, Size = UDim2.fromOffset(760, 400) })
	local c = win.Content
	local _, portrait = card(c, UDim2.fromOffset(220, 300), UI.Colors.Panel2, 0)
	local npcModel = ReplicatedStorage:WaitForChild("Assets"):WaitForChild("NPC"):WaitForChild("DrillBot3000")
	local m = npcModel:Clone()
	UI.Viewport(portrait, m, UDim2.new(1, -10, 1, -10), UDim2.fromOffset(5, 5))
	local _, bubble = card(c, UDim2.new(1, -240, 0, 300), UI.Colors.Panel, 1)
	bubble.Parent.Position = UDim2.fromOffset(240, 0)
	local speech = UI.Text(bubble, "", { Size = UDim2.new(1, -28, 0, 70), Position = UDim2.fromOffset(14, 12), TextColor3 = UI.Ink, Stroke = false, MaxText = 22, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top })
	local qTitle = UI.Text(bubble, "", { Size = UDim2.new(1, -28, 0, 30), Position = UDim2.fromOffset(14, 90), TextColor3 = UI.Colors.Orange, Stroke = false, MaxText = 24, TextXAlignment = Enum.TextXAlignment.Left })
	local qText = UI.Text(bubble, "", { Size = UDim2.new(1, -28, 0, 26), Position = UDim2.fromOffset(14, 122), TextColor3 = UI.Ink, Stroke = false, MaxText = 20, TextXAlignment = Enum.TextXAlignment.Left })
	local qBar = UI.Bar(bubble, UDim2.new(1, -28, 0, 26), UDim2.fromOffset(14, 156), UI.Colors.Yellow)
	local qReward = UI.Text(bubble, "", { Size = UDim2.new(1, -28, 0, 24), Position = UDim2.fromOffset(14, 192), TextColor3 = UI.Colors.Gray, Stroke = false, MaxText = 18, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true })
	local claim = UI.Button({ Parent = bubble, Text = "ЗАБРАТЬ НАГРАДУ", Color = UI.Colors.Green, Size = UDim2.fromOffset(280, 52), Position = UDim2.new(1, -294, 1, -64), TextSize = 22 })
	claim.Activated:Connect(function()
		local res = invoke(ctx, "ClaimQuest", "Story")
		if res and res.ok then
			ctx.Sound.Play("Unlock")
		end
	end)
	local function render()
		local data = ctx.ClientState.Data
		if not data then
			return
		end
		local q = QuestsData.Story[data.StoryIndex or 1]
		if not q then
			speech.Text = "Ты прошёл все мои задания! Легенда шахты. Теперь — новые рекорды и ребёрсы!"
			qTitle.Text = ""
			qText.Text = ""
			qBar.Frame.Visible = false
			qReward.Text = ""
			claim.Holder.Visible = false
			return
		end
		local cur
		if q.Stat == "SessionEggs" then
			cur = data.Derived and data.Derived.SessionEggs or 0
		else
			cur = data.Stats and data.Stats[q.Stat] or 0
		end
		cur = math.min(cur, q.Target)
		local done = cur >= q.Target
		speech.Text = done and "Бип! Задание выполнено. Держи награду, бурильщик!" or LINES[((data.StoryIndex or 1) % #LINES) + 1]
		qTitle.Text = "Квест " .. (data.StoryIndex or 1) .. "/" .. #QuestsData.Story .. ": " .. q.Title
		qText.Text = q.Text
		qBar.Frame.Visible = true
		qBar.Set(cur / q.Target, Util.Format(cur) .. " / " .. Util.Format(q.Target))
		qReward.Text = "Награда: " .. rewardText(q.Reward)
		claim.Holder.Visible = done
	end
	ctx.ClientState.Changed:Connect(function()
		if win.IsOpen then
			render()
		end
	end)
	win.Opened:Connect(render)
	return win
end

---------------------------------------------------------------------------------------------
-- Окно яйца: шансы и открытие
---------------------------------------------------------------------------------------------
-- значок «мусорка» из фреймов (крышка, ручка, корзина с прорезями)
local function trashIcon(parent, size, color, z)
	local f = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(size, size), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), ZIndex = z, Parent = parent })
	local handle = UI.new("Frame", { BackgroundColor3 = color, Size = UDim2.new(0.34, 0, 0.12, 0), Position = UDim2.new(0.33, 0, 0.06, 0), ZIndex = z, Parent = f })
	UI.Corner(handle, 2)
	local lid = UI.new("Frame", { BackgroundColor3 = color, Size = UDim2.new(0.86, 0, 0.13, 0), Position = UDim2.new(0.07, 0, 0.15, 0), ZIndex = z, Parent = f })
	UI.Corner(lid, 2)
	local body = UI.new("Frame", { BackgroundColor3 = color, Size = UDim2.new(0.64, 0, 0.6, 0), Position = UDim2.new(0.18, 0, 0.33, 0), ZIndex = z, Parent = f })
	UI.Corner(body, 3)
	return f
end

-- Компактное окно яйца: прижато к низу экрана (яйцо в мире видно), сверху цена, удача и быстрые фильтры
-- автоудаления, посередине ряд питомцев с шансами и кнопкой-мусоркой, снизу кнопки открытия.
local EGG_TILE_GAP = 6
local QUICK_RARITIES = { { "Common", "Обычных" }, { "Uncommon", "Необычных" }, { "Rare", "Редких" } }
local function buildEgg(screen, ctx)
	local win = UI.Window(screen, { Name = "Egg", Title = "ЯЙЦО", Color = UI.Colors.Teal, Size = UDim2.fromOffset(700, 262), NoBackdrop = true })
	win.Root.Position = UDim2.new(0.5, 0, 1, -160)
	local c = win.Content
	local W = 664

	---------------------------------------------------------------- строка 1: цена, удача, быстрое удаление
	local row1 = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 32), Parent = c })
	local left = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(0.5, 0, 1, 0), Parent = row1 })
	UI.List(left, 8, Enum.FillDirection.Horizontal, nil, Enum.VerticalAlignment.Center)
	local pricePill = pill(left, "Coin", Color3.fromRGB(255, 176, 30), UDim2.fromOffset(132, 32), nil, 1)
	local luckPill, luckF = pill(left, "Clover", UI.Colors.Green, UDim2.fromOffset(118, 32), nil, 2)
	local right = UI.new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.new(0.66, 0, 1, 0), Parent = row1 })
	UI.List(right, 6, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center)
	local qLabelHolder = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(96, 30), LayoutOrder = 0, Parent = right })
	local qi = trashIcon(qLabelHolder, 22, Color3.fromRGB(120, 112, 150), 3)
	qi.Position = UDim2.new(0, 12, 0.5, 0)
	UI.Text(qLabelHolder, "Удалять:", { Size = UDim2.new(1, -26, 1, -6), Position = UDim2.fromOffset(26, 3), MaxText = 16, TextColor3 = Color3.fromRGB(100, 92, 130), Stroke = false, TextXAlignment = Enum.TextXAlignment.Left })
	local quick = {}
	for i, q in ipairs(QUICK_RARITIES) do
		local col = rarityColor(q[1])
		local b = UI.Button({ Parent = right, Text = q[2], Color = Color3.fromRGB(176, 172, 200), Size = UDim2.fromOffset(104, 30), LayoutOrder = i, TextSize = 15, Radius = 15 })
		quick[q[1]] = { btn = b, col = col }
	end

	---------------------------------------------------------------- строка 2: питомцы
	local well = UI.new("Frame", { BackgroundColor3 = Color3.fromRGB(240, 246, 252), Size = UDim2.new(1, 0, 0, 108), Position = UDim2.fromOffset(0, 40), Parent = c })
	UI.Corner(well, 16)
	UI.Stroke(well, 2, Color3.fromRGB(200, 214, 232), true)
	local row = UI.new("ScrollingFrame", {
		BackgroundTransparency = 1, Size = UDim2.new(1, -12, 1, -8), Position = UDim2.fromOffset(6, 4),
		ScrollBarThickness = 4, ScrollingDirection = Enum.ScrollingDirection.X, AutomaticCanvasSize = Enum.AutomaticSize.X,
		CanvasSize = UDim2.new(), ScrollBarImageColor3 = Color3.fromRGB(150, 140, 190), Parent = well,
	})
	local rl = UI.List(row, EGG_TILE_GAP, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)

	---------------------------------------------------------------- строка 3: кнопки
	local bottom = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 48), Position = UDim2.new(0, 0, 1, -48), Parent = c })
	UI.List(bottom, 10, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
	local one = UI.Button({ Parent = bottom, Text = "x1", Color = UI.Colors.Green, Size = UDim2.fromOffset(156, 44), LayoutOrder = 1, TextSize = 20, Glyph = "Coin", GlyphColor = GOLD, Radius = 22 })
	local three = UI.Button({ Parent = bottom, Text = "x3", Color = UI.Colors.Purple, Size = UDim2.fromOffset(156, 44), LayoutOrder = 2, TextSize = 20, Glyph = "Coin", GlyphColor = GOLD, Radius = 22 })
	local eight = UI.Button({ Parent = bottom, Text = "x8", Color = Color3.fromRGB(40, 200, 110), Size = UDim2.fromOffset(156, 44), LayoutOrder = 3, TextSize = 20, Glyph = "Egg", Radius = 22 })
	local autoB = UI.Button({ Parent = bottom, Text = "Авто", Color = Color3.fromRGB(40, 190, 210), Size = UDim2.fromOffset(150, 44), LayoutOrder = 4, TextSize = 20, Glyph = "Bolt", Radius = 22 })

	-- плашка «идёт автооткрытие» поверх экрана (окно яйца в это время закрыто)
	local autoBar = UI.new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -110), Size = UDim2.fromOffset(360, 56), Visible = false, ZIndex = 30, Parent = screen })
	local stopB = UI.Button({ Parent = autoBar, Text = "АВТО · СТОП", Color = UI.Colors.Red, Size = UDim2.fromScale(1, 1), TextSize = 22, Glyph = "Close", Radius = 26 })

	local currentEgg
	local busy = false
	local auto = { on = false }
	local tiles = {}

	local function canAfford(n)
		local coins = ctx.ClientState.Data and ctx.ClientState.Data.Coins or 0
		return currentEgg and coins >= currentEgg.Price * n
	end
	local function hasPass(key)
		return Stats.HasPass(ctx.ClientState.Data, key)
	end

	local function open(n, fast)
		if busy or not currentEgg then
			return false
		end
		busy = true
		local res = invoke(ctx, "OpenEgg", currentEgg.Id, n)
		busy = false
		if res and res.ok then
			win.Hide()
			ctx.PlayEgg(currentEgg.Id, res.pets, { Fast = fast })
			return true
		end
		return false
	end

	local function stopAuto()
		auto.on = false
		autoBar.Visible = false
	end
	local function startAuto()
		if not currentEgg then
			return
		end
		auto.on = true
		autoBar.Visible = true
		stopB.SetText("АВТО: " .. currentEgg.Name .. " · СТОП")
		win.Hide()
		task.spawn(function()
			while auto.on do
				if not EggOpening.IsBusy() then
					local n = (hasPass("HatchX8") and canAfford(8)) and 8 or (canAfford(3) and 3 or 1)
					if not open(n, true) then
						stopAuto()
						break
					end
				end
				task.wait(0.25)
			end
		end)
	end
	stopB.Activated:Connect(stopAuto)
	one.Activated:Connect(function()
		open(1)
	end)
	three.Activated:Connect(function()
		open(3)
	end)
	eight.Activated:Connect(function()
		if hasPass("HatchX8") then
			open(8)
		else
			win.Hide()
			ctx.OpenPanel("Donate")
		end
	end)
	autoB.Activated:Connect(function()
		if not hasPass("AutoHatch") then
			win.Hide()
			ctx.OpenPanel("Donate")
			return
		end
		if auto.on then
			stopAuto()
		else
			startAuto()
		end
	end)

	-- внешний вид плитки: обычная / «удалять»
	local function paintTile(t)
		local on = t.on
		t.overlay.Visible = on
		t.binBg.BackgroundColor3 = on and UI.Colors.Red or Color3.new(1, 1, 1)
		for _, f in ipairs(t.bin:GetChildren()) do
			if f:IsA("Frame") then
				f.BackgroundColor3 = on and Color3.new(1, 1, 1) or Color3.fromRGB(120, 112, 150)
			end
		end
		t.binStroke.Color = on and UI.Edge(UI.Colors.Red) or Color3.fromRGB(190, 184, 214)
		t.stroke.Color = on and UI.Colors.Red or UI.Darker(t.col, 0.15)
	end
	local function paintQuick()
		for key, q in pairs(quick) do
			local any, all = false, true
			for _, t in pairs(tiles) do
				if t.rarity == key then
					any = true
					all = all and t.on
				end
			end
			q.btn.Holder.Visible = any
			q.btn.SetColor((any and all) and UI.Colors.Red or Color3.fromRGB(176, 172, 200))
		end
	end
	local function setDelete(t, on, silent)
		if t.locked or t.on == on then
			return true
		end
		t.on = on
		paintTile(t)
		local res = invoke(ctx, "PetAction", "AutoDelete", t.id, on)
		if not (res and res.ok) then
			t.on = not on
			paintTile(t)
			return false
		end
		if not silent then
			ctx.Toast(on and ("«" .. t.name .. "» будет удаляться сразу (шайни — никогда)") or ("«" .. t.name .. "» снова попадает в инвентарь"), on and "warn" or "good")
		end
		return true
	end
	for key, q in pairs(quick) do
		q.btn.Activated:Connect(function()
			local all = true
			for _, t in pairs(tiles) do
				if t.rarity == key and not t.on then
					all = false
				end
			end
			local target = not all
			local n = 0
			for _, t in pairs(tiles) do
				if t.rarity == key and t.on ~= target then
					if setDelete(t, target, true) then
						n = n + 1
					end
				end
			end
			paintQuick()
			local rname = PetsData.Rarity[key] and PetsData.Rarity[key].Name or key
			ctx.Toast(target and ("Удаляются сразу: все «" .. rname .. "» этого яйца") or ("«" .. rname .. "» снова попадают в инвентарь"), target and "warn" or "good")
		end)
	end

	local function refreshButtons()
		if not currentEgg then
			return
		end
		local egg = currentEgg
		one.SetText(Util.Format(egg.Price))
		three.SetText("x3 " .. Util.Format(egg.Price * 3))
		one.SetEnabled(canAfford(1))
		three.SetEnabled(canAfford(3))
		if hasPass("HatchX8") then
			eight.SetText("x8 " .. Util.Format(egg.Price * 8))
			eight.SetEnabled(canAfford(8))
		else
			eight.SetEnabled(true)
			eight.SetText("x8 · R$")
		end
		autoB.SetText(hasPass("AutoHatch") and (auto.on and "Стоп" or "Авто") or "Авто · R$")
	end

	function win.ShowEgg(eggId)
		local egg = EggsData.ById[eggId]
		if not egg then
			return
		end
		currentEgg = egg
		local data = ctx.ClientState.Data or {}
		win.Title.Text = string.upper(egg.Name)
		pricePill.Text = Util.Format(egg.Price)
		-- шансы с учётом удачи
		clear(row, true)
		tiles = {}
		local luck = Stats.LuckMult(data)
		local lucky = luck > 1
		local total = 0
		for _, e in ipairs(egg.Pets) do
			local w = e[3]
			if lucky and e[3] <= Balance.LuckyRareThreshold then
				w = w * luck
			end
			total = total + w
		end
		luckF.Visible = lucky
		luckPill.Text = "Удача x" .. string.format(luck < 10 and "%.1f" or "%.0f", luck)
		local index = data.Index or {}
		local autoDel = data.AutoDelete or {}
		local n = #egg.Pets
		local TW = math.min(84, math.floor((W - 12 - (n - 1) * EGG_TILE_GAP) / n))
		local TH = 98
		for i, e in ipairs(egg.Pets) do
			local def = PetsData.ById[e[1]]
			local col = rarityColor(def.Rarity)
			local special = def.Rarity == "Mythic" or def.Rarity == "Huge"
			local holder = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(TW, TH), LayoutOrder = i, Parent = row })
			local face = UI.new("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), Size = UDim2.fromScale(1, 1), Parent = holder })
			UI.Corner(face, 14)
			UI.Gradient(face, UI.Lighter(col, 0.55), UI.Lighter(col, 0.1))
			face.BackgroundColor3 = Color3.new(1, 1, 1)
			local stroke = UI.Stroke(face, 2.5, UI.Darker(col, 0.15), true)
			if special then
				local rg = Instance.new("UIGradient")
				rg.Color = def.Rarity == "Huge" and CARD_MODES.huge[1] or CARD_MODES.rainbow[1]
				rg.Rotation = 45
				rg.Parent = stroke
				stroke.Thickness = 3
			end
			UI.Gloss(face, UDim2.new(1, -10, 0, 14), UDim2.fromOffset(5, 3), 0.55, 1)
			local model = ctx.PetModel(e[1], false)
			if not index[e[1]] then
				EggOpening.Silhouette(model)
			end
			UI.Viewport(face, model, UDim2.new(1, -6, 0, TH - 30), UDim2.fromOffset(3, 4))
			-- шанс внизу
			local w = e[3]
			if lucky and e[3] <= Balance.LuckyRareThreshold then
				w = w * luck
			end
			local pct = w / total * 100
			local chanceF = UI.new("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -4), Size = UDim2.new(1, -8, 0, 20), ZIndex = 3, Parent = face })
			UI.Glass(chanceF, UDim.new(1, 0), 0.05)
			UI.Text(chanceF, (pct >= 1 and string.format("%.1f", pct) or (pct >= 0.01 and string.format("%.2f", pct) or string.format("%.3f", pct))) .. "%", { Size = UDim2.new(1, -6, 1, -4), Position = UDim2.fromOffset(3, 2), MaxText = 15, ZIndex = 4, StrokeThickness = 1.4 })
			-- «удалять»: тёмно-красная вуаль и перечёркнутая надпись
			local overlay = UI.new("Frame", { BackgroundColor3 = Color3.fromRGB(120, 20, 40), BackgroundTransparency = 0.35, Size = UDim2.fromScale(1, 1), Visible = false, ZIndex = 6, Parent = face })
			UI.Corner(overlay, 14)
			UI.Text(overlay, "УДАЛЯТЬ", { Size = UDim2.new(1, -10, 0, 16), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), MaxText = 13, ZIndex = 7, StrokeThickness = 1.6 })
			-- кнопка-мусорка в углу (у мификов и «Огромных» — замок)
			local binBg = UI.new("TextButton", { Name = "Trash", AutoButtonColor = false, Text = "", BackgroundColor3 = Color3.new(1, 1, 1), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -3, 0, 3), Size = UDim2.fromOffset(24, 24), ZIndex = 8, Parent = face })
			UI.Corner(binBg, UDim.new(1, 0))
			local binStroke = UI.Stroke(binBg, 2, Color3.fromRGB(190, 184, 214), true)
			local bin
			if special then
				bin = Icons2D.New(binBg, "Lock", 18, { ZIndex = 9, Shadow = false })
				bin.AnchorPoint = Vector2.new(0.5, 0.5)
				bin.Position = UDim2.fromScale(0.5, 0.5)
			else
				bin = trashIcon(binBg, 16, Color3.fromRGB(120, 112, 150), 9)
			end
			local t = { id = e[1], name = def.Name, rarity = def.Rarity, col = col, on = autoDel[e[1]] == true, locked = special,
				overlay = overlay, binBg = binBg, bin = bin, binStroke = binStroke, stroke = stroke }
			tiles[e[1]] = t
			if not special then
				paintTile(t)
			else
				stroke.Color = Color3.new(1, 1, 1)
			end
			local function toggle()
				if t.locked then
					ctx.Toast("Мификов и «Огромных» нельзя удалять автоматически", "info")
					return
				end
				setDelete(t, not t.on)
				paintQuick()
			end
			binBg.Activated:Connect(toggle)
			local btn = UI.new("TextButton", { BackgroundTransparency = 1, Text = "", Size = UDim2.fromScale(1, 1), ZIndex = 5, Parent = face })
			UI.Bounce(btn, holder)
			btn.Activated:Connect(toggle)
		end
		rl.HorizontalAlignment = (n * (TW + EGG_TILE_GAP) > W) and Enum.HorizontalAlignment.Left or Enum.HorizontalAlignment.Center
		paintQuick()
		refreshButtons()
		win.Open()
	end
	ctx.ClientState.Changed:Connect(function()
		if win.IsOpen then
			refreshButtons()
		end
	end)
	win.StopAuto = stopAuto
	return win
end

---------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------
-- Индекс питомцев: все питомцы по яйцам, неоткрытые — чёрные силуэты
---------------------------------------------------------------------------------------------
local function buildIndex(screen, ctx)
	local win = UI.Window(screen, { Name = "Index", Title = "ИНДЕКС ПИТОМЦЕВ", Color = UI.Colors.Purple, Icon = "Paw", Size = UDim2.fromOffset(840, 540) })
	local c = win.Content
	local _, topFace = UI.Plate(c, UDim2.new(1, 0, 0, 44), nil, UI.Colors.Dark, 999)
	local countL = UI.Text(topFace, "", { Size = UDim2.fromOffset(240, 32), Position = UDim2.fromOffset(14, 6), TextXAlignment = Enum.TextXAlignment.Left, MaxText = 22 })
	local bar = UI.Bar(topFace, UDim2.new(1, -280, 0, 22), UDim2.fromOffset(266, 11), UI.Colors.Purple)
	local scroll = UI.Scroll(c, UDim2.new(1, 0, 1, -54), UDim2.fromOffset(0, 54))
	UI.List(scroll, 10)
	UI.Padding(scroll, 6)
	local lastCount = -1
	local CELL, GAP, COLS = 100, 8, 7
	local function render()
		local data = ctx.ClientState.Data
		if not data then
			return
		end
		local index = data.Index or {}
		local total, open = 0, 0
		for _, egg in ipairs(EggsData.List) do
			for _, e in ipairs(egg.Pets) do
				total = total + 1
				if index[e[1]] then
					open = open + 1
				end
			end
		end
		countL.Text = "Открыто " .. open .. " / " .. total
		bar.Set(open / math.max(1, total), math.floor(open / math.max(1, total) * 100) .. "%")
		if open == lastCount then
			return
		end
		lastCount = open
		clear(scroll, true)
		for ei, egg in ipairs(EggsData.List) do
			local n = #egg.Pets
			local rows = math.ceil(n / COLS)
			local sec = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -12, 0, 30 + rows * (CELL + 22 + GAP)), LayoutOrder = ei, Parent = scroll })
			local biome = BiomesData[egg.Biome]
			UI.Text(sec, egg.Name .. "  ·  " .. biome.Short, { Size = UDim2.new(1, 0, 0, 26), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UI.Ink, Stroke = false, MaxText = 20 })
			for i, e in ipairs(egg.Pets) do
				local def = PetsData.ById[e[1]]
				local known = index[e[1]] == true
				local col = rarityColor(def.Rarity)
				local x = ((i - 1) % COLS) * (CELL + GAP)
				local y = 30 + math.floor((i - 1) / COLS) * (CELL + 22 + GAP)
				local _, face = UI.Plate(sec, UDim2.fromOffset(CELL, CELL + 22), UDim2.fromOffset(x, y), UI.Lighter(col, 0.35), 14)
				if def.Rarity == "Mythic" then
					UI.Gradient(face, Color3.fromRGB(255, 140, 200), Color3.fromRGB(140, 190, 255), 35)
				end
				local model = ctx.PetModel(e[1], false)
				if not known then
					EggOpening.Silhouette(model)
				end
				UI.Viewport(face, model, UDim2.new(1, -8, 0, CELL - 14), UDim2.fromOffset(4, 2))
				UI.Text(face, known and def.Name or "???", { Size = UDim2.new(1, -8, 0, 20), Position = UDim2.new(0, 4, 1, -34), MaxText = 14 })
				local pct = e[3] < 1 and string.format("%.2f", e[3]) or string.format("%.1f", e[3])
				UI.Text(face, pct .. "%", { Size = UDim2.new(1, -8, 0, 16), Position = UDim2.new(0, 4, 1, -17), MaxText = 13, TextColor3 = Color3.fromRGB(255, 240, 170) })
			end
		end
	end
	win.Opened:Connect(function()
		lastCount = -1
		render()
	end)
	ctx.ClientState.Changed:Connect(function()
		if win.IsOpen then
			render()
		end
	end)
	return win
end

---------------------------------------------------------------------------------------------
-- Донат: геймпассы
---------------------------------------------------------------------------------------------
local function buildDonate(screen, ctx)
	local GREEN = Color3.fromRGB(40, 200, 110)
	local win = UI.Window(screen, { Name = "Donate", Title = "ДОНАТ · ГЕЙМПАССЫ", Color = GREEN, Icon = "Diamond", Size = UDim2.fromOffset(900, 540) })
	local c = win.Content
	local scroll = UI.Scroll(c, UDim2.new(1, 0, 1, 0))
	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.fromOffset(204, 216)
	grid.CellPadding = UDim2.fromOffset(12, 14)
	grid.HorizontalAlignment = Enum.HorizontalAlignment.Center
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.Parent = scroll
	UI.Padding(scroll, 6)
	local items = {}
	for i, def in ipairs(GamepassesData.List) do
		local col = c3(def.Color)
		local holder, face = UI.Plate(scroll, UDim2.fromOffset(204, 216), nil, Color3.new(1, 1, 1), 20)
		holder.LayoutOrder = i
		local top = UI.new("Frame", { BackgroundColor3 = col, Size = UDim2.new(1, -12, 0, 96), Position = UDim2.fromOffset(6, 6), Parent = face })
		UI.Corner(top, 16)
		UI.Gradient(top, UI.Lighter(col, 0.35), UI.Darker(col, 0.1))
		UI.Stroke(top, 3, UI.Edge(col), true)
		for k = 0, 3 do
			local r = UI.new("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.84, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 18, 0, 150), Rotation = k * 45, Parent = top })
			UI.Corner(r, UDim.new(1, 0))
		end
		if def.Exclusive then
			local rib = UI.new("Frame", { BackgroundColor3 = Color3.fromRGB(255, 200, 40), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, -10), Size = UDim2.fromOffset(150, 26), ZIndex = 6, Parent = face })
			UI.Corner(rib, UDim.new(1, 0))
			UI.Stroke(rib, 2.5, Color3.fromRGB(150, 90, 10), true)
			UI.Text(rib, "ЭКСКЛЮЗИВ", { Size = UDim2.new(1, -10, 1, -6), Position = UDim2.fromOffset(5, 3), MaxText = 18, ZIndex = 7 })
		end
		local ic = Icons2D.New(top, def.Glyph, 70, { Color = Color3.new(1, 1, 1), Ink = UI.Edge(col), ZIndex = 4 })
		ic.AnchorPoint = Vector2.new(0.5, 0.5)
		ic.Position = UDim2.fromScale(0.5, 0.5)
		local nm = UI.Text(face, def.Name, { Size = UDim2.new(1, -16, 0, 26), Position = UDim2.fromOffset(8, 106), MaxText = 22, StrokeThickness = 3 })
		local ns = nm:FindFirstChildOfClass("UIStroke")
		if ns then
			ns.Color = UI.Edge(col)
		end
		nm.TextColor3 = col
		UI.Text(face, def.Desc, { Size = UDim2.new(1, -16, 0, 34), Position = UDim2.fromOffset(8, 132), MaxText = 13, TextWrapped = true, TextColor3 = Color3.fromRGB(110, 100, 140), Stroke = false })
		local buy = UI.Button({ Parent = face, Text = tostring(def.Price) .. " R$", Glyph = "Diamond", Color = GREEN, Size = UDim2.new(1, -20, 0, 40), Position = UDim2.new(0, 10, 1, -48), TextSize = 21, Radius = 20 })
		buy.Activated:Connect(function()
			local data = ctx.ClientState.Data
			if Stats.HasPass(data, def.Key) then
				return
			end
			local id = GamepassesData.IdOf(def.Key)
			if id == 0 then
				ctx.Toast("Геймпасс ещё не настроен: впиши его ID в Configs/GamepassesData", "warn")
				return
			end
			pcall(function()
				MarketplaceService:PromptGamePassPurchase(player, id)
			end)
		end)
		items[def.Key] = { buy = buy, price = def.Price }
	end
	local function render()
		local data = ctx.ClientState.Data
		for key, it in pairs(items) do
			local owned = Stats.HasPass(data, key)
			it.buy.SetText(owned and "Куплено" or (tostring(it.price) .. " R$"))
			it.buy.SetColor(owned and Color3.fromRGB(150, 146, 176) or GREEN)
			if it.buy.Glyph then
				it.buy.Glyph.Visible = not owned
			end
		end
	end
	win.Opened:Connect(render)
	ctx.ClientState.Changed:Connect(function()
		if win.IsOpen then
			render()
		end
	end)
	return win
end

function Panels.Build(screen, ctx)
	local p = {}
	p.Index = buildIndex(screen, ctx)
	p.Pets = buildPets(screen, ctx)
	p.Bag = buildBag(screen, ctx)
	p.Shop = buildShop(screen, ctx)
	p.Incubator = buildIncubator(screen, ctx)
	p.Rebirth = buildRebirth(screen, ctx)
	p.Worlds = buildWorlds(screen, ctx)
	p.Npc = buildNpc(screen, ctx)
	p.Egg = buildEgg(screen, ctx)
	p.Donate = buildDonate(screen, ctx)
	require(script.Parent.RewardPanels).Build(screen, ctx, p)
	p.Quests = require(script.Parent.QuestPanel).Build(screen, ctx)
	return p
end

return Panels
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000045"><Properties><string name="Name">QuestPanel</string><ProtectedString name="Source"><![CDATA[-- QuestPanel: окно «Задания» (открывается кнопкой в меню).
-- Вкладка «Задания»: сюжетный квест Drill-Bot 3000 и 3 динамических (всегда разные).
-- Вкладка «Неделя»: 4 недельных задания и бонус за все — эксклюзивный Звёздный Грифон.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Configs = ReplicatedStorage:WaitForChild("Configs")
local QuestsData = require(Configs:WaitForChild("QuestsData"))
local BoostsData = require(Configs:WaitForChild("BoostsData"))
local RewardsData = require(Configs:WaitForChild("RewardsData"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Util = require(Shared:WaitForChild("Util"))
local Net = require(Shared:WaitForChild("Net"))

local UI = require(script.Parent.UIKit)
local Icons2D = require(script.Parent.Icons2D)
local Icons3D = require(script.Parent.Icons3D)

local QuestPanel = {}

local TYPE_GLYPH = {
	MineBlocks = "Pickaxe", MineOre = "Chest", MineVeins = "Shard", Depth = "Rocket", DealDamage = "Sword",
	Nuggets = "Coin", OpenEggs = "Egg", UseBoosts = "Flask", GrowSeed = "Sprout", EarnCoins = "Coin",
	SellCount = "ShopBag", Crits = "Bolt", Hits = "Pickaxe", SellFull = "Backpack", PlayMinutes = "Clock",
}

local function rewardText(r, data)
	local parts = {}
	local coins = r.Coins
	if r.Trips and data then
		-- недельные: монеты по открытому ярусу (как на сервере)
		local rb = data.Derived and data.Derived.RebirthMult or 1
		coins = math.floor(RewardsData.CoinScale(math.max(1, data.UnlockedBiome or 1)) * r.Trips * rb)
	end
	if coins and coins > 0 then
		table.insert(parts, Util.Format(coins) .. " монет")
	end
	if r.Boosts then
		for id, n in pairs(r.Boosts) do
			local b = BoostsData.ById[id]
			table.insert(parts, n .. "x " .. (b and b.Name or id))
		end
	end
	if r.Shards and r.Shards > 0 then
		table.insert(parts, r.Shards .. " осколок")
	end
	if r.PetSlot then
		table.insert(parts, "+1 слот питомца")
	end
	return table.concat(parts, ", ")
end

local function rewardGlyph(r)
	if r.PetSlot then
		return "Paw"
	end
	if r.Shards then
		return "Shard"
	end
	if r.Boosts then
		for id in pairs(r.Boosts) do
			return id
		end
	end
	return "Coin"
end

local function weeklyDone(w)
	local n = 0
	for _, q in ipairs((w and w.Quests) or {}) do
		if q.Claimed then
			n = n + 1
		end
	end
	return n
end

-- Сколько заданий можно забрать прямо сейчас (для бейджа «!»)
function QuestPanel.Claimable(data)
	if not data then
		return 0
	end
	local n = 0
	local q = QuestsData.Story[data.StoryIndex or 1]
	if q then
		local cur = (q.Stat == "SessionEggs") and (data.Derived and data.Derived.SessionEggs or 0) or (data.Stats and data.Stats[q.Stat] or 0)
		if cur >= q.Target then
			n = n + 1
		end
	end
	for i = 1, 3 do
		local dq = data.Dynamic and data.Dynamic[tostring(i)]
		if dq and dq.Type and dq.Progress >= dq.Target then
			n = n + 1
		end
	end
	local w = data.Weekly
	if w and w.Quests then
		for _, wq in ipairs(w.Quests) do
			if not wq.Claimed and wq.Progress >= wq.Target then
				n = n + 1
			end
		end
		if #w.Quests > 0 and not w.BonusClaimed and weeklyDone(w) == #w.Quests then
			n = n + 1
		end
	end
	return n
end

local function claim(ctx, kind, slot)
	local ok, res = pcall(function()
		return Net.Get("ClaimQuest"):InvokeServer(kind, slot)
	end)
	if ok and res and res.ok then
		ctx.Sound.Play("Unlock")
	elseif ok and res and res.msg then
		ctx.Toast(res.msg, "warn")
	end
end

function QuestPanel.Build(screen, ctx)
	local win = UI.Window(screen, { Name = "Quests", Title = "ЗАДАНИЯ", Color = UI.Colors.Blue, Size = UDim2.fromOffset(800, 570) })
	local c = win.Content

	local pages = {}
	for i = 1, 2 do
		pages[i] = UI.new("Frame", { Name = "Page" .. i, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, -56), Position = UDim2.fromOffset(0, 56), Visible = i == 1, Parent = c })
	end
	UI.List(pages[1], 10)

	local function badgeIcon(parent, glyph, size)
		for _, ch in ipairs(parent:GetChildren()) do
			if ch:IsA("Frame") and ch.Name == "Glyph" then
				ch:Destroy()
			end
		end
		local ic = Icons2D.New(parent, glyph, size, { ZIndex = 3 })
		ic.Name = "Glyph"
		ic.AnchorPoint = Vector2.new(0.5, 0.5)
		ic.Position = UDim2.fromScale(0.5, 0.47)
	end

	-- широкая карточка (вкладка «Задания»)
	local function card(order, color, glyph, height)
		local holder, face = UI.Plate(pages[1], UDim2.new(1, 0, 0, height), nil, UI.Colors.Panel, 16)
		holder.LayoutOrder = order
		UI.Gradient(face, Color3.new(1, 1, 1), Color3.fromRGB(222, 218, 240))
		local badge = UI.new("Frame", { BackgroundColor3 = color, Size = UDim2.fromOffset(height - 20, height - 20), Position = UDim2.fromOffset(10, 10), Parent = face })
		UI.Corner(badge, 14)
		UI.Stroke(badge, 3, UI.Ink, true)
		UI.Gradient(badge, Color3.new(1, 1, 1), Color3.fromRGB(200, 200, 212))
		local isz = math.floor((height - 20) * 0.72)
		badgeIcon(badge, glyph, isz)
		local x0 = height + 4
		local tag = UI.Text(face, "", { Size = UDim2.new(1, -(x0 + 200), 0, 20), Position = UDim2.fromOffset(x0, 8), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = color, Stroke = false, MaxText = 16 })
		local title = UI.Text(face, "", { Size = UDim2.new(1, -(x0 + 200), 0, 28), Position = UDim2.fromOffset(x0, 26), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UI.Ink, Stroke = false, MaxText = 24 })
		local bar = UI.Bar(face, UDim2.new(1, -(x0 + 200), 0, 22), UDim2.new(0, x0, 1, -34), color)
		local rewardHolder = UI.new("Frame", { BackgroundColor3 = UI.Colors.Panel2, Size = UDim2.fromOffset(176, height - 64), Position = UDim2.new(1, -188, 0, 10), Parent = face })
		UI.Corner(rewardHolder, 12)
		UI.Stroke(rewardHolder, 2, UI.Colors.Panel3, true)
		local rglyph = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(34, 34), Position = UDim2.fromOffset(4, 2), Parent = rewardHolder })
		local reward = UI.Text(rewardHolder, "", { Size = UDim2.new(1, -44, 1, -6), Position = UDim2.fromOffset(40, 3), TextColor3 = UI.Ink, Stroke = false, MaxText = 15, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left })
		local btn = UI.Button({ Parent = face, Text = "ЗАБРАТЬ", Color = UI.Colors.Green, Size = UDim2.fromOffset(176, 40), Position = UDim2.new(1, -188, 1, -50), TextSize = 20, Glyph = "Check" })
		local timer = UI.Text(face, "", { Size = UDim2.fromOffset(176, 40), Position = UDim2.new(1, -188, 1, -50), TextColor3 = UI.Colors.Gray, Stroke = false, MaxText = 18 })
		local obj = { Tag = tag, Title = title, Bar = bar, Reward = reward, Btn = btn, Timer = timer, LastGlyph = nil, Glyph = glyph }
		function obj.SetRewardGlyph(name)
			if obj.LastGlyph ~= name then
				obj.LastGlyph = name
				for _, ch in ipairs(rglyph:GetChildren()) do
					ch:Destroy()
				end
				Icons2D.New(rglyph, name, 34, { Shadow = false, ZIndex = 3, Color = (name == "Coin") and Color3.fromRGB(255, 208, 64) or nil })
			end
		end
		function obj.SetGlyph(name)
			if name and obj.Glyph ~= name then
				obj.Glyph = name
				badgeIcon(badge, name, isz)
			end
		end
		return obj
	end

	local story = card(0, UI.Colors.Orange, "Quest", 118)
	local slotGlyphs = { "Pickaxe", "Egg", "Star" }
	local slotColors = { UI.Colors.Teal, UI.Colors.Purple, UI.Colors.Pink }
	local slotTags = { "ДОБЫЧА", "КОЛЛЕКЦИЯ", "МАСТЕРСТВО" }
	local slots = {}
	for i = 1, 3 do
		slots[i] = card(i, slotColors[i], slotGlyphs[i], 100)
		slots[i].Btn.Activated:Connect(function()
			claim(ctx, "Dynamic", i)
		end)
	end
	story.Btn.Activated:Connect(function()
		claim(ctx, "Story")
	end)

	-----------------------------------------------------------------------------------------
	-- Неделя
	-----------------------------------------------------------------------------------------
	local wp = pages[2]
	local weekTimer = UI.Text(wp, "", { Size = UDim2.new(1, 0, 0, 26), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UI.Colors.Blue, Stroke = false, MaxText = 20 })
	local grid = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 294), Position = UDim2.fromOffset(0, 30), Parent = wp })
	local weekColors = { UI.Colors.Teal, UI.Colors.Purple, UI.Colors.Orange, UI.Colors.Pink }
	local weekly = {}
	for i = 1, 4 do
		local col = weekColors[i]
		local gx, gy = (i - 1) % 2, math.floor((i - 1) / 2)
		local _, face = UI.Plate(grid, UDim2.new(0.5, -6, 0, 142), UDim2.new(gx * 0.5, gx * 6, 0, gy * 152), UI.Colors.Panel, 16)
		UI.Gradient(face, Color3.new(1, 1, 1), Color3.fromRGB(222, 218, 240))
		local badge = UI.new("Frame", { BackgroundColor3 = col, Size = UDim2.fromOffset(58, 58), Position = UDim2.fromOffset(10, 10), Parent = face })
		UI.Corner(badge, 14)
		UI.Stroke(badge, 3, UI.Ink, true)
		UI.Gradient(badge, Color3.new(1, 1, 1), Color3.fromRGB(200, 200, 212))
		local title = UI.Text(face, "", { Size = UDim2.new(1, -90, 0, 58), Position = UDim2.fromOffset(78, 10), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UI.Ink, Stroke = false, MaxText = 21, TextWrapped = true })
		local bar = UI.Bar(face, UDim2.new(1, -20, 0, 20), UDim2.fromOffset(10, 72), col)
		local rglyph = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(30, 30), Position = UDim2.new(0, 10, 1, -40), Parent = face })
		local reward = UI.Text(face, "", { Size = UDim2.new(1, -190, 0, 36), Position = UDim2.new(0, 44, 1, -43), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UI.Ink, Stroke = false, MaxText = 14, TextWrapped = true })
		local btn = UI.Button({ Parent = face, Text = "ЗАБРАТЬ", Color = UI.Colors.Green, Size = UDim2.fromOffset(132, 36), Position = UDim2.new(1, -142, 1, -44), TextSize = 18 })
		local state = UI.Text(face, "", { Size = UDim2.fromOffset(132, 36), Position = UDim2.new(1, -142, 1, -44), TextColor3 = UI.Colors.Gray, Stroke = false, MaxText = 16 })
		local obj = { Title = title, Bar = bar, Reward = reward, Btn = btn, State = state, Glyph = nil, RGlyph = nil }
		function obj.Set(glyph, rg)
			if obj.Glyph ~= glyph then
				obj.Glyph = glyph
				badgeIcon(badge, glyph, 42)
			end
			if obj.RGlyph ~= rg then
				obj.RGlyph = rg
				for _, ch in ipairs(rglyph:GetChildren()) do
					ch:Destroy()
				end
				Icons2D.New(rglyph, rg, 30, { Shadow = false, ZIndex = 3, Color = (rg == "Coin") and Color3.fromRGB(255, 208, 64) or nil })
			end
		end
		btn.Activated:Connect(function()
			claim(ctx, "Weekly", i)
		end)
		weekly[i] = obj
	end

	-- бонус за все недельные: эксклюзивный питомец
	local bHolder, bFace = UI.Plate(wp, UDim2.new(1, 0, 0, 108), UDim2.fromOffset(0, 334), Color3.fromRGB(255, 236, 170), 18)
	UI.Gradient(bFace, Color3.fromRGB(255, 250, 225), Color3.fromRGB(255, 214, 120))
	local petBox = UI.new("Frame", { BackgroundColor3 = Color3.fromRGB(255, 196, 70), Size = UDim2.fromOffset(88, 88), Position = UDim2.fromOffset(10, 10), Parent = bFace })
	UI.Corner(petBox, 16)
	UI.Stroke(petBox, 3, UI.Ink, true)
	UI.Gradient(petBox, Color3.fromRGB(255, 250, 220), Color3.fromRGB(255, 170, 60))
	local petId = QuestsData.WeeklyBonus.Reward.Pet
	local okPet, petModel = pcall(function()
		return ctx.PetModel(petId, false)
	end)
	if okPet and petModel then
		Icons3D.New(petBox, petModel, { Size = 88, View = Vector3.new(0.6, 0.3, -1) })
	else
		badgeIcon(petBox, "Paw", 60)
	end
	UI.Text(bFace, "НЕДЕЛЬНЫЙ БОНУС · ЭКСКЛЮЗИВ", { Size = UDim2.new(1, -300, 0, 20), Position = UDim2.fromOffset(114, 10), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Color3.fromRGB(190, 110, 20), Stroke = false, MaxText = 16 })
	local bTitle = UI.Text(bFace, "", { Size = UDim2.new(1, -300, 0, 30), Position = UDim2.fromOffset(114, 30), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UI.Ink, Stroke = false, MaxText = 24 })
	local bBar = UI.Bar(bFace, UDim2.new(1, -300, 0, 22), UDim2.fromOffset(114, 70), UI.Colors.Orange)
	local bBtn = UI.Button({ Parent = bFace, Text = "ЗАБРАТЬ", Color = UI.Colors.Orange, Size = UDim2.fromOffset(170, 48), Position = UDim2.new(1, -182, 0.5, -24), TextSize = 20, Glyph = "Gift" })
	local bState = UI.Text(bFace, "", { Size = UDim2.fromOffset(170, 48), Position = UDim2.new(1, -182, 0.5, -24), TextColor3 = Color3.fromRGB(150, 100, 40), Stroke = false, MaxText = 18 })
	bBtn.Activated:Connect(function()
		claim(ctx, "WeeklyBonus")
	end)

	local tabs
	local current = 1
	local tabBadge

	local function renderMain(data)
		local idx = data.StoryIndex or 1
		local q = QuestsData.Story[idx]
		if q then
			local cur = (q.Stat == "SessionEggs") and (data.Derived and data.Derived.SessionEggs or 0) or (data.Stats and data.Stats[q.Stat] or 0)
			cur = math.min(cur, q.Target)
			story.Tag.Text = "СЮЖЕТ · DRILL-BOT 3000 · " .. idx .. "/" .. #QuestsData.Story
			story.Title.Text = q.Title .. ": " .. q.Text
			story.Bar.Set(cur / q.Target, Util.Format(cur) .. " / " .. Util.Format(q.Target))
			story.Reward.Text = rewardText(q.Reward)
			story.SetRewardGlyph(rewardGlyph(q.Reward))
			local done = cur >= q.Target
			story.Btn.Holder.Visible = done
			story.Timer.Text = done and "" or "В процессе"
		else
			story.Tag.Text = "СЮЖЕТ"
			story.Title.Text = "Все сюжетные задания выполнены!"
			story.Bar.Set(1, "★")
			story.Reward.Text = "—"
			story.Btn.Holder.Visible = false
			story.Timer.Text = ""
		end
		for i = 1, 3 do
			local s = slots[i]
			local dq = data.Dynamic and data.Dynamic[tostring(i)]
			s.Tag.Text = slotTags[i]
			if dq and dq.Type then
				s.SetGlyph(TYPE_GLYPH[dq.Type] or slotGlyphs[i])
				s.Title.Text = dq.Text
				s.Bar.Set(dq.Progress / dq.Target, Util.Format(dq.Progress) .. " / " .. Util.Format(dq.Target))
				s.Reward.Text = rewardText(dq.Reward or {})
				s.SetRewardGlyph(rewardGlyph(dq.Reward or {}))
				local done = dq.Progress >= dq.Target
				s.Btn.Holder.Visible = done
				s.Timer.Text = done and "" or "В процессе"
			else
				s.SetGlyph("Hourglass")
				s.Title.Text = "Новое задание скоро..."
				s.Bar.Set(0, "")
				s.Reward.Text = "—"
				s.Btn.Holder.Visible = false
				if dq and dq.Cooldown then
					s.Timer.Text = "Через " .. Util.Time(math.max(0, dq.Cooldown - ctx.ClientState.ServerNow()))
				end
			end
		end
	end

	local function renderWeek(data)
		local w = data.Weekly or {}
		local list = w.Quests or {}
		local now = ctx.ClientState.ServerNow()
		if w.Ends then
			local left = math.max(0, w.Ends - now)
			local t
			if left >= 86400 then
				t = math.floor(left / 86400) .. " д " .. math.floor(left % 86400 / 3600) .. " ч"
			else
				t = Util.Time(left)
			end
			weekTimer.Text = "Новые недельные задания через " .. t
		else
			weekTimer.Text = "Недельные задания"
		end
		for i = 1, 4 do
			local o = weekly[i]
			local q = list[i]
			if q then
				o.Set(TYPE_GLYPH[q.Type] or "Star", rewardGlyph(q.Reward or {}))
				o.Title.Text = q.Text
				o.Bar.Set(q.Progress / q.Target, Util.Format(q.Progress) .. " / " .. Util.Format(q.Target))
				o.Reward.Text = rewardText(q.Reward or {}, data)
				local done = q.Progress >= q.Target
				o.Btn.Holder.Visible = done and not q.Claimed
				o.State.Text = q.Claimed and "Получено" or (done and "" or "В процессе")
			else
				o.Set("Hourglass", "Coin")
				o.Title.Text = "Загрузка..."
				o.Bar.Set(0, "")
				o.Reward.Text = ""
				o.Btn.Holder.Visible = false
				o.State.Text = ""
			end
		end
		local done = weeklyDone(w)
		local total = math.max(#list, 4)
		local mult = RewardsData.SpecialMult(petId, data.UnlockedBiome or 1)
		bTitle.Text = RewardsData.SpecialPets[petId].Name .. " x" .. Util.Format(mult) .. " + бусты"
		bBar.Set(done / total, "Выполнено " .. done .. " / " .. total)
		local ready = done >= total and not w.BonusClaimed
		bBtn.Holder.Visible = ready
		bState.Text = w.BonusClaimed and "Получено" or (ready and "" or "Заверши все 4")
	end

	local function render()
		local data = ctx.ClientState.Data
		if not data then
			return
		end
		if current == 1 then
			renderMain(data)
		else
			renderWeek(data)
		end
		-- «!» на вкладке недели, если там есть что забрать
		local wn = 0
		local w = data.Weekly
		if w and w.Quests then
			for _, q in ipairs(w.Quests) do
				if not q.Claimed and q.Progress >= q.Target then
					wn = wn + 1
				end
			end
			if #w.Quests > 0 and not w.BonusClaimed and weeklyDone(w) == #w.Quests then
				wn = wn + 1
			end
		end
		tabBadge.Visible = wn > 0
	end

	tabs = UI.Tabs(c, { "Задания", "Неделя" }, { UI.Colors.Blue, UI.Colors.Orange }, function(i)
		current = i
		for k, pg in ipairs(pages) do
			pg.Visible = k == i
		end
		render()
	end)
	local weekBtn = tabs.Buttons[2]
	tabBadge = UI.new("Frame", { Name = "Badge", BackgroundColor3 = UI.Colors.Red, Size = UDim2.fromOffset(24, 24), Position = UDim2.new(1, -14, 0, -8), Visible = false, ZIndex = 8, Parent = weekBtn.Holder })
	UI.Corner(tabBadge, UDim.new(1, 0))
	UI.Stroke(tabBadge, 2.5, UI.Ink, true)
	UI.Text(tabBadge, "!", { Size = UDim2.fromScale(1, 1), ZIndex = 9, MaxText = 18 })

	win.SelectTab = function(i)
		tabs.Select(i)
	end
	ctx.ClientState.Changed:Connect(function()
		if win.IsOpen then
			render()
		end
	end)
	win.Opened:Connect(function()
		tabs.Select(current)
	end)
	task.spawn(function()
		while true do
			if win.IsOpen then
				render()
			end
			task.wait(1)
		end
	end)
	return win
end

return QuestPanel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000046"><Properties><string name="Name">RewardPanels</string><ProtectedString name="Source"><![CDATA[-- RewardPanels: ежедневные награды (7 дней), колесо удачи и статистика игрока.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local Configs = ReplicatedStorage:WaitForChild("Configs")
local RewardsData = require(Configs:WaitForChild("RewardsData"))
local Balance = require(Configs:WaitForChild("Balance"))
local BoostsData = require(Configs:WaitForChild("BoostsData"))
local SeedsData = require(Configs:WaitForChild("SeedsData"))
local PetsData = require(Configs:WaitForChild("PetsData"))
local QuestsData = require(Configs:WaitForChild("QuestsData"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Util = require(Shared:WaitForChild("Util"))
local Net = require(Shared:WaitForChild("Net"))
local Stats = require(Shared:WaitForChild("Stats"))

local UI = require(script.Parent.UIKit)
local Icons3D = require(script.Parent.Icons3D)
local Icons2D = require(script.Parent.Icons2D)
local GOLD = Color3.fromRGB(255, 208, 64)

local RewardPanels = {}
local player = Players.LocalPlayer

local function c3(t)
	return Color3.fromRGB(t[1], t[2], t[3])
end

local function invoke(ctx, remote, ...)
	local ok, res = pcall(function(...)
		return Net.Get(remote):InvokeServer(...)
	end, ...)
	if not ok then
		ctx.Toast("Ошибка соединения, попробуй ещё раз", "error")
		return nil
	end
	if res and not res.ok and res.msg and res.msg ~= "" then
		ctx.Toast(res.msg, "warn")
		ctx.Sound.Play("Error")
	end
	return res
end

local function biomeOf(ctx)
	local d = ctx.ClientState.Data
	return math.clamp(d and d.UnlockedBiome or 1, 1, 5)
end

-- Текст и иконка награды (для карточек и сегментов колеса)
local function describe(entry, biome, short)
	if entry.Kind == "Coins" then
		return Util.Format(RewardsData.CoinScale(biome) * entry.Amount), "Coin"
	elseif entry.Kind == "Boost" then
		local b = BoostsData.ById[entry.Id]
		return (short and "" or (b.Name .. " ")) .. "x" .. entry.Amount, entry.Id
	elseif entry.Kind == "Seed" then
		local seed = SeedsData.ByBiome[biome] or SeedsData.List[1]
		return short and "Семя" or seed.Name, "Seed"
	elseif entry.Kind == "Pet" then
		local def = PetsData.ById[entry.Id]
		return (def and def.Name or entry.Id), "Pet"
	elseif entry.Kind == "Bundle" then
		local parts = {}
		for _, it in ipairs(entry.Items) do
			local t = describe(it, biome, true)
			table.insert(parts, t)
		end
		return table.concat(parts, " + "), "Gift"
	end
	return "?", "Star"
end

local function rewardIcon(ctx, parent, entry, size)
	local _, icon = describe(entry, 1)
	if icon == "Pet" then
		return Icons3D.New(parent, ctx.PetModel(entry.Id, false), { Size = size, View = Vector3.new(0.6, 0.35, -1) })
	end
	local f = Icons2D.New(parent, icon, math.floor(size * 0.8), { Color = (icon == "Coin") and GOLD or nil, ZIndex = 5 })
	return { Viewport = f, Bounce = function()
		Icons2D.Bounce(f, 1.3)
	end }
end

local function dailyState(ctx)
	local d = ctx.ClientState.Data
	local daily = d and d.Daily or { Streak = 0, Last = 0 }
	local now = ctx.ClientState.ServerNow()
	local streak = daily.Streak or 0
	if (daily.Last or 0) > 0 and now - daily.Last > RewardsData.DailyStreakReset then
		streak = 0
	end
	local left = 0
	if (daily.Last or 0) > 0 then
		left = math.max(0, RewardsData.DailyCooldown - (now - daily.Last))
	end
	local day = (streak % #RewardsData.Daily) + 1
	return left <= 0, day, streak, left
end
RewardPanels.DailyState = dailyState

---------------------------------------------------------------------------------------------
-- Ежедневные награды
---------------------------------------------------------------------------------------------
local function buildDaily(screen, ctx)
	local win = UI.Window(screen, { Name = "Daily", Title = "ЕЖЕДНЕВНЫЕ НАГРАДЫ", Color = UI.Colors.Pink, Size = UDim2.fromOffset(900, 440) })
	local c = win.Content
	local info = UI.Text(c, "", { Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 4), TextColor3 = UI.Ink, Stroke = false, MaxText = 20 })
	local row = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 250), Position = UDim2.fromOffset(0, 38), Parent = c })
	UI.List(row, 10, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
	local cards = {}
	for i, entry in ipairs(RewardsData.Daily) do
		local big = i == #RewardsData.Daily
		local w = big and 176 or 104
		local holder, face = UI.Plate(row, UDim2.fromOffset(w, big and 244 or 214), nil, big and UI.Colors.Yellow or UI.Colors.Panel2, 16)
		holder.LayoutOrder = i
		UI.Gradient(face, Color3.new(1, 1, 1), Color3.fromRGB(210, 205, 230))
		local scale = Instance.new("UIScale")
		scale.Parent = holder
		local title = UI.Text(face, "ДЕНЬ " .. i, { Size = UDim2.new(1, -10, 0, 26), Position = UDim2.fromOffset(5, 6), MaxText = 22 })
		local icon = rewardIcon(ctx, face, entry, big and 140 or 84)
		icon.Viewport.AnchorPoint = Vector2.new(0.5, 0)
		icon.Viewport.Position = UDim2.new(0.5, 0, 0, 32)
		local text = UI.Text(face, "", { Size = UDim2.new(1, -10, 0, big and 46 or 52), Position = UDim2.new(0, 5, 1, big and -60 or -66), MaxText = big and 22 or 16, TextWrapped = true })
		local check = UI.new("Frame", { BackgroundColor3 = UI.Colors.Green, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.42), Size = UDim2.fromOffset(54, 54), Visible = false, ZIndex = 8, Parent = face })
		UI.Corner(check, UDim.new(1, 0))
		UI.Stroke(check, 3, UI.Ink, true)
		UI.Text(check, "✓", { ZIndex = 9, MaxText = 36 })
		local dim = UI.new("Frame", { BackgroundColor3 = UI.Ink, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 7, Parent = face })
		UI.Corner(dim, 16)
		cards[i] = { holder = holder, face = face, text = text, check = check, dim = dim, scale = scale, entry = entry, icon = icon, big = big }
	end
	local claim = UI.Button({ Parent = c, Text = "ЗАБРАТЬ", Color = UI.Colors.Green, Size = UDim2.fromOffset(300, 60), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 1, -66), TextSize = 28 })

	local function render()
		local ready, day, streak, left = dailyState(ctx)
		local biome = biomeOf(ctx)
		info.Text = "Серия: " .. streak .. " дн. · Пропустишь больше 48 часов — серия начнётся заново"
		for i, cd in ipairs(cards) do
			local txt = describe(cd.entry, biome)
			if cd.entry.Kind == "Pet" then
				txt = txt .. "\nx" .. string.format("%.2f", 1 + RewardsData.SpecialMult(cd.entry.Id, biome))
			end
			cd.text.Text = txt
			local claimed = i < day
			cd.check.Visible = claimed
			cd.dim.BackgroundTransparency = claimed and 0.55 or 1
			local stroke = cd.face:FindFirstChildOfClass("UIStroke")
			if stroke then
				stroke.Color = (i == day and ready) and Color3.fromRGB(255, 255, 255) or UI.Ink
				stroke.Thickness = (i == day and ready) and 5 or 3
			end
		end
		if ready then
			claim.SetText("ЗАБРАТЬ ДЕНЬ " .. day)
			claim.SetEnabled(true)
			claim.SetColor(UI.Colors.Green)
		else
			claim.SetText("Через " .. Util.Time(left))
			claim.SetEnabled(false)
		end
	end
	claim.Activated:Connect(function()
		local ready = dailyState(ctx)
		if not ready then
			return
		end
		local res = invoke(ctx, "ClaimDaily")
		if res and res.ok then
			ctx.Sound.Play("Unlock")
			local cd = cards[res.day]
			if cd then
				cd.scale.Scale = 1.25
				TweenService:Create(cd.scale, TweenInfo.new(0.4, Enum.EasingStyle.Back), { Scale = 1 }):Play()
				cd.icon.Bounce()
			end
			for _, it in ipairs(res.items or {}) do
				if it.Kind == "Pet" then
					ctx.ShowHatch({ Id = it.Id, M = it.M })
				end
			end
		end
	end)
	task.spawn(function()
		while true do
			if win.IsOpen then
				render()
				local ready, day = dailyState(ctx)
				for i, cd in ipairs(cards) do
					if i == day and ready then
						cd.scale.Scale = 1 + math.abs(math.sin(os.clock() * 3)) * 0.05
					end
				end
				task.wait(0.05)
			else
				task.wait(0.5)
			end
		end
	end)
	win.Opened:Connect(render)
	return win
end

---------------------------------------------------------------------------------------------
-- Колесо удачи
---------------------------------------------------------------------------------------------
local function buildWheel(screen, ctx)
	local win = UI.Window(screen, { Name = "Wheel", Title = "КОЛЕСО УДАЧИ", Color = UI.Colors.Yellow, Size = UDim2.fromOffset(820, 520) })
	local c = win.Content
	local R = 190
	local segs = RewardsData.Wheel
	local n = #segs
	local segAngle = 360 / n

	local area = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(2 * R + 40, 2 * R + 40), Position = UDim2.fromOffset(0, 0), Parent = c })
	-- тень и обод
	local shadow = UI.new("Frame", { BackgroundColor3 = Color3.fromRGB(40, 30, 60), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 8), Size = UDim2.fromOffset(2 * R + 24, 2 * R + 24), Parent = area })
	UI.Corner(shadow, UDim.new(1, 0))
	local rim = UI.new("Frame", { BackgroundColor3 = Color3.fromRGB(255, 200, 50), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(2 * R + 24, 2 * R + 24), Parent = area })
	UI.Corner(rim, UDim.new(1, 0))
	UI.Stroke(rim, 4, UI.Ink, true)
	UI.Gradient(rim, Color3.fromRGB(255, 240, 170), Color3.fromRGB(230, 150, 30))
	-- лампочки по ободу
	local bulbs = {}
	for i = 0, 15 do
		local a = math.rad(i * 22.5)
		local b = UI.new("Frame", { BackgroundColor3 = Color3.fromRGB(255, 255, 220), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, math.sin(a) * (R + 6), 0.5, -math.cos(a) * (R + 6)), Size = UDim2.fromOffset(12, 12), ZIndex = 3, Parent = area })
		UI.Corner(b, UDim.new(1, 0))
		UI.Stroke(b, 2, UI.Ink, true)
		bulbs[i + 1] = b
	end
	-- само колесо (вращаемый контейнер)
	local wheel = UI.new("Frame", { Name = "Wheel", Rotation = 0, BackgroundColor3 = Color3.fromRGB(50, 44, 70), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(2 * R, 2 * R), ZIndex = 2, Parent = area })
	UI.Corner(wheel, UDim.new(1, 0))
	-- секторы из тонких «спиц»: Roblox не умеет рисовать клинья, поэтому собираем их из лучей
	local spokesPer = 15
	local step = segAngle / spokesPer
	local width = math.ceil(2 * math.pi * R / (n * spokesPer) * 1.7)
	for i, seg in ipairs(segs) do
		local col = c3(seg.Color)
		for k = 0, spokesPer - 1 do
			local a = (i - 1) * segAngle + (k + 0.5) * step
			local holder = UI.new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(width, 2 * R - 4), Rotation = a, ZIndex = 2, Parent = wheel })
			local shade = (k % 2 == 0) and col or col:Lerp(Color3.new(0, 0, 0), 0.04)
			UI.new("Frame", { BackgroundColor3 = shade, Size = UDim2.fromScale(1, 0.5), ZIndex = 2, Parent = holder })
		end
		-- разделитель
		local div = UI.new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(4, 2 * R), Rotation = (i - 1) * segAngle, ZIndex = 3, Parent = wheel })
		UI.new("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.15, Size = UDim2.fromScale(1, 0.5), ZIndex = 3, Parent = div })
	end
	-- подписи секторов: отдельный НЕвращаемый слой (ViewportFrame не любит поворот родителя),
	-- иконки едут по кругу вслед за колесом и всегда стоят ровно
	local labels = UI.new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(2 * R, 2 * R), ZIndex = 4, Parent = area })
	for i, seg in ipairs(segs) do
		local lab = UI.new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(100, 92), ZIndex = 4, Parent = labels })
		local ic = rewardIcon(ctx, lab, seg, 62)
		ic.Viewport.AnchorPoint = Vector2.new(0.5, 0)
		ic.Viewport.Position = UDim2.new(0.5, 0, 0, 0)
		ic.Viewport.ZIndex = 5
		local txt = UI.Text(lab, "", { Size = UDim2.new(1, 0, 0, 24), Position = UDim2.fromOffset(0, 62), MaxText = 19, ZIndex = 6 })
		seg._label = txt
		seg._frame = lab
	end
	local function layoutLabels(rot)
		for i, seg in ipairs(segs) do
			local a = math.rad((i - 0.5) * segAngle + rot)
			seg._frame.Position = UDim2.new(0.5, math.sin(a) * R * 0.6, 0.5, -math.cos(a) * R * 0.6)
		end
	end
	layoutLabels(0)
	-- центр
	local hub = UI.new("Frame", { BackgroundColor3 = Color3.fromRGB(255, 255, 255), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(74, 74), ZIndex = 8, Parent = area })
	UI.Corner(hub, UDim.new(1, 0))
	UI.Stroke(hub, 4, UI.Ink, true)
	UI.Gradient(hub, Color3.new(1, 1, 1), Color3.fromRGB(200, 200, 215))
	local star = Icons2D.New(hub, "Star", 52, { Color = GOLD, ZIndex = 9 })
	star.AnchorPoint = Vector2.new(0.5, 0.5)
	star.Position = UDim2.fromScale(0.5, 0.47)
	-- указатель сверху
	local pointer = UI.new("Frame", { BackgroundColor3 = UI.Colors.Red, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, -R - 10), Size = UDim2.fromOffset(34, 34), Rotation = 45, ZIndex = 9, Parent = area })
	UI.Corner(pointer, 6)
	UI.Stroke(pointer, 3, UI.Ink, true)
	UI.new("Frame", { BackgroundColor3 = UI.Colors.Red, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, -R - 26), Size = UDim2.fromOffset(40, 18), ZIndex = 10, Parent = area })

	-- правая колонка
	local side = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -(2 * R + 60), 1, 0), Position = UDim2.fromOffset(2 * R + 60, 0), Parent = c })
	UI.Text(side, "Крути раз в 24 часа!", { Size = UDim2.new(1, 0, 0, 34), Position = UDim2.fromOffset(0, 10), TextColor3 = UI.Ink, Stroke = false, MaxText = 28 })
	UI.Text(side, "Награды растут вместе с открытым ярусом. Джекпот — эксклюзивный Кот Фортуны.", { Size = UDim2.new(1, 0, 0, 60), Position = UDim2.fromOffset(0, 48), TextColor3 = UI.Colors.Gray, Stroke = false, MaxText = 18, TextWrapped = true })
	local catHolder, catFace = UI.Plate(side, UDim2.fromOffset(220, 170), UDim2.fromOffset(20, 118), UI.Colors.Pink, 16)
	UI.Gradient(catFace, Color3.new(1, 1, 1), Color3.fromRGB(210, 200, 230))
	local cat = Icons3D.New(catFace, ctx.PetModel("FortuneCat", false), { Size = 150, View = Vector3.new(0.6, 0.35, -1) })
	cat.Viewport.AnchorPoint = Vector2.new(0.5, 0)
	cat.Viewport.Position = UDim2.new(0.5, 0, 0, 4)
	local catText = UI.Text(catFace, "", { Size = UDim2.new(1, -10, 0, 22), Position = UDim2.new(0, 5, 1, -26), MaxText = 18 })
	local spin = UI.Button({ Parent = side, Text = "КРУТИТЬ!", Color = UI.Colors.Green, Size = UDim2.fromOffset(260, 66), Position = UDim2.fromOffset(0, 312), TextSize = 30 })
	local timerText = UI.Text(side, "", { Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 388), TextColor3 = UI.Ink, Stroke = false, MaxText = 20 })

	local spinning = false
	local function wheelLeft()
		local d = ctx.ClientState.Data
		local last = d and d.WheelLast or 0
		if last <= 0 then
			return 0
		end
		return math.max(0, RewardsData.WheelCooldown - (ctx.ClientState.ServerNow() - last))
	end
	local function render()
		local biome = biomeOf(ctx)
		for _, seg in ipairs(segs) do
			local t = describe(seg, biome, true)
			if seg.Kind == "Pet" then
				t = "ДЖЕКПОТ"
			end
			seg._label.Text = t
		end
		catText.Text = "Кот Фортуны x" .. string.format("%.2f", 1 + RewardsData.SpecialMult("FortuneCat", biome))
		if spinning then
			return
		end
		local left = wheelLeft()
		if left > 0 then
			spin.SetText(Util.Time(left))
			spin.SetEnabled(false)
			timerText.Text = "Следующая попытка через " .. Util.Time(left)
		else
			spin.SetText("КРУТИТЬ!")
			spin.SetEnabled(true)
			spin.SetColor(UI.Colors.Green)
			timerText.Text = "Колесо готово!"
		end
	end

	local function showPrize(items)
		local texts = {}
		for _, it in ipairs(items or {}) do
			table.insert(texts, it.Text)
			if it.Kind == "Pet" then
				ctx.ShowHatch({ Id = it.Id, M = it.M })
			end
		end
		ctx.Toast("Выигрыш: " .. table.concat(texts, ", "), "good")
		ctx.Sound.Play("Reveal")
	end

	spin.Activated:Connect(function()
		if spinning or wheelLeft() > 0 then
			return
		end
		local res = invoke(ctx, "SpinWheel")
		if not (res and res.ok) then
			return
		end
		spinning = true
		spin.SetEnabled(false)
		spin.SetText("Крутится...")
		local current = wheel.Rotation % 360
		local mid = (res.index - 0.5) * segAngle
		local jitter = (math.random() - 0.5) * segAngle * 0.6
		local target = -mid + jitter
		local delta = (target - current) % 360
		local final = wheel.Rotation + 360 * 6 + delta
		local value = Instance.new("NumberValue")
		value.Value = wheel.Rotation
		local lastTick = math.floor(wheel.Rotation / segAngle)
		value.Changed:Connect(function(v)
			wheel.Rotation = v
			layoutLabels(v)
			local tickIdx = math.floor(v / segAngle)
			if tickIdx ~= lastTick then
				lastTick = tickIdx
				ctx.Sound.Play("Click", 0.1, 0.6)
			end
		end)
		local tw = TweenService:Create(value, TweenInfo.new(4.6, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { Value = final })
		tw:Play()
		tw.Completed:Connect(function()
			value:Destroy()
			spinning = false
			showPrize(res.items)
			render()
		end)
	end)

	task.spawn(function()
		local t = 0
		while true do
			if win.IsOpen then
				t = t + 1
				for i, b in ipairs(bulbs) do
					local on = ((i + t) % 2 == 0)
					if spinning then
						on = ((i + t) % 3 == 0)
					end
					b.BackgroundColor3 = on and Color3.fromRGB(255, 255, 210) or Color3.fromRGB(200, 120, 40)
				end
				render()
				task.wait(spinning and 0.08 or 0.4)
			else
				task.wait(0.5)
			end
		end
	end)
	win.Opened:Connect(render)
	return win
end

---------------------------------------------------------------------------------------------
-- Статистика
---------------------------------------------------------------------------------------------
local function buildStats(screen, ctx)
	local win = UI.Window(screen, { Name = "Stats", Title = "СТАТИСТИКА", Color = Color3.fromRGB(120, 110, 255), Size = UDim2.fromOffset(860, 520) })
	local c = win.Content
	-- шапка игрока
	local _, head = UI.Plate(c, UDim2.new(1, 0, 0, 86), UDim2.fromOffset(0, 0), UI.Colors.Panel2, 16)
	local avatar = UI.new("ImageLabel", { BackgroundColor3 = UI.Colors.Blue, Size = UDim2.fromOffset(70, 70), Position = UDim2.fromOffset(8, 8), Image = "rbxthumb://type=AvatarHeadShot&id=" .. player.UserId .. "&w=150&h=150", Parent = head })
	UI.Corner(avatar, UDim.new(1, 0))
	UI.Stroke(avatar, 3, UI.Ink, true)
	UI.Text(head, player.DisplayName, { Size = UDim2.new(0.5, 0, 0, 34), Position = UDim2.fromOffset(92, 8), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UI.Ink, Stroke = false, MaxText = 30 })
	local sub = UI.Text(head, "", { Size = UDim2.new(1, -100, 0, 26), Position = UDim2.fromOffset(92, 46), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UI.Colors.Gray, Stroke = false, MaxText = 20 })

	local scroll = UI.Scroll(c, UDim2.new(1, 0, 1, -98), UDim2.fromOffset(0, 96))
	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.fromOffset(258, 76)
	grid.CellPadding = UDim2.fromOffset(12, 12)
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.Parent = scroll
	UI.Padding(scroll, 6)

	local function bestPet(data)
		local best, bm = nil, 0
		for _, p in pairs(data.Pets or {}) do
			local m = Stats.PetMult(p)
			if m > bm then
				best, bm = p, m
			end
		end
		if not best then
			return "—"
		end
		local def = PetsData.ById[best.Id]
		local tier = Balance.PetTiers[(best.T or 0) + 1]
		return (def and def.Name or best.Id) .. ((tier and tier.Name ~= "") and (" " .. tier.Name) or "") .. " · ур." .. (best.L or 1)
	end

	local defs = {
		{ "Всего монет заработано", "Coin", function(d) return Util.Format(d.TotalCoins or 0) end },
		{ "Блоков сломано", "Drill", function(d) return Util.Commas(d.Stats.BlocksBroken or 0) end },
		{ "Рекорд глубины", "Planet", function(d) return Util.Commas(d.Stats.MaxDepth or 0) .. " м" end },
		{ "Суммарный урон", "Star", function(d) return Util.Format(d.Stats.TotalDamage or 0) end },
		{ "Критических ударов", "DrillOvercharge", function(d) return Util.Commas(d.Stats.Crits or 0) end },
		{ "Рюкзаков продано", "Backpack", function(d) return Util.Commas(d.Stats.Sells or 0) end },
		{ "Яиц открыто", "Gift", function(d) return Util.Commas(d.Stats.EggsOpened or 0) end },
		{ "Питомцев сейчас", "Paw", function(d) return tostring(Stats.PetCount(d)) end },
		{ "Лучший питомец", "Paw", bestPet },
		{ "Улучшений питомцев", "Star", function(d) return Util.Commas(d.Stats.GoldenCrafted or 0) end },
		{ "Семян выращено", "Seed", function(d) return Util.Commas(d.Stats.SeedsGrown or 0) end },
		{ "Перерождений", "Hourglass", function(d) return tostring(d.Rebirths or 0) end },
		{ "Хроно-Осколков", "Shard", function(d) return tostring(d.Shards or 0) end },
		{ "Сюжетных квестов", "Scroll", function(d) return math.min((d.StoryIndex or 1) - 1, #QuestsData.Story) .. " / " .. #QuestsData.Story end },
		{ "Ежедневных наград", "Gift", function(d) return tostring(d.Stats.DailyClaims or 0) end },
		{ "Вращений колеса", "Wheel", function(d) return tostring(d.Stats.WheelSpins or 0) end },
		{ "Время в игре", "Clock", function(d) return Util.Time(d.Stats.PlayTime or 0) end },
		{ "Открыто ярусов", "Planet", function(d) return (d.UnlockedBiome or 1) .. " / 5" end },
	}
	local values = {}
	for i, def in ipairs(defs) do
		local holder, face = UI.Plate(scroll, UDim2.fromOffset(258, 76), nil, UI.Colors.Panel, 14)
		holder.LayoutOrder = i
		UI.Gradient(face, Color3.new(1, 1, 1), Color3.fromRGB(220, 216, 236))
		local badgeColors = { UI.Colors.Orange, UI.Colors.Purple, UI.Colors.Red, UI.Colors.Blue, UI.Colors.Pink, UI.Colors.Green, UI.Colors.Teal, UI.Colors.Yellow }
		local bg = UI.new("Frame", { BackgroundColor3 = badgeColors[(i - 1) % #badgeColors + 1], Size = UDim2.fromOffset(56, 56), Position = UDim2.fromOffset(10, 10), Parent = face })
		UI.Corner(bg, 14)
		UI.Stroke(bg, 3, UI.Ink, true)
		UI.Gradient(bg, Color3.new(1, 1, 1), Color3.fromRGB(200, 200, 212))
		local ic = Icons2D.New(bg, def[2], 40, { ZIndex = 3 })
		ic.AnchorPoint = Vector2.new(0.5, 0.5)
		ic.Position = UDim2.fromScale(0.5, 0.47)
		UI.Text(face, def[1], { Size = UDim2.new(1, -86, 0, 22), Position = UDim2.fromOffset(76, 10), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UI.Colors.Gray, Stroke = false, MaxText = 16 })
		values[i] = UI.Text(face, "", { Size = UDim2.new(1, -86, 0, 32), Position = UDim2.fromOffset(76, 34), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UI.Ink, Stroke = false, MaxText = 26 })
	end
	local function render()
		local d = ctx.ClientState.Data
		if not d or not d.Stats then
			return
		end
		sub.Text = "Ребёрсов: " .. (d.Rebirths or 0) .. "  ·  Монет: " .. Util.Format(d.Coins or 0) .. "  ·  Урон: " .. Util.Format(d.Derived and d.Derived.Damage or 0)
		for i, def in ipairs(defs) do
			values[i].Text = def[3](d)
		end
	end
	ctx.ClientState.Changed:Connect(function()
		if win.IsOpen then
			render()
		end
	end)
	win.Opened:Connect(render)
	return win
end

function RewardPanels.Build(screen, ctx, panels)
	panels.Daily = buildDaily(screen, ctx)
	panels.Wheel = buildWheel(screen, ctx)
	panels.Stats = buildStats(screen, ctx)
	return panels
end

return RewardPanels
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000047"><Properties><string name="Name">SettingsPanel</string><ProtectedString name="Source"><![CDATA[-- SettingsPanel: окно «Настройки» (графика, музыка, звуки) и выбор графики при первом входе.
local UI = require(script.Parent.UIKit)
local Icons2D = require(script.Parent.Icons2D)

local SettingsPanel = {}

local QUALITY = {
	{ Id = "Low", Name = "НИЗКАЯ", Color = UI.Colors.Green, Glyph = "Bolt", Desc = "Без теней и эффектов, меньше декора. Для слабых телефонов." },
	{ Id = "Medium", Name = "СРЕДНЯЯ", Color = UI.Colors.Blue, Glyph = "Star", Desc = "Тени, свечение и облака. Хороший баланс." },
	{ Id = "High", Name = "ВЫСОКАЯ", Color = UI.Colors.Purple, Glyph = "Crown", Desc = "Всё на максимум: густая трава, цветы, светлячки, лучи солнца, частицы." },
}
SettingsPanel.Quality = QUALITY

local VOLUMES = { 0, 0.25, 0.5, 0.75, 1 }

local function qualityCard(parent, q, size, pos, onPick)
	local b = UI.Button({ Parent = parent, Color = q.Color, Size = size, Position = pos, Radius = 20 })
	local ic = Icons2D.New(b.Face, q.Glyph, math.floor(size.Y.Offset * 0.36), { ZIndex = 4 })
	ic.AnchorPoint = Vector2.new(0.5, 0)
	ic.Position = UDim2.new(0.5, 0, 0, 12)
	UI.Text(b.Face, q.Name, { Size = UDim2.new(1, -16, 0, 34), Position = UDim2.new(0, 8, 0, math.floor(size.Y.Offset * 0.36) + 16), MaxText = 28, ZIndex = 5, StrokeThickness = 3 })
	UI.Text(b.Face, q.Desc, { Size = UDim2.new(1, -20, 0, 60), Position = UDim2.new(0, 10, 1, -70), MaxText = 15, ZIndex = 5, TextWrapped = true, StrokeThickness = 1.5 })
	local mark = UI.new("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), Size = UDim2.fromOffset(30, 30), Position = UDim2.new(1, -38, 0, 8), Visible = false, ZIndex = 6, Parent = b.Face })
	UI.Corner(mark, UDim.new(1, 0))
	UI.Stroke(mark, 2.5, UI.Ink, true)
	local ck = Icons2D.New(mark, "Check", 22, { Color = UI.Colors.Green, Shadow = false, ZIndex = 7 })
	ck.AnchorPoint = Vector2.new(0.5, 0.5)
	ck.Position = UDim2.fromScale(0.5, 0.5)
	b.Activated:Connect(function()
		onPick(q.Id)
	end)
	return b, mark
end

function SettingsPanel.Build(screen, ctx)
	local S = ctx.Settings
	local win = UI.Window(screen, { Name = "Settings", Title = "НАСТРОЙКИ", Color = Color3.fromRGB(110, 118, 150), Icon = "Gear", Size = UDim2.fromOffset(760, 480) })
	local c = win.Content
	UI.Text(c, "ГРАФИКА", { Size = UDim2.new(1, 0, 0, 26), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UI.Ink, Stroke = false, MaxText = 22 })
	local marks = {}
	for i, q in ipairs(QUALITY) do
		local _, mark = qualityCard(c, q, UDim2.fromOffset(226, 210), UDim2.fromOffset((i - 1) * 241, 32), function(id)
			S.Set("Quality", id)
			ctx.Sound.Play("Unlock")
		end)
		marks[q.Id] = mark
	end
	-- громкость
	local function volumeRow(y, label, glyph, key)
		local holder, face = UI.Plate(c, UDim2.new(1, 0, 0, 70), UDim2.fromOffset(0, y), UI.Colors.Panel, 16)
		local ic = Icons2D.New(face, glyph, 44, { ZIndex = 3, Color = UI.Colors.Purple })
		ic.Position = UDim2.fromOffset(12, 13)
		UI.Text(face, label, { Size = UDim2.fromOffset(170, 30), Position = UDim2.fromOffset(66, 20), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UI.Ink, Stroke = false, MaxText = 22 })
		local btns = {}
		for k, v in ipairs(VOLUMES) do
			local b = UI.Button({ Parent = face, Text = v == 0 and "ВЫКЛ" or (math.floor(v * 100) .. "%"), Color = UI.Colors.Gray, Size = UDim2.fromOffset(82, 44), Position = UDim2.new(0, 240 + (k - 1) * 88, 0, 13), TextSize = 17, Radius = 12 })
			b.Activated:Connect(function()
				S.Set(key, v)
			end)
			btns[k] = b
		end
		return function(cur)
			for k, v in ipairs(VOLUMES) do
				btns[k].SetColor(math.abs((cur or 0) - v) < 0.01 and UI.Colors.Green or UI.Colors.Gray)
			end
		end
	end
	local setMusic = volumeRow(258, "Музыка", "Note", "Music")
	local setSfx = volumeRow(338, "Звуки", "Bolt", "Sfx")
	local function render()
		local cur = S.Get()
		for id, m in pairs(marks) do
			m.Visible = cur.Quality == id
		end
		setMusic(cur.Music)
		setSfx(cur.Sfx)
	end
	S.Changed:Connect(render)
	win.Opened:Connect(render)
	render()
	return win
end

-- Полноэкранный выбор графики при первом входе. onDone вызывается после выбора.
function SettingsPanel.Chooser(screen, ctx, onDone)
	local S = ctx.Settings
	local overlay = UI.new("Frame", { Name = "GraphicsChooser", BackgroundColor3 = Color3.fromRGB(16, 12, 34), BackgroundTransparency = 0.25, Size = UDim2.fromScale(1, 1), ZIndex = 50, Parent = screen })
	local box = UI.new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(760, 400), ZIndex = 51, Parent = overlay })
	local sc = Instance.new("UIScale")
	sc.Parent = box
	UI.Text(box, "ВЫБЕРИ КАЧЕСТВО ГРАФИКИ", { Size = UDim2.new(1, 0, 0, 50), MaxText = 40, ZIndex = 52, StrokeThickness = 3.5 })
	UI.Text(box, "Поменять можно в любой момент: меню → Настройки", { Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 50), MaxText = 20, ZIndex = 52, TextColor3 = Color3.fromRGB(200, 200, 230) })
	local done = false
	for i, q in ipairs(QUALITY) do
		local b = qualityCard(box, q, UDim2.fromOffset(236, 260), UDim2.fromOffset((i - 1) * 262, 96), function(id)
			if done then
				return
			end
			done = true
			S.Set("Quality", id)
			ctx.Sound.Play("Unlock")
			overlay:Destroy()
			if onDone then
				onDone(id)
			end
		end)
		b.Holder.ZIndex = 52
		if q.Id == "High" then
			local tag = UI.new("Frame", { BackgroundColor3 = UI.Colors.Yellow, Size = UDim2.fromOffset(150, 28), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0, 0), ZIndex = 60, Parent = b.Holder })
			UI.Corner(tag, UDim.new(1, 0))
			UI.Stroke(tag, 2.5, UI.Ink, true)
			UI.Text(tag, "СОВЕТУЕМ", { Size = UDim2.new(1, -8, 1, -6), Position = UDim2.fromOffset(4, 3), MaxText = 18, ZIndex = 61 })
		end
	end
	sc.Scale = 0.7
	game:GetService("TweenService"):Create(sc, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	return overlay
end

return SettingsPanel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000048"><Properties><string name="Name">TutorialGuide</string><ProtectedString name="Source"><![CDATA[-- TutorialGuide: короткое обучение для новичков.
-- Карточка с подсказкой под верхней плашкой + анимированные стрелки:
--   • в интерфейсе — стрелка у нужной кнопки (рюкзак, «На базу», «Задания», «Питомцы»);
--   • в мире — большая стрелка над целью (шахта, продажа, магазин, яйцо) и светящийся луч от игрока.
-- Прогресс хранится на сервере (data.TutorialStep), поэтому после перезахода обучение продолжается с того же шага.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local Util = require(Shared:WaitForChild("Util"))
local Configs = ReplicatedStorage:WaitForChild("Configs")
local DrillsData = require(Configs:WaitForChild("DrillsData"))
local EggsData = require(Configs:WaitForChild("EggsData"))

local UI = require(script.Parent.UIKit)
local Icons2D = require(script.Parent.Icons2D)

local TutorialGuide = {}
local player = Players.LocalPlayer
local DONE = 99
local YELLOW = Color3.fromRGB(255, 214, 64)

local function priceOf(list, id)
	for _, it in ipairs(list) do
		if it.Id == id then
			return it.Price or 0
		end
	end
	return 0
end

function TutorialGuide.Build(hud, ctx, panels)
	local screen = hud.Screen
	local touch = UI.IsTouch()
	local CS = ctx.ClientState
		local eggPrice = priceOf(EggsData.List, "Dirt")

	local function stats(d)
		return d.Stats or {}
	end
	local function rootPart()
		local ch = player.Character
		return ch and ch:FindFirstChild("HumanoidRootPart")
	end
	local function worldPoint(name)
		local w = workspace:FindFirstChild("World")
		return w and w:GetAttribute(name)
	end

	-------------------------------------------------------------------------------- шаги
	local steps = {
		{
			Text = touch and "Подойди к шахте и зажми палец на блоке, чтобы бурить" or "Подойди к шахте и зажми ЛКМ на блоке, чтобы бурить",
			World = "TutShaft", Label = "БУРИ ЗДЕСЬ",
			Done = function(d)
				return (stats(d).BlocksBroken or 0) >= 8
			end,
		},
		{
			Text = "Рюкзак наполняется уроном, который ты наносишь блокам. Заполни его до конца!",
			Ui = function()
				return hud.Backpack
			end, Side = "right",
			Done = function(d)
				local cap = d.Derived and d.Derived.Capacity or 30
				return (d.Ore and d.Ore.Count or 0) >= math.min(cap, 180) or (stats(d).Sells or 0) >= 1
			end,
		},
		{
			Text = touch and "Рюкзак полон! Нажми «БАЗА» — телепорт мгновенный" or "Рюкзак полон! Нажми «НА БАЗУ» (или T) — телепорт мгновенный",
			Ui = function()
				return hud.Teleport and hud.Teleport.Holder
			end, Side = "left",
			Done = function(d)
				if (stats(d).Sells or 0) >= 1 then
					return true
				end
				local r, hub = rootPart(), worldPoint("TutHub")
				return r ~= nil and hub ~= nil and r.Position.Y > -3 and (r.Position - hub).Magnitude < 40
			end,
		},
		{
			Text = "Встань на светящийся круг Репликатора — руда продастся сама",
			World = "TutSell", Label = "ПРОДАЖА",
			Done = function(d)
				return (stats(d).Sells or 0) >= 1
			end,
		},
		{
			Text = "Открой «Задания»: за них дают монеты и бусты. Готовое — забирай!",
			Ui = function()
				return hud.MenuButtons.Quests and hud.MenuButtons.Quests.Holder
			end, Side = "left",
			Done = function()
				return panels.Quests and panels.Quests.IsOpen
			end,
		},
		{
			Text = "Открой Земляное яйцо — из него выпадет питомец, он усиливает бур",
			World = "TutEgg", Label = "ЯЙЦА",
			Extra = function(d)
				if (d.Coins or 0) < eggPrice then
					return "Нужно " .. Util.Format(eggPrice) .. " монет"
				end
			end,
			Done = function(d)
				return (stats(d).EggsOpened or 0) >= 1
			end,
		},
		{
			Text = "Открой «Питомцы» — лучшие питомцы экипируются и бурят вместе с тобой",
			Ui = function()
				return hud.MenuButtons.Pets and hud.MenuButtons.Pets.Holder
			end, Side = "left",
			Done = function()
				return panels.Pets and panels.Pets.IsOpen
			end,
		},
		{
			Text = "Зайди в дом «БУРЫ» — магазин откроется сам. Буры покупаются строго по порядку",
			World = "TutDrillShop", Label = "МАГАЗИН БУРОВ",
			Done = function(d)
				return (panels.Shop and panels.Shop.IsOpen) or Util.Count(d.OwnedDrills or {}) >= 2
			end,
		},
	}

	-------------------------------------------------------------------------------- карточка
	local W = touch and 430 or 500
	local card = UI.new("Frame", { Name = "TutorialCard", BackgroundColor3 = Color3.fromRGB(32, 26, 58), BackgroundTransparency = 0.06, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 66), Size = UDim2.fromOffset(W, 92), Visible = false, ZIndex = 20, Parent = screen })
	UI.Corner(card, 20)
	UI.Stroke(card, 3, UI.Ink, true)
	UI.Gradient(card, Color3.fromRGB(255, 255, 255), Color3.fromRGB(200, 196, 220))
	local cardScale = Instance.new("UIScale")
	cardScale.Parent = card
	local badge = UI.new("Frame", { BackgroundColor3 = UI.Colors.Orange, Size = UDim2.fromOffset(64, 64), Position = UDim2.fromOffset(14, 14), ZIndex = 21, Parent = card })
	UI.Corner(badge, UDim.new(1, 0))
	UI.Stroke(badge, 3, UI.Ink, true)
	UI.Gradient(badge, Color3.new(1, 1, 1), Color3.fromRGB(200, 200, 212))
	local bIcon = Icons2D.New(badge, "Quest", 44, { ZIndex = 22 })
	bIcon.AnchorPoint = Vector2.new(0.5, 0.5)
	bIcon.Position = UDim2.fromScale(0.5, 0.48)
	local stepLabel = UI.Text(card, "", { Size = UDim2.new(1, -210, 0, 20), Position = UDim2.fromOffset(90, 10), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = YELLOW, MaxText = 16, ZIndex = 21, StrokeThickness = 2 })
	local body = UI.Text(card, "", { Size = UDim2.new(1, -104, 0, 54), Position = UDim2.fromOffset(90, 30), TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true, MaxText = 19, ZIndex = 21, StrokeThickness = 2 })
	local skip = UI.Button({ Parent = card, Text = "Пропустить", Color = UI.Colors.Gray, Size = UDim2.fromOffset(110, 28), Position = UDim2.new(1, -120, 0, 8), TextSize = 14, Radius = 10 })
	skip.Holder.ZIndex = 22
	local okBtn = UI.Button({ Parent = card, Text = "ОК", Color = UI.Colors.Green, Size = UDim2.fromOffset(110, 28), Position = UDim2.new(1, -120, 0, 8), TextSize = 16, Radius = 10, Glyph = "Check" })
	okBtn.Holder.ZIndex = 22
	okBtn.Holder.Visible = false

	-------------------------------------------------------------------------------- стрелка в интерфейсе
	local uiArrow = UI.new("Frame", { Name = "TutorialArrow", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(70, 70), Visible = false, ZIndex = 30, Parent = screen })
	local arrowGlyph = Icons2D.New(uiArrow, "Arrow", 70, { Color = YELLOW, ZIndex = 31 })
	arrowGlyph.AnchorPoint = Vector2.new(0.5, 0.5)
	arrowGlyph.Position = UDim2.fromScale(0.5, 0.5)
	local ring = UI.new("Frame", { Name = "TutorialRing", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Visible = false, ZIndex = 29, Parent = screen })
	UI.Corner(ring, 22)
	local ringStroke = UI.Stroke(ring, 4, YELLOW, true)

	-------------------------------------------------------------------------------- стрелка в мире
	local anchor = Instance.new("Part")
	anchor.Name = "TutorialAnchor"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(1, 1, 1)
	anchor.CFrame = CFrame.new(0, -500, 0)
	anchor.Parent = workspace
	local att1 = Instance.new("Attachment")
	att1.Parent = anchor
	local bb = Instance.new("BillboardGui")
	bb.Name = "TutorialMarker"
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.Size = UDim2.fromOffset(150, 150)
	bb.StudsOffset = Vector3.new(0, 7, 0)
	bb.MaxDistance = 2000
	bb.Enabled = false
	bb.Adornee = anchor
	bb.Parent = screen.Parent and screen.Parent.Parent or player:WaitForChild("PlayerGui")
	local markLabel = UI.Text(bb, "", { Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 0), TextColor3 = YELLOW, MaxText = 26, StrokeThickness = 3 })
	local distLabel = UI.Text(bb, "", { Size = UDim2.new(1, 0, 0, 22), Position = UDim2.fromOffset(0, 28), MaxText = 18, StrokeThickness = 2 })
	local wGlyph = Icons2D.New(bb, "Arrow", 84, { Color = YELLOW })
	wGlyph.AnchorPoint = Vector2.new(0.5, 0)
	wGlyph.Position = UDim2.new(0.5, 0, 0, 54)
	local beam = Instance.new("Beam")
	beam.Name = "TutorialBeam"
	beam.Attachment1 = att1
	beam.Color = ColorSequence.new(YELLOW, Color3.fromRGB(255, 160, 40))
	beam.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.75), NumberSequenceKeypoint.new(0.15, 0.35), NumberSequenceKeypoint.new(1, 0.2) })
	beam.LightEmission = 1
	beam.LightInfluence = 0
	beam.FaceCamera = true
	beam.Width0 = 0.35
	beam.Width1 = 0.9
	beam.Segments = 1
	beam.Enabled = false
	beam.Parent = anchor
	local att0

	-------------------------------------------------------------------------------- логика
	local current = 0
	local finished = false
	local finalShown = false

	local function save(step)
		pcall(function()
			Net.Get("Tutorial"):FireServer(step)
		end)
	end

	local function hideArrows()
		uiArrow.Visible = false
		ring.Visible = false
		bb.Enabled = false
		beam.Enabled = false
	end

	local function finish(silent)
		finished = true
		hideArrows()
		card.Visible = false
		save(DONE)
		anchor.CFrame = CFrame.new(0, -500, 0)
		if not silent then
			ctx.Sound.Play("Unlock")
		end
		if ctx.AfterTutorial then
			task.delay(1, ctx.AfterTutorial)
		end
	end

	local function showStep(i)
		current = i
		local s = steps[i]
		stepLabel.Text = "ОБУЧЕНИЕ · ШАГ " .. i .. " / " .. #steps
		body.Text = s.Text
		card.Visible = true
		cardScale.Scale = 0.85
		TweenService:Create(cardScale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
		Icons2D.Bounce(bIcon, 1.25)
		if s.World then
			local p = worldPoint(s.World)
			if p then
				anchor.CFrame = CFrame.new(p)
			end
			markLabel.Text = s.Label or ""
		end
	end

	local function showFinal()
		finalShown = true
		current = #steps + 1
		hideArrows()
		stepLabel.Text = "ОБУЧЕНИЕ ПРОЙДЕНО!"
		body.Text = "Копи на буры и рюкзаки. Шлюз в новый ярус откроется на дне шахты, когда купишь Карьерный бур!"
		skip.Holder.Visible = false
		okBtn.Holder.Visible = true
		card.Visible = true
		UI.Pop(card)
		ctx.Sound.Play("Unlock")
		save(#steps)
		task.delay(10, function()
			if not finished then
				finish(true)
			end
		end)
	end

	skip.Activated:Connect(function()
		finish(true)
	end)
	okBtn.Activated:Connect(function()
		finish(true)
	end)

	local function evaluate()
		local d = CS.Data
		if finished or finalShown or not d then
			return
		end
		local i = current
		local advanced = false
		while i <= #steps and steps[i].Done(d) do
			i = i + 1
			advanced = true
		end
		if advanced then
			save(i - 1)
			ctx.Sound.Play("Coins", 0.05)
		end
		if i > #steps then
			showFinal()
		elseif i ~= current or not card.Visible then
			showStep(i)
		end
		local extra = steps[current] and steps[current].Extra and steps[current].Extra(d)
		if steps[current] then
			body.Text = steps[current].Text .. (extra and ("\n" .. extra) or "")
		end
	end

	-- позиционирование стрелок каждый кадр
	local function toLocal(v)
		local sc = screen:FindFirstChildOfClass("UIScale")
		local s = sc and sc.Scale or 1
		return (v - screen.AbsolutePosition) / s
	end
	local ROT = { above = 0, below = 180, left = -90, right = 90 }
	local DIR = { above = Vector2.new(0, -1), below = Vector2.new(0, 1), left = Vector2.new(-1, 0), right = Vector2.new(1, 0) }
	local clock = 0
	RunService.RenderStepped:Connect(function(dt)
		if finished or finalShown or current < 1 or current > #steps then
			return
		end
		clock = clock + dt
		local s = steps[current]
		local bob = math.abs(math.sin(clock * 4)) * 12
		if s.Ui then
			bb.Enabled = false
			beam.Enabled = false
			local target = s.Ui()
			if target and target.Parent and target.AbsoluteSize.X > 1 then
				local tl = toLocal(target.AbsolutePosition)
				local sc = screen:FindFirstChildOfClass("UIScale")
				local size = target.AbsoluteSize / (sc and sc.Scale or 1)
				local center = tl + size / 2
				local dir = DIR[s.Side] or DIR.above
				local off = (dir.X ~= 0) and (size.X / 2 + 44) or (size.Y / 2 + 44)
				local pos = center + dir * (off + bob)
				uiArrow.Position = UDim2.fromOffset(pos.X, pos.Y)
				uiArrow.Rotation = ROT[s.Side] or 0
				uiArrow.Visible = true
				ring.Position = UDim2.fromOffset(center.X, center.Y)
				local grow = 10 + math.abs(math.sin(clock * 4)) * 6
				ring.Size = UDim2.fromOffset(size.X + grow, size.Y + grow)
				ringStroke.Transparency = 0.15 + math.abs(math.sin(clock * 4)) * 0.4
				ring.Visible = true
			else
				uiArrow.Visible = false
				ring.Visible = false
			end
		elseif s.World then
			uiArrow.Visible = false
			ring.Visible = false
			local r = rootPart()
			bb.Enabled = true
			bb.StudsOffset = Vector3.new(0, 7 + bob * 0.12, 0)
			if r then
				if not att0 or att0.Parent ~= r then
					att0 = Instance.new("Attachment")
					att0.Name = "TutorialAtt"
					att0.Position = Vector3.new(0, -1.5, 0)
					att0.Parent = r
					beam.Attachment0 = att0
				end
				local dist = (r.Position - anchor.Position).Magnitude
				distLabel.Text = math.floor(dist) .. " м"
				-- рядом с целью луч не нужен
				beam.Enabled = dist > 14
			else
				beam.Enabled = false
			end
		end
	end)

	task.spawn(function()
		CS.Wait()
		local d = CS.Data
		local saved = d and d.TutorialStep or 0
		if saved >= DONE then
			finished = true
			return
		end
		if saved >= #steps then
			finish(true)
			return
		end
		current = saved + 1
		-- сначала игрок выбирает качество графики
		while ctx.GraphicsChosen == false do
			task.wait(0.25)
		end
		task.wait(1.2)
		evaluate()
		CS.Changed:Connect(evaluate)
		while not finished and not finalShown do
			task.wait(0.5)
			evaluate()
		end
	end)

	TutorialGuide.IsActive = function()
		return not finished
	end
	return TutorialGuide
end

return TutorialGuide
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000049"><Properties><string name="Name">UIKit</string><ProtectedString name="Source"><![CDATA[-- UIKit: мультяшный векторный UI (ТЗ 9.2).
-- Толстые тёмные рамки (UIStroke 3px), объёмные плашки с тенью вниз, FredokaOne,
-- hover: Scale 1.05 за 0.1 с (Quad), click: 0.95 + щелчок.
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Lighting = game:GetService("Lighting")

local UI = {}

UI.Font = Enum.Font.FredokaOne
-- Основной шрифт — Nunito (жирный, округлый, с кириллицей). У FredokaOne нет русских букв, и Roblox
-- подставлял случайный запасной шрифт. Все тексты с Font = FredokaOne автоматически получают Nunito.
UI.FontFamily = "rbxasset://fonts/families/Nunito.json"
function UI.FontFace(weight)
	local ok, f = pcall(function()
		return Font.new(UI.FontFamily, weight or Enum.FontWeight.Heavy)
	end)
	return ok and f or nil
end
local HEAVY = UI.FontFace(Enum.FontWeight.Heavy)
UI.Ink = Color3.fromRGB(28, 22, 44)
UI.Colors = {
	Panel = Color3.fromRGB(250, 247, 255),
	Panel2 = Color3.fromRGB(234, 229, 250),
	Panel3 = Color3.fromRGB(214, 207, 238),
	Green = Color3.fromRGB(88, 214, 96),
	Blue = Color3.fromRGB(70, 160, 255),
	Yellow = Color3.fromRGB(255, 198, 48),
	Red = Color3.fromRGB(255, 86, 86),
	Purple = Color3.fromRGB(164, 96, 255),
	Orange = Color3.fromRGB(255, 146, 46),
	Teal = Color3.fromRGB(50, 210, 196),
	Pink = Color3.fromRGB(255, 110, 170),
	Gray = Color3.fromRGB(150, 148, 170),
	Dark = Color3.fromRGB(52, 46, 74),
	White = Color3.fromRGB(255, 255, 255),
}

local clickSound

function UI.SetClickSound(fn)
	clickSound = fn
end

function UI.new(class, props, children)
	local inst = Instance.new(class)
	local parent
	if props then
		for k, v in pairs(props) do
			if k == "Parent" then
				parent = v
			else
				inst[k] = v
			end
		end
	end
	if inst:IsA("GuiObject") and (not props or props.BorderSizePixel == nil) then
		inst.BorderSizePixel = 0
	end
	if HEAVY and (class == "TextLabel" or class == "TextButton" or class == "TextBox") and inst.Font == UI.Font and not (props and props.FontFace) then
		inst.FontFace = HEAVY
	end
	if children then
		for _, c in ipairs(children) do
			c.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function UI.Corner(inst, r)
	local c = Instance.new("UICorner")
	if type(r) == "number" then
		c.CornerRadius = UDim.new(0, r)
	else
		c.CornerRadius = r or UDim.new(0, 12)
	end
	c.Parent = inst
	return c
end

function UI.Stroke(inst, thickness, color, border)
	local s = Instance.new("UIStroke")
	s.Thickness = thickness or 3
	s.Color = color or UI.Ink
	s.LineJoinMode = Enum.LineJoinMode.Round
	if border then
		s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	end
	s.Parent = inst
	return s
end

-- Градиент. Серые стопы (белый→серый) «затеняют» цвет фона (UIGradient умножается на него);
-- цветные стопы — это и есть цвета, поэтому фон делаем белым, чтобы цвет не «темнел» от умножения.
local function sat(c)
	local mx, mn = math.max(c.R, c.G, c.B), math.min(c.R, c.G, c.B)
	return mx > 0 and (mx - mn) / mx or 0
end
function UI.Gradient(inst, top, bottom, rot)
	top = top or Color3.new(1, 1, 1)
	bottom = bottom or Color3.fromRGB(205, 205, 215)
	if (sat(top) > 0.12 or sat(bottom) > 0.12) and inst:IsA("GuiObject") then
		inst.BackgroundColor3 = Color3.new(1, 1, 1)
	end
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(top or Color3.new(1, 1, 1), bottom or Color3.fromRGB(205, 205, 215))
	g.Rotation = rot or 90
	g.Parent = inst
	return g
end

function UI.Padding(inst, px)
	local p = Instance.new("UIPadding")
	p.PaddingLeft = UDim.new(0, px)
	p.PaddingRight = UDim.new(0, px)
	p.PaddingTop = UDim.new(0, px)
	p.PaddingBottom = UDim.new(0, px)
	p.Parent = inst
	return p
end

function UI.List(inst, padding, dir, halign, valign)
	local l = Instance.new("UIListLayout")
	l.Padding = UDim.new(0, padding or 6)
	l.FillDirection = dir or Enum.FillDirection.Vertical
	l.SortOrder = Enum.SortOrder.LayoutOrder
	if halign then
		l.HorizontalAlignment = halign
	end
	if valign then
		l.VerticalAlignment = valign
	end
	l.Parent = inst
	return l
end

function UI.Darker(c, f)
	return c:Lerp(Color3.new(0, 0, 0), f or 0.28)
end

function UI.Lighter(c, f)
	return c:Lerp(Color3.new(1, 1, 1), f or 0.3)
end

-- «Леденцовый» градиент: светлый верх -> чистый цвет -> чуть темнее низ. Цвет задаётся самим градиентом,
-- поэтому фон объекта должен быть белым (UIGradient умножается на фон).
function UI.CandySeq(c)
	return ColorSequence.new({
		ColorSequenceKeypoint.new(0, UI.Lighter(c, 0.3)),
		ColorSequenceKeypoint.new(0.5, c),
		ColorSequenceKeypoint.new(1, UI.Darker(c, 0.12)),
	})
end
function UI.Candy(inst, c, rot)
	if inst:IsA("GuiObject") then
		inst.BackgroundColor3 = Color3.new(1, 1, 1)
	end
	local g = Instance.new("UIGradient")
	g.Color = UI.CandySeq(c)
	g.Rotation = rot or 90
	g.Parent = inst
	return g
end

-- «Стекло»: тёмная полупрозрачная плашка с мягким градиентом и тонкой светлой кромкой (HUD 3.0)
UI.GlassColor = Color3.fromRGB(24, 20, 52)
function UI.Glass(inst, radius, transparency)
	inst.BackgroundColor3 = Color3.new(1, 1, 1)
	inst.BackgroundTransparency = transparency or 0.18
	if radius then
		UI.Corner(inst, radius)
	end
	local g = Instance.new("UIGradient")
	g.Rotation = 90
	g.Color = ColorSequence.new(Color3.fromRGB(46, 40, 92), Color3.fromRGB(18, 15, 40))
	g.Parent = inst
	local s = UI.Stroke(inst, 2, Color3.new(1, 1, 1), true)
	s.Transparency = 0.78
	return s, g
end

-- Мягкий глянец: белая полоса сверху, которая плавно растворяется книзу
function UI.Gloss(parent, size, pos, alpha, z)
	local f = UI.new("Frame", {
		Name = "Gloss",
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0,
		Size = size,
		Position = pos,
		ZIndex = z or parent.ZIndex,
		Parent = parent,
	})
	UI.Corner(f, UDim.new(1, 0))
	local g = Instance.new("UIGradient")
	g.Rotation = 90
	g.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, alpha or 0.45),
		NumberSequenceKeypoint.new(1, 1),
	})
	g.Parent = f
	return f
end

-- Текст с обводкой
function UI.Text(parent, text, props)
	local l = UI.new("TextLabel", {
		BackgroundTransparency = 1,
		Font = UI.Font,
		Text = text or "",
		TextColor3 = UI.Colors.White,
		TextScaled = true,
		Size = UDim2.fromScale(1, 1),
		Parent = parent,
	})
	if props then
		for k, v in pairs(props) do
			if k ~= "Stroke" and k ~= "MaxText" and k ~= "StrokeThickness" then
				l[k] = v
			end
		end
	end
	local sc = Instance.new("UITextSizeConstraint")
	sc.MaxTextSize = (props and props.MaxText) or 40
	sc.Parent = l
	if not props or props.Stroke ~= false then
		local s = UI.Stroke(l, (props and props.StrokeThickness) or 2.5, UI.Ink)
		s.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	end
	return l
end

-- Hover / click поведение для любого GuiButton
function UI.Bounce(button, scaleTarget, face)
	local scale = Instance.new("UIScale")
	scale.Parent = scaleTarget or button
	local hover = false
	local pressed = false
	local function go(s, t)
		TweenService:Create(scale, TweenInfo.new(t or 0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = s }):Play()
	end
	button.MouseEnter:Connect(function()
		hover = true
		if not pressed then
			go(1.05)
		end
	end)
	button.MouseLeave:Connect(function()
		hover = false
		pressed = false
		go(1)
		if face then
			face.Position = UDim2.new(0, 0, 0, 0)
		end
	end)
	button.MouseButton1Down:Connect(function()
		pressed = true
		go(0.95, 0.06)
		if face then
			face.Position = UDim2.new(0, 0, 0, 3)
		end
	end)
	button.MouseButton1Up:Connect(function()
		pressed = false
		go(hover and 1.05 or 1)
		if face then
			face.Position = UDim2.new(0, 0, 0, 0)
		end
	end)
	button.Activated:Connect(function()
		if clickSound then
			clickSound()
		end
	end)
	return scale
end

-- Объёмная кнопка в стиле HUD: насыщенный градиент, обводка темнее своего цвета, блик и «ступенька» снизу
-- opts: Text, Color, Size, Position, AnchorPoint, Parent, TextSize, Glyph, GlyphColor, Icon, LayoutOrder, Radius
local function edge(c)
	return UI.Darker(c, 0.5)
end
UI.Edge = edge

function UI.Button(opts)
	local color = opts.Color or UI.Colors.Green
	local radius = opts.Radius or 14
	local holder = UI.new("Frame", {
		Name = opts.Name or "Button",
		BackgroundTransparency = 1,
		Size = opts.Size or UDim2.fromOffset(160, 52),
		Position = opts.Position or UDim2.new(),
		AnchorPoint = opts.AnchorPoint or Vector2.new(),
		LayoutOrder = opts.LayoutOrder or 0,
		Parent = opts.Parent,
	})
	local shadow = UI.new("Frame", {
		Name = "Shadow",
		BackgroundColor3 = UI.Darker(color, 0.35),
		Size = UDim2.fromScale(1, 1),
		Position = UDim2.fromOffset(0, 4),
		Parent = holder,
	})
	UI.Corner(shadow, radius)
	local shadowStroke = UI.Stroke(shadow, 3, edge(color), true)
	local faceHolder = UI.new("Frame", {
		Name = "FaceHolder",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Parent = holder,
	})
	local face = UI.new("TextButton", {
		Name = "Face",
		AutoButtonColor = false,
		BackgroundColor3 = color,
		Size = UDim2.fromScale(1, 1),
		Text = "",
		Parent = faceHolder,
	})
	UI.Corner(face, radius)
	local faceStroke = UI.Stroke(face, 3, edge(color), true)
	local faceGrad = UI.Candy(face, color)
	-- мягкий глянец сверху
	UI.Gloss(face, UDim2.new(1, -12, 0.42, 0), UDim2.new(0, 6, 0, 3), 0.38)
	local label
	local iconFrame
	if opts.Glyph then
		local h = (opts.Size and opts.Size.Y.Offset) or 52
		local gs = math.floor(h * (opts.Text and 0.66 or 0.72))
		iconFrame = require(script.Parent.Icons2D).New(face, opts.Glyph, gs, { Color = opts.GlyphColor, Ink = edge(color) })
		if opts.Text then
			iconFrame.AnchorPoint = Vector2.new(0, 0.5)
			iconFrame.Position = UDim2.new(0, 8, 0.5, -2)
		else
			iconFrame.AnchorPoint = Vector2.new(0.5, 0.5)
			iconFrame.Position = UDim2.new(0.5, 0, 0.5, -2)
		end
	elseif opts.Icon then
		iconFrame = opts.Icon(face)
		iconFrame.AnchorPoint = Vector2.new(0, 0.5)
		iconFrame.Position = UDim2.new(0, 8, 0.5, 0)
	end
	local labelStroke
	if opts.Text then
		local iw = iconFrame and (iconFrame.Size.X.Offset + 8) or 0
		label = UI.Text(face, opts.Text, {
			Size = UDim2.new(1, iconFrame and -(iw + 10) or -12, 1, -10),
			Position = UDim2.new(0, iconFrame and (iw + 4) or 6, 0, 5),
			MaxText = opts.TextSize or 26,
			TextXAlignment = opts.TextXAlignment or Enum.TextXAlignment.Center,
		})
		labelStroke = label:FindFirstChildOfClass("UIStroke")
		if labelStroke then
			labelStroke.Color = edge(color)
		end
	end
	UI.Bounce(face, holder, faceHolder)
	local obj = { Holder = holder, Face = face, Label = label, Shadow = shadow, Activated = face.Activated, Color = color, Glyph = iconFrame }
	local function paint(c)
		faceGrad.Color = UI.CandySeq(c)
		shadow.BackgroundColor3 = UI.Darker(c, 0.35)
		faceStroke.Color = edge(c)
		shadowStroke.Color = edge(c)
		if labelStroke then
			labelStroke.Color = edge(c)
		end
	end
	function obj.SetText(t)
		if label then
			label.Text = t
		end
	end
	function obj.SetColor(c)
		obj.Color = c
		paint(c)
	end
	function obj.SetEnabled(on)
		obj.Enabled = on
		face.Active = on
		face.AutoButtonColor = false
		-- серые кнопки действительно не нажимаются
		pcall(function()
			face.Interactable = on
		end)
		paint(on and obj.Color or UI.Colors.Gray)
	end
	return obj
end

-- Плашка с тенью (без нажатия): обводка — темнее своего цвета
function UI.Plate(parent, size, pos, color, radius)
	local holder = UI.new("Frame", { BackgroundTransparency = 1, Size = size, Position = pos or UDim2.new(), Parent = parent })
	local shadow = UI.new("Frame", { BackgroundColor3 = UI.Darker(color, 0.4), BackgroundTransparency = 0.2, Size = UDim2.fromScale(1, 1), Position = UDim2.fromOffset(0, 4), Parent = holder })
	UI.Corner(shadow, radius or 14)
	local face = UI.new("Frame", { BackgroundColor3 = color, Size = UDim2.fromScale(1, 1), Parent = holder })
	UI.Corner(face, radius or 14)
	UI.Stroke(face, 3, edge(color), true)
	return holder, face
end

-- Полоса прогресса
function UI.Bar(parent, size, pos, color, bg)
	local frame = UI.new("Frame", {
		BackgroundColor3 = bg or UI.Colors.Dark,
		Size = size,
		Position = pos or UDim2.new(),
		Parent = parent,
		ClipsDescendants = false,
	})
	UI.Corner(frame, UDim.new(1, 0))
	UI.Stroke(frame, 3, UI.Darker(bg or UI.Colors.Dark, 0.4), true)
	local fill = UI.new("Frame", {
		BackgroundColor3 = color or UI.Colors.Green,
		Size = UDim2.fromScale(0, 1),
		Parent = frame,
	})
	UI.Corner(fill, UDim.new(1, 0))
	UI.Gradient(fill, Color3.new(1, 1, 1), Color3.fromRGB(200, 200, 210))
	local shine = UI.new("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.7,
		Size = UDim2.new(1, -8, 0.3, 0),
		Position = UDim2.new(0, 4, 0, 3),
		Parent = fill,
	})
	UI.Corner(shine, UDim.new(1, 0))
	local label = UI.Text(frame, "", { ZIndex = 3, Size = UDim2.new(1, -10, 1, -6), Position = UDim2.fromOffset(5, 3), MaxText = 22 })
	local obj = { Frame = frame, Fill = fill, Label = label }
	local last = -1
	function obj.Set(frac, text, instant)
		frac = math.clamp(frac or 0, 0, 1)
		if text then
			label.Text = text
		end
		if frac ~= last then
			last = frac
			local target = UDim2.fromScale(frac < 0.001 and 0 or math.max(frac, 0.06), 1)
			if instant then
				fill.Size = target
			else
				TweenService:Create(fill, TweenInfo.new(0.2, Enum.EasingStyle.Quad), { Size = target }):Play()
			end
		end
	end
	return obj
end

-- Окно-панель в стиле HUD: белое тело с лёгким оттенком цвета окна, сочная шапка-градиент,
-- значок в белом кружке слева и круглый красный крестик, вынесенный за угол.
local WINDOW_ICONS = {
	Pets = "Paw", Bag = "Chest", Shop = "ShopBag", Incubator = "Sprout", Rebirth = "Hourglass", Worlds = "Globe",
	Npc = "Quest", Egg = "Egg", Daily = "Gift", Wheel = "Wheel", Stats = "Stats", Quests = "Quest", Donate = "Diamond",
}
UI.HeaderHeight = 62

-- Фон за открытым окном: мир мягко размывается и чуть темнеет, интерфейс остаётся чётким.
-- Окна считаются по множеству, поэтому два окна подряд не «мигают» размытием.
UI.BackdropEnabled = true
local openWindows = {}
local backdropBlur, backdropGrade
local function backdropTarget()
	for w in pairs(openWindows) do
		if w.Root and w.Root.Parent then
			return true
		end
		openWindows[w] = nil
	end
	return false
end
function UI.SetBackdrop(win, open)
	openWindows[win] = open or nil
	local on = UI.BackdropEnabled and backdropTarget()
	if not backdropBlur or not backdropBlur.Parent then
		backdropBlur = Instance.new("BlurEffect")
		backdropBlur.Name = "UIBackdropBlur"
		backdropBlur.Size = 0
		backdropBlur.Parent = Lighting
	end
	if not backdropGrade or not backdropGrade.Parent then
		backdropGrade = Instance.new("ColorCorrectionEffect")
		backdropGrade.Name = "UIBackdropGrade"
		backdropGrade.Parent = Lighting
	end
	local info = TweenInfo.new(on and 0.25 or 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(backdropBlur, info, { Size = on and 14 or 0 }):Play()
	TweenService:Create(backdropGrade, info, { Brightness = on and -0.06 or 0, Saturation = on and -0.12 or 0 }):Play()
end
function UI.Window(screen, opts)
	local base = opts.Size or UDim2.fromOffset(720, 480)
	local HEAD = UI.HeaderHeight
	local size = UDim2.new(base.X.Scale, base.X.Offset, base.Y.Scale, base.Y.Offset + 28)
	local color = opts.Color or UI.Colors.Blue
	local dark = edge(color)
	local root = UI.new("Frame", {
		Name = opts.Name or "Window",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = size,
		Visible = false,
		ZIndex = 10,
		Parent = screen,
	})
	local scale = Instance.new("UIScale")
	scale.Parent = root
	-- мягкая тень под окном
	local shadow = UI.new("Frame", { Name = "Shadow", BackgroundColor3 = Color3.fromRGB(12, 8, 30), BackgroundTransparency = 0.72, Size = UDim2.new(1, 6, 1, 6), Position = UDim2.fromOffset(-3, 8), Parent = root })
	UI.Corner(shadow, 32)
	-- тело: чистый светлый градиент с лёгким оттенком цвета окна, тонкая тёмная обводка
	local body = UI.new("Frame", { Name = "Body", BackgroundColor3 = Color3.new(1, 1, 1), Size = UDim2.fromScale(1, 1), Parent = root })
	UI.Corner(body, 28)
	UI.Stroke(body, 3.5, UI.Darker(color, 0.62), true)
	UI.Gradient(body, Color3.fromRGB(252, 252, 255), UI.Lighter(color, 0.9):Lerp(Color3.fromRGB(236, 238, 248), 0.5))
	-- шапка
	local header = UI.new("Frame", { Name = "Header", BackgroundColor3 = color, Size = UDim2.new(1, 0, 0, HEAD), ZIndex = 2, Parent = body })
	UI.Corner(header, 28)
	local headTop, headBottom = UI.Lighter(color, 0.3), UI.Darker(color, 0.08)
	UI.Gradient(header, headTop, headBottom)
	header.BackgroundColor3 = Color3.new(1, 1, 1) -- цвет целиком в градиенте (даже у почти серых окон)
	-- квадратный низ шапки (под скруглением) в тех же цветах градиента
	local patch = UI.new("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), Size = UDim2.new(1, 0, 0, 28), Position = UDim2.new(0, 0, 1, -28), ZIndex = 2, Parent = header })
	local pg = Instance.new("UIGradient")
	pg.Rotation = 90
	pg.Color = ColorSequence.new(headTop:Lerp(headBottom, (HEAD - 28) / HEAD), headBottom)
	pg.Parent = patch
	UI.new("Frame", { Name = "HeaderLine", BackgroundColor3 = UI.Darker(color, 0.25), Size = UDim2.new(1, 0, 0, 3), Position = UDim2.new(0, 0, 1, -1), ZIndex = 4, Parent = header })
	UI.Gloss(header, UDim2.new(1, -150, 0, 24), UDim2.fromOffset(84, 4), 0.42, 3)
	-- большая иконка «выходит» за левый верхний угол окна
	local iconName = opts.Icon or WINDOW_ICONS[opts.Name or ""] or "Star"
	local Icons2D = require(script.Parent.Icons2D)
	local glyph = Icons2D.New(root, iconName, 70, { ZIndex = 14, Color = Icons2D.HasImage(iconName) and nil or Color3.new(1, 1, 1), Ink = dark })
	glyph.AnchorPoint = Vector2.new(0.5, 0.5)
	glyph.Position = UDim2.fromOffset(36, 22)
	local title = UI.Text(header, opts.Title or "", { Size = UDim2.new(1, -170, 0, 40), Position = UDim2.fromOffset(84, 11), MaxText = 34, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5, StrokeThickness = 3 })
	local ts = title:FindFirstChildOfClass("UIStroke")
	if ts then
		ts.Color = UI.Darker(color, 0.55)
	end
	-- крестик — скруглённый квадрат внутри шапки
	local close = UI.Button({ Parent = root, Glyph = "Close", Color = UI.Colors.Red, Size = UDim2.fromOffset(48, 48), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 6), Radius = 16 })
	close.Holder.ZIndex = 12
	local content = UI.new("Frame", { Name = "Content", BackgroundTransparency = 1, Size = UDim2.new(1, -36, 1, -(HEAD + 30)), Position = UDim2.fromOffset(18, HEAD + 14), ZIndex = 2, Parent = body })
	local win = { Root = root, Content = content, Title = title, Close = close, IsOpen = false, Color = color }
	local openedEvent = Instance.new("BindableEvent")
	win.Opened = openedEvent.Event
	function win.Open()
		if win.IsOpen then
			return
		end
		win.IsOpen = true
		root.Visible = true
		scale.Scale = 0.78
		TweenService:Create(scale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
		if not opts.NoBackdrop then
			UI.SetBackdrop(win, true)
		end
		openedEvent:Fire()
	end
	function win.Hide()
		if not win.IsOpen then
			return
		end
		win.IsOpen = false
		if not opts.NoBackdrop then
			UI.SetBackdrop(win, false)
		end
		local tw = TweenService:Create(scale, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Scale = 0.7 })
		tw:Play()
		tw.Completed:Connect(function()
			if not win.IsOpen then
				root.Visible = false
			end
		end)
	end
	function win.Toggle()
		if win.IsOpen then
			win.Hide()
		else
			win.Open()
		end
	end
	close.Activated:Connect(win.Hide)
	return win
end

-- Вкладки: сегментированная «таблетка» — выбранная вкладка цветная, остальные светлые
function UI.Tabs(parent, names, colors, onSelect)
	local w = #names * 154 + 8
	local bar = UI.new("Frame", { BackgroundColor3 = Color3.fromRGB(232, 230, 244), Size = UDim2.fromOffset(w, 48), Parent = parent })
	UI.Corner(bar, UDim.new(1, 0))
	UI.Stroke(bar, 3, Color3.fromRGB(190, 186, 214), true)
	local inner = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -8, 1, -8), Position = UDim2.fromOffset(4, 2), Parent = bar })
	UI.List(inner, 4, Enum.FillDirection.Horizontal, nil, Enum.VerticalAlignment.Center)
	local buttons = {}
	local tabs = { Buttons = buttons, Current = nil }
	local idle = Color3.fromRGB(176, 172, 200)
	function tabs.Select(i)
		tabs.Current = i
		for k, b in ipairs(buttons) do
			b.SetColor(k == i and (colors[k] or UI.Colors.Blue) or idle)
		end
		onSelect(i)
	end
	for i, n in ipairs(names) do
		local b = UI.Button({ Parent = inner, Text = n, Color = idle, Size = UDim2.fromOffset(150, 36), LayoutOrder = i, TextSize = 21, Radius = 18 })
		b.Activated:Connect(function()
			tabs.Select(i)
		end)
		buttons[i] = b
	end
	return tabs, bar
end

-- Скролл-контейнер
function UI.Scroll(parent, size, pos)
	local s = UI.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		Size = size,
		Position = pos or UDim2.new(),
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = UI.Ink,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = parent,
	})
	return s
end

-- Модель в ViewportFrame с автокадрированием
function UI.Viewport(parent, model, size, pos, spin)
	local vp = UI.new("ViewportFrame", {
		BackgroundTransparency = 1,
		Size = size or UDim2.fromScale(1, 1),
		Position = pos or UDim2.new(),
		Ambient = Color3.fromRGB(170, 170, 185),
		LightColor = Color3.fromRGB(255, 250, 240),
		LightDirection = Vector3.new(-0.4, -1, -0.6),
		Parent = parent,
	})
	local cam = Instance.new("Camera")
	cam.FieldOfView = 30
	cam.Parent = vp
	vp.CurrentCamera = cam
	if model then
		model.Parent = vp
		local cf, sz = model:GetBoundingBox()
		local radius = math.max(sz.X, sz.Y, sz.Z) * 0.62
		local dist = radius / math.tan(math.rad(15)) * 1.05
		local dir = Vector3.new(0.35, 0.28, -1).Unit
		cam.CFrame = CFrame.lookAt(cf.Position + dir * dist, cf.Position)
	end
	return vp, cam
end

function UI.Pop(inst, from)
	local scale = inst:FindFirstChildOfClass("UIScale") or Instance.new("UIScale", inst)
	scale.Scale = from or 0.5
	TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

function UI.IsTouch()
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

return UI
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX0000000000000000000000000000004C"><Properties><string name="Name">Visuals</string></Properties><Item class="ModuleScript" referent="RBX0000000000000000000000000000004B"><Properties><string name="Name">BlockBreakVFX</string><ProtectedString name="Source"><![CDATA[-- BlockBreakVFX: процедурные эффекты бурения.
--  * искры на каждом ударе, золотые искры и тряска камеры на крите
--  * всплывающие цифры урона с пружинкой (крит — золотой градиент и наклон)
--  * самоцвет руды летит в рюкзак со светящимся шлейфом
--  * Squash & Stretch блока: Y -15%, X/Z +10%, возврат за 0.08 с
--  * 4-6 кубических low-poly осколков + облачко пыли
--  * руда летит в рюкзак, всплывающие цифры урона
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local Debris = game:GetService("Debris")

local VFX = {}
local fxFolder
local squashing = {}
local BASE = Vector3.new(4, 4, 4)

local function fx()
	if not fxFolder or not fxFolder.Parent then
		fxFolder = Instance.new("Folder")
		fxFolder.Name = "ClientFX"
		fxFolder.Parent = workspace
	end
	return fxFolder
end

function VFX.Squash(part)
	if not part or not part.Parent or squashing[part] then
		return
	end
	local home = part:GetAttribute("Home")
	if typeof(home) ~= "Vector3" then
		return
	end
	squashing[part] = true
	local orig = CFrame.new(home)
	local squash = Vector3.new(BASE.X * 1.1, BASE.Y * 0.85, BASE.Z * 1.1)
	local down = orig * CFrame.new(0, -BASE.Y * 0.075, 0)
	local t1 = TweenService:Create(part, TweenInfo.new(0.04, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = squash, CFrame = down })
	local t2
	local conn
	local function finish()
		if conn then
			conn:Disconnect()
			conn = nil
		end
		squashing[part] = nil
	end
	-- сервер переиспользует детали из пула: если блок "переехал", сразу возвращаем его на новое место
	conn = part:GetAttributeChangedSignal("Home"):Connect(function()
		t1:Cancel()
		if t2 then
			t2:Cancel()
		end
		local h = part:GetAttribute("Home")
		if typeof(h) == "Vector3" then
			part.CFrame = CFrame.new(h)
		end
		part.Size = BASE
		finish()
	end)
	t1:Play()
	t1.Completed:Connect(function(state)
		if state ~= Enum.PlaybackState.Completed or not squashing[part] then
			return
		end
		t2 = TweenService:Create(part, TweenInfo.new(0.08, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = BASE, CFrame = orig })
		t2:Play()
		t2.Completed:Connect(finish)
	end)
end

local function puff(pos, color, count, size)
	local a = Instance.new("Part")
	a.Anchored = true
	a.CanCollide = false
	a.CanQuery = false
	a.CanTouch = false
	a.Transparency = 1
	a.Size = Vector3.new(0.2, 0.2, 0.2)
	a.CFrame = CFrame.new(pos)
	a.Parent = fx()
	local e = Instance.new("ParticleEmitter")
	e.Texture = "rbxasset://textures/particles/smoke_main.dds"
	e.Color = ColorSequence.new(color:Lerp(Color3.new(1, 1, 1), 0.35))
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size * 0.6), NumberSequenceKeypoint.new(1, size * 1.6) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) })
	e.Lifetime = NumberRange.new(0.45, 0.8)
	e.Speed = NumberRange.new(4, 9)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Drag = 6
	e.Rate = 0
	e.LightInfluence = 1
	e.Parent = a
	e:Emit(count)
	Debris:AddItem(a, 1.2)
end

function VFX.Sparkle(pos, color, count)
	local a = Instance.new("Part")
	a.Anchored = true
	a.CanCollide = false
	a.CanQuery = false
	a.CanTouch = false
	a.Transparency = 1
	a.Size = Vector3.new(0.2, 0.2, 0.2)
	a.CFrame = CFrame.new(pos)
	a.Parent = fx()
	local e = Instance.new("ParticleEmitter")
	e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	e.Color = ColorSequence.new(color)
	e.LightEmission = 1
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) })
	e.Lifetime = NumberRange.new(0.4, 0.7)
	e.Speed = NumberRange.new(8, 16)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Drag = 4
	e.Rate = 0
	e.Parent = a
	e:Emit(count or 12)
	Debris:AddItem(a, 1)
end

function VFX.HitSpark(pos, color, crit)
	puff(pos, color, crit and 6 or 3, 0.7)
	if crit then
		VFX.Sparkle(pos, Color3.fromRGB(255, 200, 60), 14)
	else
		VFX.Sparkle(pos, color:Lerp(Color3.new(1, 1, 1), 0.5), 3)
	end
end

local function quality()
	local ok, Detail = pcall(function()
		return require(script.Parent.Parent.Controllers.DetailController)
	end)
	return ok and Detail.Quality and Detail.Quality() or "Medium"
end

-- мягкое светящееся кольцо и вспышка света на месте сломанного блока
local function ring(pos, color)
	local r = Instance.new("Part")
	r.Shape = Enum.PartType.Cylinder
	r.Anchored = true
	r.CanCollide = false
	r.CanQuery = false
	r.CanTouch = false
	r.CastShadow = false
	r.Material = Enum.Material.Neon
	r.Color = color:Lerp(Color3.new(1, 1, 1), 0.55)
	r.Transparency = 0.35
	r.Size = Vector3.new(0.15, 1.5, 1.5)
	r.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90))
	r.Parent = fx()
	local light = Instance.new("PointLight")
	light.Color = r.Color
	light.Range = 10
	light.Brightness = 2
	light.Parent = r
	TweenService:Create(r, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.new(0.08, 7, 7), Transparency = 1 }):Play()
	TweenService:Create(light, TweenInfo.new(0.35), { Brightness = 0 }):Play()
	Debris:AddItem(r, 0.4)
end

local liveShards = 0
function VFX.Break(pos, color, vein, glass)
	local q = quality()
	local n = q == "High" and math.random(6, 9) or (q == "Low" and 2 or math.random(4, 6))
	if liveShards > 70 then
		n = 2
	end
	if q ~= "Low" then
		ring(pos, color)
		VFX.Sparkle(pos, color:Lerp(Color3.new(1, 1, 1), 0.6), q == "High" and 8 or 4)
	end
	for i = 1, n do
		local s = Instance.new("Part")
		local size = 0.55 + math.random() * 0.55
		s.Size = Vector3.new(size, size, size)
		s.CFrame = CFrame.new(pos + Vector3.new(math.random() * 2 - 1, math.random() * 1.5, math.random() * 2 - 1)) * CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6)
		local c = color:Lerp((i % 2 == 0) and Color3.new(1, 1, 1) or Color3.new(0, 0, 0), 0.1 + math.random() * 0.1)
		s.Color = c
		s.Material = glass and Enum.Material.Glass or Enum.Material.SmoothPlastic
		s.Transparency = glass and 0.2 or 0
		s.TopSurface = Enum.SurfaceType.Smooth
		s.BottomSurface = Enum.SurfaceType.Smooth
		s.CanCollide = true
		s.CanQuery = false
		s.CanTouch = false
		s.CastShadow = false
		s.CollisionGroup = "Debris"
		s.Parent = fx()
		s.AssemblyLinearVelocity = Vector3.new(math.random() * 18 - 9, 14 + math.random() * 10, math.random() * 18 - 9)
		s.AssemblyAngularVelocity = Vector3.new(math.random() * 20 - 10, math.random() * 20 - 10, math.random() * 20 - 10)
		liveShards = liveShards + 1
		task.delay(0.55 + math.random() * 0.3, function()
			local tw = TweenService:Create(s, TweenInfo.new(0.3, Enum.EasingStyle.Quad), { Size = Vector3.new(0.05, 0.05, 0.05), Transparency = 1 })
			tw:Play()
			tw.Completed:Connect(function()
				s:Destroy()
				liveShards = liveShards - 1
			end)
		end)
	end
	puff(pos, color, 10, 1.4)
	if vein then
		VFX.Sparkle(pos, Color3.fromRGB(255, 230, 120), 24)
	end
end

-- Самоцвет руды летит по дуге к рюкзаку игрока
function VFX.OreFly(pos, color, character)
	local target = character and (character:FindFirstChild("EquippedPack") or character:FindFirstChild("UpperTorso") or character:FindFirstChild("HumanoidRootPart"))
	if not target then
		return
	end
	local gem = Instance.new("Part")
	gem.Size = Vector3.new(0.7, 0.7, 0.7)
	gem.Material = Enum.Material.Neon
	gem.Color = color:Lerp(Color3.new(1, 1, 1), 0.25)
	gem.Anchored = true
	gem.CanCollide = false
	gem.CanQuery = false
	gem.CanTouch = false
	gem.CastShadow = false
	gem.CFrame = CFrame.new(pos)
	gem.Parent = fx()
	-- светящийся шлейф за самоцветом
	pcall(function()
		local a0 = Instance.new("Attachment")
		a0.Position = Vector3.new(0, 0.3, 0)
		a0.Parent = gem
		local a1 = Instance.new("Attachment")
		a1.Position = Vector3.new(0, -0.3, 0)
		a1.Parent = gem
		local tr = Instance.new("Trail")
		tr.Attachment0 = a0
		tr.Attachment1 = a1
		tr.Lifetime = 0.25
		tr.LightEmission = 1
		tr.FaceCamera = true
		tr.Color = ColorSequence.new(gem.Color, Color3.new(1, 1, 1))
		tr.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
		tr.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) })
		tr.Parent = gem
	end)
	local start = pos
	local t0 = os.clock()
	local dur = 0.42
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local t = math.min(1, (os.clock() - t0) / dur)
		local tp
		if target:IsA("Model") then
			tp = target:GetPivot().Position
		else
			tp = target.Position
		end
		local mid = (start + tp) / 2 + Vector3.new(0, 6, 0)
		local a = start:Lerp(mid, t)
		local b = mid:Lerp(tp, t)
		local p = a:Lerp(b, t)
		gem.CFrame = CFrame.new(p) * CFrame.Angles(t * 8, t * 6, 0)
		gem.Size = Vector3.new(0.7, 0.7, 0.7) * (1 - t * 0.6)
		if t >= 1 then
			conn:Disconnect()
			gem:Destroy()
		end
	end)
end

-- Лёгкая тряска камеры (крит, Хроно-Жила): смещение камеры персонажа, быстро затухает
local shakeUntil, shakePower = 0, 0
local shakeConn
function VFX.Shake(power)
	local char = Players.LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum then
		return
	end
	shakePower = math.max(shakePower, power or 0.3)
	shakeUntil = os.clock() + 0.22
	if shakeConn then
		return
	end
	shakeConn = RunService.RenderStepped:Connect(function()
		local left = shakeUntil - os.clock()
		if left <= 0 or not hum.Parent then
			hum.CameraOffset = Vector3.new()
			shakePower = 0
			shakeConn:Disconnect()
			shakeConn = nil
			return
		end
		local k = shakePower * (left / 0.22)
		hum.CameraOffset = Vector3.new((math.random() - 0.5) * k, (math.random() - 0.5) * k, (math.random() - 0.5) * k * 0.5)
	end)
end

-- Всплывающая цифра урона: «выпрыгивает» с пружинкой, взлетает по дуге и тает.
-- Крит — крупнее, золотисто-оранжевый градиент и лёгкий наклон.
local NUNITO
pcall(function()
	NUNITO = Font.new("rbxasset://fonts/families/Nunito.json", Enum.FontWeight.Heavy)
end)
local pool = {}
function VFX.DamageNumber(pos, text, crit)
	local holder = table.remove(pool)
	if not holder then
		holder = Instance.new("Part")
		holder.Anchored = true
		holder.CanCollide = false
		holder.CanQuery = false
		holder.CanTouch = false
		holder.Transparency = 1
		holder.Size = Vector3.new(0.2, 0.2, 0.2)
		local bb = Instance.new("BillboardGui")
		bb.Name = "BB"
		bb.Size = UDim2.fromOffset(180, 50)
		bb.AlwaysOnTop = true
		bb.LightInfluence = 0
		bb.Parent = holder
		local l = Instance.new("TextLabel")
		l.Name = "L"
		l.BackgroundTransparency = 1
		l.Size = UDim2.fromScale(1, 1)
		l.Font = Enum.Font.FredokaOne
		if NUNITO then
			l.FontFace = NUNITO
		end
		l.TextScaled = true
		l.Parent = bb
		local st = Instance.new("UIStroke")
		st.Thickness = 3
		st.Color = Color3.fromRGB(30, 22, 40)
		st.Parent = l
		local g = Instance.new("UIGradient")
		g.Rotation = 90
		g.Parent = l
		local sc = Instance.new("UIScale")
		sc.Parent = l
	end
	holder.Parent = fx()
	local bb = holder.BB
	local l = bb.L
	local g = l:FindFirstChildOfClass("UIGradient")
	local sc = l:FindFirstChildOfClass("UIScale")
	l.Text = text
	l.TextColor3 = Color3.new(1, 1, 1)
	if crit then
		g.Color = ColorSequence.new(Color3.fromRGB(255, 236, 120), Color3.fromRGB(255, 110, 40))
		l.UIStroke.Color = Color3.fromRGB(90, 20, 10)
		l.Rotation = math.random(-8, 8)
	else
		g.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(214, 222, 255))
		l.UIStroke.Color = Color3.fromRGB(24, 18, 44)
		l.Rotation = 0
	end
	l.TextTransparency = 0
	l.UIStroke.Transparency = 0
	bb.Size = crit and UDim2.fromOffset(240, 70) or UDim2.fromOffset(150, 40)
	local side = math.random() * 2 - 1
	local p = pos + Vector3.new(side * 1.2, 2.4, math.random() * 2 - 1)
	holder.CFrame = CFrame.new(p)
	sc.Scale = crit and 1.9 or 1.5
	TweenService:Create(sc, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	local tw = TweenService:Create(holder, TweenInfo.new(0.75, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CFrame = CFrame.new(p + Vector3.new(side * 1.5, crit and 3.6 or 2.8, 0)) })
	tw:Play()
	TweenService:Create(l, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 0.42), { TextTransparency = 1 }):Play()
	TweenService:Create(l.UIStroke, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 0.42), { Transparency = 1 }):Play()
	task.delay(0.76, function()
		holder.Parent = nil
		table.insert(pool, holder)
	end)
end

return VFX
