]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000000A"><Properties><string name="Name">PetsData</string><ProtectedString name="Source"><![CDATA[-- PetsData: единый реестр всех питомцев, собирается из EggsData и SeedsData.
local EggsData = require(script.Parent.EggsData)
local SeedsData = require(script.Parent.SeedsData)
local RewardsData = require(script.Parent.RewardsData)

local Rarities = {
	{ Key = "Common", Name = "Обычный", Color = { 190, 196, 206 }, Min = 25 },
	{ Key = "Uncommon", Name = "Необычный", Color = { 96, 214, 104 }, Min = 12 },
	{ Key = "Rare", Name = "Редкий", Color = { 70, 160, 255 }, Min = 5 },
	{ Key = "Epic", Name = "Эпический", Color = { 180, 96, 255 }, Min = 1.5 },
	{ Key = "Legendary", Name = "Легендарный", Color = { 255, 190, 40 }, Min = 0 },
	{ Key = "Mythic", Name = "Мифический", Color = { 255, 70, 120 }, Min = math.huge },
	{ Key = "Secret", Name = "Хроно", Color = { 90, 240, 255 }, Min = -1 },
	{ Key = "Huge", Name = "Огромный", Color = { 255, 96, 220 }, Min = -2 },
}
local RarityIndex = {}
for i, r in ipairs(Rarities) do
	r.Index = i
	RarityIndex[r.Key] = r
end

local function rarityFor(chance, flag)
	if flag == "Mythic" then
		return RarityIndex.Mythic
	end
	if flag == "Huge" then
		return RarityIndex.Huge
	end
	for _, r in ipairs(Rarities) do
		if chance >= r.Min then
			return r
		end
	end
	return Rarities[#Rarities - 1]
end

-- Сила питомца (P): бонус к урону/продаже до улучшений и уровней.
-- Яйцо №e (1..15): самый слабый пет = EggBase * EggGrow^(e-1), самый редкий обычный — в EggSpan раз сильнее,
-- мифик — ещё в MythicMult раз (Balance).
-- Фокус: нечётные по редкости — «урон» (урон 100%, продажа 50%), чётные — «продажа»,
-- самый редкий в яйце — оба бонуса по 100%.
local Balance = require(script.Parent.Balance)
local EGG_BASE, EGG_GROW, EGG_SPAN = Balance.EggBase, Balance.EggGrow, Balance.EggSpan
local function round2(x)
	return math.floor(x * 1000 + 0.5) / 1000
end

local Pets = {}
for e, egg in ipairs(EggsData.List) do
	local n = 0
	for _, entry in ipairs(egg.Pets) do
		if entry[5] ~= "Mythic" and entry[5] ~= "Huge" then
			n = n + 1
		end
	end
	local pmin = EGG_BASE * EGG_GROW ^ ((egg.PowerIndex or e) - 1)
	egg.Index = e
	for order, entry in ipairs(egg.Pets) do
		local id = entry[1]
		local mythic = entry[5] == "Mythic"
		local huge = entry[5] == "Huge"
		local rarity = rarityFor(entry[3], entry[5])
		local p = pmin * EGG_SPAN ^ ((math.min(order, n) - 1) / math.max(1, n - 1))
		if mythic then
			p = pmin * EGG_SPAN * Balance.MythicMult
		elseif huge then
			p = pmin * EGG_SPAN * Balance.MythicMult * (Balance.HugeMult or 1.8)
		end
		local df, sf
		if order >= n then
			df, sf = 1, 1
		elseif order % 2 == 1 then
			df, sf = 1, 0.5
		else
			df, sf = 0.5, 1
		end
		Pets[id] = {
			Id = id,
			Name = entry[2],
			Chance = entry[3],
			P = round2(p),
			DmgF = df,
			SellF = sf,
			Egg = egg.Id,
			Biome = egg.Biome,
			Order = order,
			Rarity = rarity.Key,
		}
	end
end

-- сила самого редкого пета яйца №e
local function EggTopPower(e)
	return EGG_BASE * EGG_GROW ^ (e - 1) * EGG_SPAN
end

for _, seed in ipairs(SeedsData.List) do
	Pets[seed.Pet] = {
		Id = seed.Pet,
		Name = seed.PetName,
		Chance = 0,
		P = round2(EGG_BASE * EGG_GROW ^ (seed.Biome * 3 - 2) * EGG_SPAN * seed.PowerMult),
		DmgF = 1,
		SellF = 1,
		Seed = seed.Id,
		Biome = seed.Biome,
		Order = 99,
		Rarity = "Secret",
		Aura = seed.Aura,
	}
end

for id, sp in pairs(RewardsData.SpecialPets) do
	Pets[id] = {
		Id = id,
		Name = sp.Name,
		Chance = 0,
		P = RewardsData.SpecialMult(id, 1),
		DmgF = sp.DmgF or 1,
		SellF = sp.SellF or 1,
		Special = sp.Source,
		Biome = 1,
		Order = 98,
		Rarity = sp.Rarity or "Secret",
		Aura = sp.Aura,
	}
end

return {
	ById = Pets,
	EggTopPower = EggTopPower,
	Rarities = Rarities,
	Rarity = RarityIndex,
	Get = function(id)
		return Pets[id]
	end,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000000B"><Properties><string name="Name">QuestsData</string><ProtectedString name="Source"><![CDATA[-- QuestsData: сюжетные квесты Drill-Bot 3000 (ТЗ 7.2 А) и шаблоны динамических (ТЗ 7.2 Б).
-- Stat — ключ счётчика в data.Stats (или "SessionEggs" — счётчик за текущую сессию).
-- Trips — монеты в «рейсах» (1 рейс = полный первый рюкзак открытого яруса), считаются при получении.
local Story = {
	{ Title = "Первые шаги", Text = "Разбей 50 блоков земли", Stat = "Biome1Blocks", Target = 50,
		Reward = { Trips = 1.5, Boosts = { CoinElixir = 1 } } },
	{ Title = "Первое яйцо", Text = "Открой любое яйцо в Зоне 1", Stat = "EggsBiome1", Target = 1,
		Reward = { Trips = 2, Boosts = { DrillOvercharge = 1 } } },
	{ Title = "Бурильщик", Text = "Достигни глубины 250 метров", Stat = "MaxDepth", Target = 250,
		Reward = { Trips = 3, Boosts = { BioFertilizer = 1 } } },
	{ Title = "Звёздный питомец", Text = "Улучши питомца до ★ (5 одинаковых)", Stat = "GoldenCrafted", Target = 1,
		Reward = { Trips = 4, Boosts = { LuckyCharm = 1 } } },
	{ Title = "Археология", Text = "Добудь 300 янтарных блоков", Stat = "AmberBlocks", Target = 300,
		Reward = { Trips = 5, Boosts = { CoinElixir = 2 } } },
	{ Title = "Селекционер", Text = "Посади семя в инкубатор", Stat = "SeedsPlanted", Target = 1,
		Reward = { Boosts = { BioFertilizer = 2, LuckyCharm = 1 } } },
	{ Title = "Вечная мерзлота", Text = "Разбей 1 000 ледяных блоков", Stat = "IceBlocks", Target = 1000,
		Reward = { Trips = 6, Boosts = { DrillOvercharge = 2 } } },
	{ Title = "Открытие глубин", Text = "Открой 10 яиц за сессию", Stat = "SessionEggs", Target = 10,
		Reward = { Boosts = { LuckyCharm = 2, BioFertilizer = 3 } } },
	{ Title = "Ледяной шлюз", Text = "Достигни глубины 4 500 метров", Stat = "MaxDepth", Target = 4500,
		Reward = { Trips = 8, Boosts = { CoinElixir = 3 } } },
	{ Title = "Пекло", Text = "Нанеси 1 000 000 000 суммарного урона", Stat = "TotalDamage", Target = 1000000000,
		Reward = { Trips = 10, Boosts = { DrillOvercharge = 3 } } },
	{ Title = "Реликтовый мастер", Text = "Вырасти семя Магмы или Бездны", Stat = "RareSeedsGrown", Target = 1,
		Reward = { Boosts = { BioFertilizer = 5, LuckyCharm = 3 } } },
	{ Title = "Абсолют", Text = "Достигни дна — 15 000 метров", Stat = "MaxDepth", Target = 15000,
		Reward = { Trips = 20, PetSlot = 1, Boosts = { CoinElixir = 3, DrillOvercharge = 3, LuckyCharm = 3, BioFertilizer = 3 } } },
}

-- Динамические задания: 3 слота, у каждого свой пул типов.
-- Новое задание никогда не повторяет два предыдущих типа в этом слоте.
--   Base   — диапазон цели; PerBiome — прибавка за каждый ярус
--   Hits   — цель = число ударов x текущий урон; Trips — цель = N полных рюкзаков в монетах
--   DepthFrac — цель = глубина внутри текущего яруса (доля от его высоты)
--   Reward — сколько «рейсов» монет (1 рейс = ~40 блоков текущего яруса) + случайный буст
local Dynamic = {
	[1] = { -- ДОБЫЧА
		{ Type = "MineBlocks", Text = "Сломай блоки в ярусе «{b}» ×{n}", Base = { 60, 140 }, PerBiome = 25 },
		{ Type = "MineOre", Text = "Добудь рудные блоки ×{n}", Base = { 14, 32 }, PerBiome = 4 },
		{ Type = "MineVeins", Text = "Разбей Хроно-Жилы ×{n}", Base = { 1, 3 }, PerBiome = 0 },
		{ Type = "Depth", Text = "Спустись на глубину {n} м", DepthFrac = { 0.25, 0.6 } },
		{ Type = "DealDamage", Text = "Нанеси {n} урона", Hits = { 150, 320 } },
		{ Type = "Nuggets", Text = "Собери Хроно-самородки ×{n}", Base = { 3, 7 }, PerBiome = 0 },
	},
	[2] = { -- КОЛЛЕКЦИЯ
		{ Type = "OpenEggs", Text = "Открой яйца ×{n}", Base = { 2, 6 }, PerBiome = 1 },
		{ Type = "UseBoosts", Text = "Используй бусты ×{n}", Base = { 1, 2 }, PerBiome = 0, NeedsBoost = true },
		{ Type = "GrowSeed", Text = "Вырасти питомца из семени ×{n}", Base = { 1, 1 }, PerBiome = 0, NeedsSeed = true },
		{ Type = "EarnCoins", Text = "Заработай {n} монет продажей", Trips = { 2, 4 } },
		{ Type = "SellCount", Text = "Продай руду на Репликаторе ×{n}", Base = { 3, 6 }, PerBiome = 0 },
	},
	[3] = { -- МАСТЕРСТВО
		{ Type = "Crits", Text = "Нанеси критические удары ×{n}", Base = { 12, 30 }, PerBiome = 3 },
		{ Type = "SellFull", Text = "Продай полный рюкзак ×{n}", Base = { 1, 3 }, PerBiome = 0 },
		{ Type = "PlayMinutes", Text = "Проведи в игре {n} мин.", Base = { 5, 12 }, PerBiome = 0 },
		{ Type = "Hits", Text = "Сделай удары буром ×{n}", Base = { 150, 300 }, PerBiome = 20 },
		{ Type = "MineBlocks", Text = "Сломай блоки в ярусе «{b}» ×{n}", Base = { 150, 260 }, PerBiome = 30 },
		{ Type = "OpenEggs", Text = "Открой яйца ×{n}", Base = { 4, 8 }, PerBiome = 1 },
	},
}

-- Недельные задания: каждую неделю (понедельник 03:00 МСК) выбираются 4 разных.
-- В тексте {n} — цель, {b} — ярус. Монеты за недельное считаются в момент получения (по открытому ярусу).
local Weekly = {
	{ Type = "MineBlocks", Text = "Сломай блоки в любой шахте ×{n}", Base = { 1500, 2500 }, AnyBiome = true },
	{ Type = "MineOre", Text = "Добудь рудные блоки ×{n}", Base = { 300, 500 } },
	{ Type = "MineVeins", Text = "Разбей Хроно-Жилы ×{n}", Base = { 25, 40 } },
	{ Type = "OpenEggs", Text = "Открой яйца ×{n}", Base = { 30, 50 } },
	{ Type = "EarnCoins", Text = "Заработай {n} монет продажей", Trips = { 20, 30 } },
	{ Type = "Crits", Text = "Нанеси критические удары ×{n}", Base = { 250, 400 } },
	{ Type = "SellFull", Text = "Продай полный рюкзак ×{n}", Base = { 15, 25 } },
	{ Type = "UseBoosts", Text = "Используй бусты ×{n}", Base = { 6, 10 } },
	{ Type = "PlayMinutes", Text = "Проведи в игре {n} мин.", Base = { 90, 150 } },
	{ Type = "Nuggets", Text = "Собери Хроно-самородки ×{n}", Base = { 60, 100 } },
	{ Type = "DealDamage", Text = "Нанеси {n} урона", Hits = { 5000, 8000 } },
}

local WeeklyBonus = {
	Text = "Выполни все недельные задания",
	Reward = { Pet = "StarGriffin", Boosts = { LuckyCharm = 3, CoinElixir = 2 } },
}

return { Story = Story, Dynamic = Dynamic, Weekly = Weekly, WeeklyBonus = WeeklyBonus }
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000000C"><Properties><string name="Name">RebirthData</string><ProtectedString name="Source"><![CDATA[-- RebirthData: перерождения и Хроно-Древо (ТЗ 8).
return {
	RequiredBiome = 4,              -- нужно открыть Магму (4 500 м)
	BaseCoins = 2e10,               -- 20 млрд для 1-го ребёрса
	CoinScale = 3,                  -- каждый следующий ребёрс дороже в 3 раза
	SellBonusPerRebirth = 0.25,     -- +25% к продаже за каждый ребёрс (аддитивно)
	BaseShards = 2,                 -- осколков за ребёрс
	ShardsPerExtraBiome = 2,        -- бонус, если открыта Бездна
	IncubatorSlotAt = 5,            -- 2-й слот инкубатора за 5-й ребёрс

	Perks = {
		{ Id = "DrillSpeed", Name = "Скорость бурения", Desc = "+5% к частоте ударов", PerLevel = 0.05, Costs = { 1, 1, 2, 2, 3, 3 }, Color = { 255, 120, 70 } },
		{ Id = "Capacity", Name = "Вместимость рюкзака", Desc = "+10% к вместимости", PerLevel = 0.10, Costs = { 1, 2, 2, 3, 3 }, Color = { 255, 196, 46 } },
		{ Id = "WalkSpeed", Name = "Скорость бега", Desc = "+4% к скорости бега", PerLevel = 0.04, Costs = { 1, 1, 2, 2, 3 }, Color = { 90, 200, 255 } },
		{ Id = "Magnet", Name = "Магнит руды", Desc = "Радиус сбора самородков 8 → 16", Radius = { 8, 10, 12, 14, 16 }, Costs = { 1, 2, 2, 3, 3 }, Color = { 170, 110, 255 } },
		{ Id = "PetSlot", Name = "Слот питомца", Desc = "+1 слот экипировки", PerLevel = 1, Costs = { 8 }, Color = { 90, 220, 110 } },
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000000D"><Properties><string name="Name">RewardsData</string><ProtectedString name="Source"><![CDATA[-- RewardsData: ежедневные награды (7 дней) и колесо удачи (раз в 24 часа).
-- Монеты масштабируются под открытый ярус: 1 "рейс" = первый рюкзак яруса, полный руды.
local BiomesData = require(script.Parent.BiomesData)
local EggsData = require(script.Parent.EggsData)
local BackpacksData = require(script.Parent.BackpacksData)
local Balance = require(script.Parent.Balance)

local Rewards = {}

Rewards.DailyCooldown = 24 * 60 * 60   -- ежедневная награда — раз в 24 часа
Rewards.DailyStreakReset = 48 * 60 * 60 -- если пропустить больше 48 часов, серия начинается заново
Rewards.WheelCooldown = 24 * 60 * 60

-- Эксклюзивные питомцы (в PetsData попадают с редкостью "Хроно")
Rewards.SpecialPets = {
	ChronoKitsune = {
		Name = "Хроно-Кицунэ",
		Source = "Награда за 7-й день",
		RefIndex = 4, RefMult = 1.3, -- сила 4-го пета премиум-яйца открытого яруса x1.3
		Aura = { Kind = "Both", Value = 0.15, Text = "15% урона по соседу и +10% скорости" },
	},
	StarGriffin = {
		Name = "Звёздный Грифон",
		Source = "Все недельные задания",
		RefIndex = 6, RefMult = 1.25,
		Aura = { Kind = "Both", Value = 0.2, Text = "20% урона по соседу и +10% скорости" },
	},
	FortuneCat = {
		Name = "Кот Фортуны",
		Source = "Джекпот колеса удачи",
		RefIndex = 5, RefMult = 1.15, DmgF = 0.5, SellF = 1.5,
		Aura = { Kind = "Speed", Value = 0.08, Text = "+8% к скорости бега" },
	},
	-- «Огромные» эксклюзивы: награды за перерождения (выдаёт RebirthManager)
	HugeChronoDragon = {
		Name = "Огромный Хроно-Дракон",
		Source = "1-е перерождение",
		RebirthAt = 1,
		Rarity = "Huge",
		RefIndex = 6, RefMult = 2.4,
		Aura = { Kind = "Both", Value = 0.25, Text = "25% урона по соседу и +12% скорости" },
	},
	HugeRainbowUnicorn = {
		Name = "Огромный Радужный Единорог",
		Source = "5-е перерождение",
		RebirthAt = 5,
		Rarity = "Huge",
		RefIndex = 6, RefMult = 3,
		Aura = { Kind = "Both", Value = 0.3, Text = "30% урона по соседу и +15% скорости" },
	},
}

-- премиум-яйцо яруса
local function premiumEgg(biome)
	for i, egg in ipairs(EggsData.List) do
		if egg.Biome == biome and egg.Slot == 2 then
			return egg, i
		end
	end
	return EggsData.List[2], 2
end

-- сила эксклюзивного пета (P), зависит от открытого яруса на момент получения
function Rewards.SpecialMult(petId, biome)
	local sp = Rewards.SpecialPets[petId]
	local egg, e = premiumEgg(math.clamp(biome or 1, 1, #BiomesData))
	local n = #egg.Pets - 1 -- без мифика
	local idx = math.min(sp.RefIndex, n)
	local p = Balance.EggBase * Balance.EggGrow ^ (e - 1) * Balance.EggSpan ^ ((idx - 1) / math.max(1, n - 1))
	return math.floor(p * sp.RefMult * 1000 + 0.5) / 1000
end

-- «Рейс»: стоимость первого рюкзака яруса, набитого рудой середины шахты
function Rewards.CoinScale(biome)
	local b = BiomesData[math.clamp(biome or 1, 1, #BiomesData)]
	local cap = 180
	for _, p in ipairs(BackpacksData.List) do
		if p.Biome == b.Id then
			cap = p.Capacity
			break
		end
	end
	return math.floor(cap * (b.Ore[1] + b.Ore[2]) / 2 * 1.1 * (b.SellMult or 1))
end

-- Kind: Coins (Amount = сколько "рейсов"), Boost (Id, Amount), Seed (Amount), Pet (Id), Bundle (Items)
Rewards.Daily = {
	{ Kind = "Coins", Amount = 1, Color = { 255, 198, 48 } },
	{ Kind = "Boost", Id = "CoinElixir", Amount = 1, Color = { 255, 196, 46 } },
	{ Kind = "Bundle", Items = { { Kind = "Coins", Amount = 2 }, { Kind = "Boost", Id = "DrillOvercharge", Amount = 1 } }, Color = { 255, 120, 80 } },
	{ Kind = "Boost", Id = "LuckyCharm", Amount = 2, Color = { 90, 220, 110 } },
	{ Kind = "Bundle", Items = { { Kind = "Seed", Amount = 1 }, { Kind = "Boost", Id = "BioFertilizer", Amount = 2 } }, Color = { 170, 110, 255 } },
	{ Kind = "Bundle", Items = { { Kind = "Coins", Amount = 4 }, { Kind = "Boost", Id = "CoinElixir", Amount = 1 }, { Kind = "Boost", Id = "DrillOvercharge", Amount = 1 }, { Kind = "Boost", Id = "LuckyCharm", Amount = 1 } }, Color = { 70, 160, 255 } },
	{ Kind = "Pet", Id = "ChronoKitsune", Color = { 255, 110, 170 } },
}

-- Сегменты колеса (по часовой стрелке от верхней точки)
Rewards.Wheel = {
	{ Kind = "Coins", Amount = 1, Weight = 22, Color = { 255, 198, 48 } },
	{ Kind = "Boost", Id = "CoinElixir", Amount = 1, Weight = 15, Color = { 255, 146, 46 } },
	{ Kind = "Boost", Id = "DrillOvercharge", Amount = 1, Weight = 15, Color = { 255, 86, 86 } },
	{ Kind = "Coins", Amount = 5, Weight = 9, Color = { 255, 230, 120 } },
	{ Kind = "Boost", Id = "LuckyCharm", Amount = 2, Weight = 12, Color = { 88, 214, 96 } },
	{ Kind = "Seed", Amount = 1, Weight = 9, Color = { 50, 210, 196 } },
	{ Kind = "Boost", Id = "BioFertilizer", Amount = 3, Weight = 14, Color = { 164, 96, 255 } },
	{ Kind = "Pet", Id = "FortuneCat", Weight = 4, Color = { 255, 110, 170 } },
}

return Rewards
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000000E"><Properties><string name="Name">SeedsData</string><ProtectedString name="Source"><![CDATA[-- SeedsData: Хроно-Семена (ТЗ 5). Chance = шанс за сломанный блок.
-- Питомец из семени: сила = PowerMult x самый редкий пет премиум-яйца яруса
-- (плюс случайно 0..+20%), даёт оба бонуса и уникальную ауру.
-- Янтарная почка для 2-го биома — добавлена, чтобы в каждом ярусе было своё семя.
local function rgb(r, g, b) return { r, g, b } end

local Seeds = {
	{
		Id = "Sprout", Name = "Земляной росток", Biome = 1, Chance = 0.001, Duration = 5 * 60,
		Pet = "SproutSprite", PetName = "Ростик", PowerMult = 0.9,
		Aura = { Kind = "Speed", Value = 0.10, Text = "+10% к скорости бега" },
		Color = rgb(110, 210, 80),
	},
	{
		Id = "AmberBud", Name = "Янтарная почка", Biome = 2, Chance = 0.0008, Duration = 10 * 60,
		Pet = "AmberTreant", PetName = "Янтарный энт", PowerMult = 0.9,
		Aura = { Kind = "Splash", Value = 0.2, Text = "20% урона по соседнему блоку" },
		Color = rgb(255, 160, 40),
	},
	{
		Id = "CryoSeed", Name = "Крио-кокон", Biome = 3, Chance = 0.0005, Duration = 20 * 60,
		Pet = "GlacierMoth", PetName = "Ледяной мотылёк", PowerMult = 0.95,
		Aura = { Kind = "Speed", Value = 0.15, Text = "+15% к скорости бега" },
		Color = rgb(140, 220, 255),
	},
	{
		Id = "MagmaSpore", Name = "Лавовое ядро", Biome = 4, Chance = 0.0002, Duration = 60 * 60,
		Pet = "MagmaHydra", PetName = "Магма-гидра", PowerMult = 1,
		Aura = { Kind = "Splash", Value = 0.3, Text = "30% урона по соседнему блоку" },
		Color = rgb(255, 100, 30),
	},
	{
		Id = "VoidCore", Name = "Ядро Сингулярности", Biome = 5, Chance = 0.00005, Duration = 4 * 60 * 60,
		Pet = "ChronoSeraph", PetName = "Хроно-серафим", PowerMult = 1.1,
		Aura = { Kind = "Both", Value = 0.35, Text = "35% урона по соседу и +10% скорости" },
		Color = rgb(150, 110, 255),
	},
}

local byId, byBiome, byPet = {}, {}, {}
for _, s in ipairs(Seeds) do
	byId[s.Id] = s
	byBiome[s.Biome] = s
	byPet[s.Pet] = s
end

return { List = Seeds, ById = byId, ByBiome = byBiome, ByPet = byPet }
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000000F"><Properties><string name="Name">SoundsData</string><ProtectedString name="Source"><![CDATA[-- SoundsData: все звуки и музыка игры.
--
-- КАК ПОСТАВИТЬ НАШИ ЗВУКИ (папка SFX в архиве, 19 звуков + 3 трека музыки):
--   1) Studio → View → Asset Manager → кнопка «Bulk Import» → выбери все .ogg из папки SFX.
--   2) В Asset Manager → Audio появятся звуки. Перетащи каждый в Explorer в папку
--      ReplicatedStorage → CustomSounds (имя Sound должно совпадать с именем файла: BlockBreak, Music_Hub...).
--   Всё — игра сама берёт звуки из CustomSounds. Ничего вписывать сюда не нужно.
--   (Можно и по-старому: скопировать ID и вписать в Id ниже как "rbxassetid://123456".)
--
-- Пока свои звуки не загружены, играют мягкие встроенные звуки Roblox (без «взрывов»), музыки нет.
return {
	Click = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.18, Pitch = 2 },
	Hover = { Id = "", Volume = 0.1 },
	DrillHit = { Id = "rbxasset://sounds/clickfast.wav", Volume = 0.22, Pitch = 0.6 },
	Crit = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.3, Pitch = 1.4 },
	BlockBreak = { Id = "rbxasset://sounds/clickfast.wav", Volume = 0.35, Pitch = 0.42 },
	OrePickup = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.12, Pitch = 2.4 },
	Coins = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.35, Pitch = 1.25 },
	EggShake = { Id = "rbxasset://sounds/clickfast.wav", Volume = 0.35, Pitch = 0.7 },
	EggCrack = { Id = "rbxasset://sounds/clickfast.wav", Volume = 0.5, Pitch = 1.1 },
	Reveal = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.45, Pitch = 0.9 },
	Warning = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.5, Pitch = 0.7 },
	Siren = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.55, Pitch = 0.5 },
	Teleport = { Id = "rbxasset://sounds/swordlunge.wav", Volume = 0.3, Pitch = 1.1 },
	Unlock = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.5, Pitch = 1.0 },
	Error = { Id = "rbxasset://sounds/clickfast.wav", Volume = 0.3, Pitch = 0.5 },
	Full = { Id = "rbxasset://sounds/clickfast.wav", Volume = 0.3, Pitch = 0.45 },
	Seed = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.45, Pitch = 1.8 },
	LevelUp = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.45, Pitch = 1.5 },
	Upgrade = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.55, Pitch = 1.2 },

	-- фоновая музыка (зацикленная): база, шахта, глубины (Магма и Бездна)
	Music = {
		Music_Hub = { Id = "" },
		Music_Mine = { Id = "" },
		Music_Deep = { Id = "" },
	},
}
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX00000000000000000000000000000011"><Properties><string name="Name">CustomSounds</string></Properties></Item><Item class="Folder" referent="RBX0000000000000000000000000000001A"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX00000000000000000000000000000012"><Properties><string name="Name">GearBuilder</string><ProtectedString name="Source"><![CDATA[-- GearBuilder: процедурные модели буров, рюкзаков и яиц.
-- Бур: рукоять в начале координат (ось Y), сверло смотрит в -Z.
-- Сверло собрано отдельно (BitRoot + Weld "BitWeld"), клиент вращает его во время бурения.
local MK = require(script.Parent.ModelKit)

local V3 = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local rad = math.rad

local GearBuilder = {}

local function weldTo(part0, part1, name)
	local w = Instance.new("Weld")
	w.Name = name or "Weld"
	w.Part0 = part0
	w.Part1 = part1
	w.C0 = part0.CFrame:Inverse() * part1.CFrame
	w.Parent = part1
	return w
end

---------------------------------------------------------------------------------------------
-- Бур
---------------------------------------------------------------------------------------------
function GearBuilder.Drill(def)
	local look = def.Look
	local tier = look.Tier or 1
	local body = MK.C(look.Body)
	local accent = MK.C(look.Accent)
	local bitC = MK.C(look.Bit)
	local model = Instance.new("Model")
	model.Name = def.Id

	local grip = MK.Cylinder(model, 1.15, 0.5, CF(0, 0, 0) * ANG(0, 0, rad(90)), accent, { Name = "Grip" })
	model.PrimaryPart = grip
	for i = -1, 1 do
		MK.Cylinder(model, 0.08, 0.56, CF(0, i * 0.3, 0) * ANG(0, 0, rad(90)), MK.Shade(accent, -0.3))
	end
	MK.Part(model, V3(0.35, 0.45, 0.3), CF(0, 0.45, -0.38), MK.Shade(accent, -0.25))

	local bodyLen = 1.6 + tier * 0.03
	local bodyCf = CF(0, 0.85, -0.55)
	MK.Part(model, V3(1.0, 0.95, bodyLen), bodyCf, body)
	MK.Part(model, V3(1.06, 0.22, bodyLen * 0.9), bodyCf * CF(0, 0.12, 0), accent)
	MK.Cylinder(model, 0.55, 1.15, bodyCf * CF(0, 0, bodyLen / 2 + 0.15) * ANG(0, rad(90), 0), MK.Shade(body, -0.2))
	MK.Cylinder(model, 0.12, 0.6, bodyCf * CF(0, 0, bodyLen / 2 + 0.45) * ANG(0, rad(90), 0), accent)
	for k = -1, 1 do
		MK.Part(model, V3(1.04, 0.06, 0.08), bodyCf * CF(0, -0.25, bodyLen / 2 - 0.2 - k * 0.15 - 0.15), MK.Shade(body, -0.35))
	end
	if tier >= 5 then
		for _, s in ipairs({ -1, 1 }) do
			MK.Part(model, V3(0.2, 0.55, bodyLen * 0.6), bodyCf * CF(s * 0.58, 0.05, 0.1), accent)
		end
	end
	if tier >= 9 then
		MK.Part(model, V3(0.5, 0.35, 0.8), bodyCf * CF(0, 0.6, 0.2), MK.Shade(body, 0.15))
		MK.Wedge(model, V3(0.5, 0.35, 0.4), bodyCf * CF(0, 0.6, -0.4) * ANG(0, rad(180), 0), MK.Shade(body, 0.15))
	end
	if look.Glow then
		local g = MK.C(look.Glow)
		MK.Part(model, V3(1.08, 0.1, 0.1), bodyCf * CF(0, -0.05, -bodyLen / 2 + 0.25), g, { Material = "Neon" })
		MK.Part(model, V3(0.1, 0.1, bodyLen * 0.7), bodyCf * CF(0, 0.49, 0), g, { Material = "Neon" })
		if tier >= 13 then
			MK.Light(model.PrimaryPart, g, 6, 0.8)
		end
	end

	-- Сверло
	local bitZ = -0.55 - bodyLen / 2
	local bitRoot = MK.Part(model, V3(0.2, 0.2, 0.2), CF(0, 0.85, bitZ), bitC, { Name = "BitRoot", Transparency = 1 })
	MK.Cylinder(model, 0.3, 0.95, CF(0, 0.85, bitZ - 0.05) * ANG(0, rad(90), 0), MK.Shade(body, -0.3))
	local bitLen = 1.7 + math.min(tier, 20) * 0.04
	local steps = { { 0.82, 0.32 }, { 0.64, 0.28 }, { 0.48, 0.24 }, { 0.32, 0.16 } }
	local z = bitZ - 0.2
	local bitParts = {}
	for i, s in ipairs(steps) do
		local len = bitLen * s[2]
		local p = MK.Cylinder(model, len, s[1], CF(0, 0.85, z - len / 2) * ANG(0, rad(90), 0), (i % 2 == 0) and MK.Shade(bitC, -0.18) or bitC, { Material = "Metal" })
		table.insert(bitParts, p)
		z = z - len
	end
	local tip = MK.Ellipsoid(model, V3(0.18, 0.18, 0.3), CF(0, 0.85, z), bitC, { Material = "Metal" })
	table.insert(bitParts, tip)
	-- спиральные канавки
	for k = 0, 2 do
		local ang = k * math.pi * 2 / 3
		local fl = MK.Part(model, V3(0.12, 0.06, bitLen * 0.8), CF(0, 0.85, bitZ - 0.2 - bitLen * 0.4) * ANG(0, 0, ang) * CF(0, 0.32, 0) * ANG(rad(-12), 0, 0), MK.Shade(bitC, -0.45), { Material = "Metal" })
		table.insert(bitParts, fl)
	end
	for _, p in ipairs(bitParts) do
		p.Name = "Bit"
		local w = Instance.new("WeldConstraint")
		w.Part0 = bitRoot
		w.Part1 = p
		w.Parent = p
		p.Anchored = false
		p.Massless = true
	end

	-- всё, кроме сверла, приварено к рукояти
	for _, d in ipairs(model:GetChildren()) do
		if d:IsA("BasePart") and d ~= grip and d.Name ~= "Bit" and d ~= bitRoot then
			local w = Instance.new("WeldConstraint")
			w.Part0 = grip
			w.Part1 = d
			w.Parent = d
			d.Anchored = false
			d.Massless = true
		end
	end
	local bitWeld = weldTo(grip, bitRoot, "BitWeld")
	bitRoot.Anchored = false
	bitRoot.Massless = true
	grip.Anchored = false
	grip.Massless = true
	model:SetAttribute("Tier", tier)
	return model
end

---------------------------------------------------------------------------------------------
-- Рюкзак (крепится к спине; центр модели = точка крепления)
---------------------------------------------------------------------------------------------
function GearBuilder.Backpack(def)
	local look = def.Look
	local tier = look.Tier or 1
	local body = MK.C(look.Body)
	local accent = MK.C(look.Accent)
	local model = Instance.new("Model")
	model.Name = def.Id
	local s = 1 + math.min(tier, 20) * 0.025
	local root = MK.Part(model, V3(0.4, 0.4, 0.4), CF(0, 0, 0), body, { Name = "Root", Transparency = 1 })
	model.PrimaryPart = root
	MK.Part(model, V3(1.6 * s, 1.75 * s, 0.85 * s), CF(0, 0, 0.45 * s), body)
	MK.Part(model, V3(1.66 * s, 0.7 * s, 0.92 * s), CF(0, 0.6 * s, 0.45 * s), MK.Shade(body, -0.15))
	MK.Part(model, V3(1.1 * s, 0.6 * s, 0.25 * s), CF(0, -0.35 * s, 0.95 * s), accent)
	MK.Part(model, V3(0.3 * s, 0.22 * s, 0.1), CF(0, 0.35 * s, 0.92 * s), MK.Shade(accent, 0.3), { Material = "Metal" })
	for _, x in ipairs({ -0.5, 0.5 }) do
		MK.Part(model, V3(0.22 * s, 1.85 * s, 0.12), CF(x * s, 0, 0.0), MK.Shade(accent, -0.2))
	end
	if tier >= 4 then
		for _, x in ipairs({ -0.86, 0.86 }) do
			MK.Cylinder(model, 0.9 * s, 0.5 * s, CF(x * s, -0.2 * s, 0.45 * s) * ANG(0, 0, rad(90)), accent)
		end
	end
	if look.Glow then
		local core = MK.Part(model, V3(0.9 * s, 0.9 * s, 0.1), CF(0, -0.05 * s, 0.9 * s), accent, { Material = "Neon", Transparency = 0.1 })
		core.Name = "Core"
	end
	MK.WeldAll(model, root)
	return model
end

---------------------------------------------------------------------------------------------
-- Яйцо: две половинки (Top/Bottom) + узоры. Pivot в центре яйца.
---------------------------------------------------------------------------------------------
function GearBuilder.Egg(def, scale)
	scale = scale or 1
	local look = def.Look
	local base = MK.C(look.Base)
	local accent = MK.C(look.Accent)
	local band = MK.C(look.Band)
	local glass = look.Pattern == "glass"
	local mat = glass and "Glass" or "SmoothPlastic"
	local trans = glass and 0.15 or 0

	local model = Instance.new("Model")
	model.Name = def.Id
	local root = MK.Part(model, V3(0.5, 0.5, 0.5), CF(0, 0, 0), base, { Name = "Root", Transparency = 1 })
	model.PrimaryPart = root

	local top = Instance.new("Model")
	top.Name = "Top"
	top.Parent = model
	local bottom = Instance.new("Model")
	bottom.Name = "Bottom"
	bottom.Parent = model

	local tPart = MK.Ellipsoid(top, V3(3.6, 3.4, 3.6), CF(0, 0.75, 0), base, { Material = mat, Transparency = trans })
	local bPart = MK.Ellipsoid(bottom, V3(4.0, 3.6, 4.0), CF(0, -0.35, 0), base, { Material = mat, Transparency = trans })
	top.PrimaryPart = tPart
	bottom.PrimaryPart = bPart
	-- зубчатый шов
	for i = 0, 11 do
		local ang = i * math.pi * 2 / 12
		local p = V3(math.cos(ang) * 1.86, 0.28, math.sin(ang) * 1.86)
		local cf = CF(p, V3(0, 0.28, 0)) * ANG(0, rad(180), 0)
		local w = MK.Wedge(bottom, V3(0.12, 0.42, 0.9), cf * ANG(0, rad(90), 0), band)
		w.Name = "Zig"
	end
	MK.Cylinder(bottom, 0.32, 4.02, CF(0, 0.05, 0) * ANG(0, 0, rad(90)), band, look.Neon and { Material = "Neon" } or nil)

	-- точки на поверхности скорлупы (две половинки — два эллипсоида)
	local TOP_C, TOP_R = V3(0, 0.75, 0), V3(1.8, 1.7, 1.8)
	local BOT_C, BOT_R = V3(0, -0.35, 0), V3(2.0, 1.8, 2.0)
	local function surf(dir)
		dir = dir.Unit
		local function onE(c, r)
			local t = 1 / math.sqrt((dir.X / r.X) ^ 2 + (dir.Y / r.Y) ^ 2 + (dir.Z / r.Z) ^ 2)
			local p = c + dir * t
			local rel = p - c
			local n = V3(rel.X / (r.X * r.X), rel.Y / (r.Y * r.Y), rel.Z / (r.Z * r.Z)).Unit
			return p, n
		end
		local p, n = onE(TOP_C, TOP_R)
		if p.Y > 0.35 then
			return p, n, top
		end
		p, n = onE(BOT_C, BOT_R)
		return p, n, bottom
	end
	-- равномерно распределённые направления (спираль Фибоначчи), больше спереди (-Z)
	local dirs = {}
	local count = 20
	for i = 0, count - 1 do
		local y = 1 - (i + 0.5) / count * 1.9
		local r = math.sqrt(math.max(0, 1 - y * y))
		local a = i * 2.39996
		table.insert(dirs, V3(math.cos(a) * r, y, math.sin(a) * r - 0.25))
	end
	local accentOpts = { Material = look.Neon and "Neon" or "SmoothPlastic" }
	local pat = look.Pattern
	if pat == "spots" or pat == "glass" then
		for i, d in ipairs(dirs) do
			if math.abs(d.Y) < 0.88 and i % 2 == 1 or i % 5 == 0 then
				local p, n, half = surf(d)
				local s = 0.75 + (i % 3) * 0.22
				MK.Ellipsoid(half, V3(s, s * 0.8, 0.22), CF(p, p + n), accent, accentOpts)
			end
		end
		if glass then
			local core = MK.Ellipsoid(bottom, V3(2.2, 2.2, 2.2), CF(0, 0.1, 0), accent, { Material = "Neon", Transparency = 0.35 })
			core.CastShadow = false
		end
	elseif pat == "cracks" then
		for i, d in ipairs(dirs) do
			if i % 2 == 0 then
				local p, n, half = surf(d)
				local cf = CF(p, p + n)
				for k = -1, 1 do
					local seg = cf * CF(k * 0.22, k * 0.28, 0) * ANG(0, 0, rad(35 * ((k % 2 == 0) and 1 or -1)))
					MK.Part(half, V3(0.13, 0.5, 0.14), seg, accent, accentOpts)
				end
			end
		end
	elseif pat == "flames" then
		for i = 0, 9 do
			local a = i * math.pi * 2 / 10
			local d = V3(math.cos(a), -0.05 + (i % 2) * 0.18, math.sin(a))
			local p, n, half = surf(d)
			local h = (i % 2 == 0) and 1.3 or 0.9
			local cf = CF(p, p + n) * CF(0, h * 0.3, 0)
			local w1 = MK.Wedge(bottom, V3(0.12, h, 0.35), cf * CF(-0.17, 0, 0) * ANG(0, rad(90), 0), accent, accentOpts)
			local w2 = MK.Wedge(bottom, V3(0.12, h, 0.35), cf * CF(0.17, 0, 0) * ANG(0, rad(-90), 0), accent, accentOpts)
		end
		for i, d in ipairs(dirs) do
			if d.Y > 0.3 and i % 3 == 0 then
				local p, n, half = surf(d)
				MK.Ellipsoid(half, V3(0.5, 0.5, 0.18), CF(p, p + n), MK.Shade(accent, 0.3), accentOpts)
			end
		end
	elseif pat == "bones" then
		for i, d in ipairs(dirs) do
			if i % 3 == 1 then
				local p, n, half = surf(d)
				local cf = CF(p, p + n) * ANG(0, 0, rad(i * 40))
				MK.Part(half, V3(0.22, 0.95, 0.18), cf, accent)
				MK.Ellipsoid(half, V3(0.4, 0.3, 0.26), cf * CF(0, 0.5, 0), accent)
				MK.Ellipsoid(half, V3(0.4, 0.3, 0.26), cf * CF(0, -0.5, 0), accent)
			end
		end
	elseif pat == "stars" then
		for i, d in ipairs(dirs) do
			local p, n, half = surf(d)
			local s = (i % 3 == 0) and 0.42 or 0.24
			MK.Ellipsoid(half, V3(s, s, s), CF(p), accent, { Material = "Neon" })
		end
		local p, n, half = surf(V3(0.2, 0.55, -1))
		local cf = CF(p, p + n)
		MK.Part(half, V3(0.7, 0.18, 0.12), cf, accent, { Material = "Neon" })
		MK.Part(half, V3(0.18, 0.7, 0.12), cf, accent, { Material = "Neon" })
	end
	if look.Neon then
		MK.Light(root, accent, 10, 1.2)
	end
	if scale ~= 1 then
		model:ScaleTo(scale)
	end
	return model
end

return GearBuilder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000013"><Properties><string name="Name">IconModels</string><ProtectedString name="Source"><![CDATA[-- IconModels: маленькие 3D-модели для иконок интерфейса (рендерятся во ViewportFrame).
-- Каждая иконка смотрит в камеру по -Z, центр модели примерно в (0, 0, 0).
local MK = require(script.Parent.ModelKit)

local V3 = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local rad = math.rad

local Icons = {}
local GOLD = { 255, 200, 50 }
local GOLD_D = { 220, 150, 20 }
local GOLD_L = { 255, 236, 140 }
local WHITE = { 255, 255, 255 }
local INK = { 40, 32, 56 }

local function model(name)
	local m = Instance.new("Model")
	m.Name = name
	local root = MK.Part(m, V3(0.2, 0.2, 0.2), CF(0, 0, 0), WHITE, { Name = "Root", Transparency = 1 })
	m.PrimaryPart = root
	return m
end

local B = {}

function B.Coin(m)
	local tilt = ANG(rad(90), 0, 0) * ANG(0, 0, rad(-18))
	MK.Cylinder(m, 0.55, 3.2, CF(0, 0, 0.1) * ANG(0, rad(90), 0) * ANG(rad(18), 0, 0), GOLD_D, { Material = "Metal" })
	MK.Cylinder(m, 0.58, 3.0, CF(0, 0, 0) * ANG(0, rad(90), 0) * ANG(rad(18), 0, 0), GOLD, { Material = "Metal" })
	MK.Cylinder(m, 0.62, 2.2, CF(0, 0, -0.02) * ANG(0, rad(90), 0) * ANG(rad(18), 0, 0), GOLD_L, { Material = "Metal" })
	-- звезда-тиснение
	local face = CF(0, 0, -0.34)
	for i = 0, 1 do
		MK.Part(m, V3(0.32, 1.3, 0.12), face * ANG(0, 0, rad(i * 90)), GOLD_D, { Material = "Metal" })
	end
	for i = 0, 1 do
		MK.Part(m, V3(0.28, 1.0, 0.12), face * ANG(0, 0, rad(45 + i * 90)), GOLD_D, { Material = "Metal" })
	end
	MK.Ellipsoid(m, V3(0.5, 0.35, 0.1), CF(-0.7, 0.85, -0.36), WHITE, { Transparency = 0.25 })
end

function B.Shard(m)
	-- огранённый кристалл: шестигранная призма + пирамидки сверху и снизу
	local col = { 176, 110, 255 }
	local dark = { 128, 70, 220 }
	for i = 0, 2 do
		local r = ANG(0, rad(i * 60), 0)
		MK.Part(m, V3(1.5, 1.4, 0.86), CF(0, 0, 0) * r, (i == 1) and dark or col)
		local top = CF(0, 1.25, 0) * r
		MK.Wedge(m, V3(1.5, 1.1, 0.43), top * CF(0, 0, -0.215), col)
		MK.Wedge(m, V3(1.5, 1.1, 0.43), top * CF(0, 0, 0.215) * ANG(0, rad(180), 0), dark)
		local bot = CF(0, -1.1, 0) * r * ANG(rad(180), 0, 0)
		MK.Wedge(m, V3(1.5, 0.8, 0.43), bot * CF(0, 0, -0.215), dark)
		MK.Wedge(m, V3(1.5, 0.8, 0.43), bot * CF(0, 0, 0.215) * ANG(0, rad(180), 0), col)
	end
	MK.Part(m, V3(0.2, 1.1, 0.1), CF(-0.3, 0.1, -0.76), { 235, 215, 255 }, { Material = "Neon" })
	MK.Ellipsoid(m, V3(0.35, 0.35, 0.35), CF(0.75, 1.5, -0.4), { 245, 235, 255 }, { Material = "Neon" })
end

function B.Backpack(m)
	local body = { 230, 140, 60 }
	MK.Part(m, V3(2.2, 2.4, 1.2), CF(0, -0.1, 0), body)
	MK.Part(m, V3(2.3, 0.9, 1.3), CF(0, 0.75, -0.02), { 196, 108, 44 })
	MK.Part(m, V3(1.5, 0.9, 0.35), CF(0, -0.55, -0.7), { 255, 200, 60 })
	MK.Part(m, V3(0.4, 0.3, 0.12), CF(0, 0.45, -0.68), { 220, 220, 230 }, { Material = "Metal" })
	MK.Cylinder(m, 0.9, 0.22, CF(0, 1.35, 0.1) * ANG(0, 0, 0), { 150, 86, 40 })
	for _, x in ipairs({ -1.25, 1.25 }) do
		MK.Cylinder(m, 1.3, 0.6, CF(x, -0.3, 0) * ANG(0, 0, rad(90)), { 255, 200, 60 })
	end
end

function B.Chest(m)
	local wood = { 176, 110, 60 }
	MK.Part(m, V3(2.8, 1.6, 1.8), CF(0, -0.5, 0), wood)
	MK.Cylinder(m, 2.8, 1.8, CF(0, 0.3, 0), { 196, 128, 70 })
	for _, x in ipairs({ -1.0, 1.0 }) do
		MK.Part(m, V3(0.3, 1.65, 1.85), CF(x, -0.5, 0), GOLD, { Material = "Metal" })
		MK.Cylinder(m, 0.32, 1.88, CF(x, 0.3, 0), GOLD, { Material = "Metal" })
	end
	MK.Part(m, V3(0.55, 0.65, 0.2), CF(0, -0.1, -0.95), GOLD, { Material = "Metal" })
	MK.Part(m, V3(0.15, 0.25, 0.1), CF(0, -0.15, -1.06), INK)
	MK.Part(m, V3(0.8, 0.8, 0.8), CF(0.4, 1.05, -0.2) * ANG(rad(45), rad(45), 0), { 120, 230, 255 }, { Material = "Neon" })
end

function B.Paw(m)
	local c = { 255, 150, 90 }
	local pad = { 255, 205, 170 }
	MK.Ellipsoid(m, V3(2.0, 1.7, 0.8), CF(0, -0.45, 0), c)
	MK.Ellipsoid(m, V3(1.3, 1.0, 0.4), CF(0, -0.5, -0.32), pad)
	for i, p in ipairs({ { -1.05, 0.55 }, { -0.38, 1.05 }, { 0.38, 1.05 }, { 1.05, 0.55 } }) do
		MK.Ellipsoid(m, V3(0.75, 0.85, 0.6), CF(p[1], p[2], 0), c)
		MK.Ellipsoid(m, V3(0.45, 0.5, 0.3), CF(p[1], p[2], -0.22), pad)
	end
end

function B.ShopBag(m)
	local red = { 255, 86, 86 }
	MK.Part(m, V3(2.4, 2.4, 1.2), CF(0, -0.3, 0), red)
	MK.Part(m, V3(2.45, 0.35, 1.25), CF(0, 0.75, 0), { 220, 60, 60 })
	for _, x in ipairs({ -0.6, 0.6 }) do
		MK.CylinderBetween(m, V3(x, 0.9, -0.3), V3(x * 0.6, 1.7, -0.3), 0.18, { 120, 40, 40 })
	end
	MK.CylinderBetween(m, V3(-0.36, 1.7, -0.3), V3(0.36, 1.7, -0.3), 0.18, { 120, 40, 40 })
	-- значок монеты на пакете
	MK.Cylinder(m, 0.2, 1.1, CF(0, -0.35, -0.62) * ANG(0, rad(90), 0), GOLD, { Material = "Metal" })
	MK.Cylinder(m, 0.22, 0.7, CF(0, -0.35, -0.64) * ANG(0, rad(90), 0), GOLD_L, { Material = "Metal" })
end

function B.Stats(m)
	MK.Part(m, V3(3.2, 0.35, 1.2), CF(0, -1.4, 0), { 70, 66, 90 })
	local bars = { { -1.0, 1.2, { 88, 214, 96 } }, { 0, 2.0, { 255, 198, 48 } }, { 1.0, 2.8, { 70, 160, 255 } } }
	for _, b in ipairs(bars) do
		MK.Part(m, V3(0.75, b[2], 0.9), CF(b[1], -1.2 + b[2] / 2, 0), b[3])
		MK.Part(m, V3(0.8, 0.15, 0.95), CF(b[1], -1.2 + b[2], 0), WHITE, { Transparency = 0.4 })
	end
	MK.CylinderBetween(m, V3(-1.3, 0.2, -0.6), V3(1.1, 1.8, -0.6), 0.22, { 255, 86, 86 })
	MK.Wedge(m, V3(0.2, 0.55, 0.55), CF(1.25, 1.95, -0.6) * ANG(rad(-56), rad(90), 0), { 255, 86, 86 })
end

function B.Gift(m)
	local box = { 255, 90, 120 }
	MK.Part(m, V3(2.4, 2.0, 2.4), CF(0, -0.5, 0), box)
	MK.Part(m, V3(2.6, 0.6, 2.6), CF(0, 0.65, 0), { 255, 120, 150 })
	MK.Part(m, V3(0.5, 2.7, 2.65), CF(0, -0.2, 0), GOLD)
	MK.Part(m, V3(2.65, 2.7, 0.5), CF(0, -0.2, 0), GOLD)
	for _, s in ipairs({ -1, 1 }) do
		MK.Ellipsoid(m, V3(1.0, 0.7, 0.45), CF(s * 0.5, 1.25, 0) * ANG(0, 0, rad(s * -30)), GOLD)
	end
	MK.Ellipsoid(m, V3(0.45, 0.45, 0.45), CF(0, 1.15, 0), GOLD_D)
end

function B.Wheel(m)
	local seg = { { 255, 198, 48 }, { 255, 86, 86 }, { 88, 214, 96 }, { 70, 160, 255 }, { 164, 96, 255 }, { 255, 146, 46 }, { 50, 210, 196 }, { 255, 110, 170 } }
	MK.Cylinder(m, 0.45, 3.3, CF(0, 0, 0.12) * ANG(0, rad(90), 0), GOLD, { Material = "Metal" })
	for i, c in ipairs(seg) do
		local a = (i - 1) * 45
		MK.Part(m, V3(1.0, 1.45, 0.3), CF(0, 0, -0.05) * ANG(0, 0, rad(a)) * CF(0, 0.75, 0), c)
	end
	MK.Cylinder(m, 0.5, 0.7, CF(0, 0, -0.1) * ANG(0, rad(90), 0), WHITE)
	MK.Wedge(m, V3(0.25, 0.7, 0.6), CF(0, 1.85, -0.25) * ANG(rad(180), 0, 0) * ANG(0, rad(90), 0), { 255, 86, 86 })
	for i = 0, 7 do
		MK.Ellipsoid(m, V3(0.22, 0.22, 0.22), CF(0, 0, -0.15) * ANG(0, 0, rad(i * 45 + 22.5)) * CF(0, 1.55, 0), { 255, 250, 210 }, { Material = "Neon" })
	end
end

function B.Capsule(m)
	MK.Disc(m, 0.5, 2.2, V3(0, -1.35, 0), { 200, 206, 220 })
	MK.Disc(m, 2.2, 1.8, V3(0, -0.1, 0), { 210, 245, 255 }, { Material = "Glass", Transparency = 0.6 })
	MK.Disc(m, 0.3, 1.86, V3(0, -0.85, 0), { 110, 255, 140 }, { Material = "Neon" })
	MK.Disc(m, 1.5, 1.5, V3(0, -0.4, 0), { 110, 255, 140 }, { Material = "Neon", Transparency = 0.2 })
	MK.Ellipsoid(m, V3(0.7, 0.9, 0.7), CF(0, -0.2, -0.2), { 120, 210, 80 })
	MK.Ellipsoid(m, V3(0.5, 0.15, 0.3), CF(0.25, 0.35, -0.2) * ANG(0, 0, rad(25)), { 80, 180, 60 })
	MK.Ellipsoid(m, V3(2.2, 0.9, 2.2), CF(0, 1.1, 0), { 200, 206, 220 })
end

function B.Hourglass(m)
	MK.Disc(m, 0.35, 2.4, V3(0, 1.5, 0), GOLD, { Material = "Metal" })
	MK.Disc(m, 0.35, 2.4, V3(0, -1.5, 0), GOLD, { Material = "Metal" })
	for _, x in ipairs({ -1.0, 1.0 }) do
		MK.Disc(m, 3.0, 0.22, V3(x, 0, -0.3), GOLD_D, { Material = "Metal" })
	end
	MK.Ellipsoid(m, V3(1.6, 1.5, 1.6), CF(0, 0.65, 0), { 200, 240, 255 }, { Material = "Glass", Transparency = 0.45 })
	MK.Ellipsoid(m, V3(1.6, 1.5, 1.6), CF(0, -0.65, 0), { 200, 240, 255 }, { Material = "Glass", Transparency = 0.45 })
	MK.Ellipsoid(m, V3(1.1, 0.7, 1.1), CF(0, -0.95, 0), { 255, 110, 200 }, { Material = "Neon" })
	MK.Ellipsoid(m, V3(0.7, 0.4, 0.7), CF(0, 0.45, 0), { 255, 110, 200 }, { Material = "Neon" })
	MK.Disc(m, 0.9, 0.12, V3(0, -0.1, 0), { 255, 140, 220 }, { Material = "Neon" })
end

function B.Planet(m)
	MK.Ellipsoid(m, V3(2.6, 2.6, 2.6), CF(0, 0, 0), { 80, 170, 255 })
	MK.Ellipsoid(m, V3(1.2, 0.9, 0.6), CF(-0.5, 0.45, -1.0) * ANG(0, rad(20), 0), { 110, 220, 110 })
	MK.Ellipsoid(m, V3(0.9, 0.7, 0.5), CF(0.6, -0.5, -1.05) * ANG(0, rad(-25), 0), { 110, 220, 110 })
	local ringCf = CF(0, 0, 0) * ANG(rad(-72), 0, rad(18))
	for i = 0, 19 do
		local a = i * math.pi * 2 / 20
		MK.Ellipsoid(m, V3(0.42, 0.14, 0.42), ringCf * CF(math.cos(a) * 2.0, 0, math.sin(a) * 2.0), { 255, 210, 120 })
	end
	MK.Ellipsoid(m, V3(0.6, 0.4, 0.2), CF(-0.6, 0.85, -1.05), WHITE, { Transparency = 0.35 })
end

function B.Scroll(m)
	MK.Part(m, V3(2.2, 2.6, 0.15), CF(0, 0, 0), { 255, 240, 200 })
	MK.Cylinder(m, 2.6, 0.5, CF(0, 1.35, 0), { 230, 200, 150 })
	MK.Cylinder(m, 2.6, 0.5, CF(0, -1.35, 0), { 230, 200, 150 })
	for i = 0, 2 do
		MK.Part(m, V3(1.4, 0.14, 0.05), CF(0, 0.6 - i * 0.5, -0.1), { 150, 110, 80 })
	end
	MK.Ellipsoid(m, V3(0.6, 0.6, 0.2), CF(0.55, -0.85, -0.12), { 230, 60, 70 })
end

local function potion(m, liquid)
	MK.Ellipsoid(m, V3(2.2, 2.0, 2.2), CF(0, -0.55, 0), { 220, 245, 255 }, { Material = "Glass", Transparency = 0.55 })
	MK.Ellipsoid(m, V3(1.95, 1.55, 1.95), CF(0, -0.7, 0), liquid, { Material = "Neon", Transparency = 0.05 })
	-- цветная этикетка — цвет зелья видно даже без прозрачности
	MK.Ellipsoid(m, V3(2.26, 0.55, 2.26), CF(0, -0.45, 0), liquid)
	MK.Disc(m, 0.9, 0.8, V3(0, 0.75, 0), { 220, 245, 255 }, { Material = "Glass", Transparency = 0.3 })
	MK.Disc(m, 0.55, 0.9, V3(0, 1.35, 0), { 170, 120, 80 })
	MK.Ellipsoid(m, V3(0.45, 0.3, 0.2), CF(-0.55, -0.05, -1.05), WHITE, { Transparency = 0.2 })
end

function B.CoinElixir(m)
	potion(m, { 255, 196, 46 })
	MK.Cylinder(m, 0.15, 0.6, CF(0, -0.7, -1.02) * ANG(0, rad(90), 0), GOLD_D, { Material = "Metal" })
end

function B.DrillOvercharge(m)
	potion(m, { 255, 80, 70 })
	MK.Part(m, V3(0.28, 0.75, 0.15), CF(0.1, -0.45, -1.05) * ANG(0, 0, rad(25)), { 255, 240, 120 }, { Material = "Neon" })
	MK.Part(m, V3(0.28, 0.75, 0.15), CF(-0.1, -0.95, -1.05) * ANG(0, 0, rad(25)), { 255, 240, 120 }, { Material = "Neon" })
end

function B.LuckyCharm(m)
	local g = { 90, 220, 110 }
	for i = 0, 3 do
		local a = rad(i * 90 + 45)
		MK.Ellipsoid(m, V3(1.4, 1.4, 0.4), CF(math.cos(a) * 0.72, math.sin(a) * 0.72 + 0.2, 0) * ANG(0, 0, a), g)
		MK.Ellipsoid(m, V3(0.5, 0.5, 0.2), CF(math.cos(a) * 0.8, math.sin(a) * 0.8 + 0.2, -0.18), { 160, 250, 170 })
	end
	MK.CylinderBetween(m, V3(0, 0.1, 0), V3(0.5, -1.5, 0), 0.25, { 60, 160, 70 })
	MK.Ellipsoid(m, V3(0.4, 0.4, 0.4), CF(0, 0.2, -0.15), { 255, 240, 120 }, { Material = "Neon" })
end

function B.BioFertilizer(m)
	potion(m, { 170, 110, 255 })
	MK.Ellipsoid(m, V3(0.45, 0.25, 0.2), CF(0.2, -0.6, -1.05) * ANG(0, 0, rad(30)), { 140, 240, 120 })
end

function B.Seed(m)
	MK.Ellipsoid(m, V3(1.8, 2.4, 1.8), CF(0, -0.3, 0) * ANG(0, 0, rad(12)), { 150, 210, 90 })
	MK.Ellipsoid(m, V3(1.2, 0.5, 0.6), CF(0.6, 1.25, 0) * ANG(0, 0, rad(-25)), { 90, 190, 70 })
	MK.Ellipsoid(m, V3(0.5, 0.35, 0.2), CF(-0.4, 0.2, -0.85), WHITE, { Transparency = 0.3 })
end

function B.Drill(m)
	MK.Part(m, V3(1.4, 1.2, 1.8), CF(-0.4, 0.3, 0) * ANG(0, rad(90), 0), { 255, 196, 46 })
	MK.Part(m, V3(1.45, 0.3, 1.6), CF(-0.4, 0.5, 0) * ANG(0, rad(90), 0), { 40, 40, 48 })
	MK.Cylinder(m, 1.0, 0.55, CF(-0.7, -0.75, 0), { 60, 60, 70 })
	local x = 0.6
	for i, d in ipairs({ 1.0, 0.75, 0.5, 0.28 }) do
		MK.Cylinder(m, 0.45, d, CF(x + 0.22, 0.3, 0), (i % 2 == 0) and { 190, 194, 206 } or { 225, 228, 236 }, { Material = "Metal" })
		x = x + 0.42
	end
end

function B.Home(m)
	MK.Part(m, V3(2.4, 1.8, 2.0), CF(0, -0.6, 0), { 255, 245, 230 })
	MK.Wedge(m, V3(2.8, 1.3, 1.2), CF(0, 0.95, -0.6) * ANG(0, rad(180), 0), { 255, 100, 90 })
	MK.Wedge(m, V3(2.8, 1.3, 1.2), CF(0, 0.95, 0.6), { 255, 100, 90 })
	MK.Part(m, V3(0.7, 1.1, 0.1), CF(0, -0.95, -1.02), { 150, 100, 60 })
	MK.Part(m, V3(0.55, 0.5, 0.1), CF(0.75, -0.4, -1.02), { 120, 220, 255 }, { Material = "Neon" })
end

function B.Clock(m)
	MK.Cylinder(m, 0.5, 3.0, CF(0, 0, 0.1) * ANG(0, rad(90), 0), { 70, 160, 255 })
	MK.Cylinder(m, 0.55, 2.5, CF(0, 0, 0) * ANG(0, rad(90), 0), WHITE)
	MK.Part(m, V3(0.18, 0.9, 0.1), CF(0, 0.4, -0.3), INK)
	MK.Part(m, V3(0.7, 0.18, 0.1), CF(0.3, 0, -0.3), INK)
	MK.Ellipsoid(m, V3(0.25, 0.25, 0.1), CF(0, 0, -0.33), { 255, 86, 86 })
end

function B.Star(m)
	for i = 0, 4 do
		local a = rad(90 + i * 72)
		MK.Wedge(m, V3(0.5, 1.3, 0.55), CF(math.cos(a) * 0.65, math.sin(a) * 0.65, 0) * ANG(0, 0, a - rad(90)) * ANG(0, rad(90), 0), GOLD)
		MK.Wedge(m, V3(0.5, 1.3, 0.55), CF(math.cos(a) * 0.65, math.sin(a) * 0.65, 0) * ANG(0, 0, a - rad(90)) * ANG(0, rad(-90), 0), GOLD_D)
	end
	MK.Ellipsoid(m, V3(1.2, 1.2, 0.8), CF(0, 0, 0), GOLD)
end

function B.Lock(m)
	MK.Part(m, V3(2.0, 1.6, 0.9), CF(0, -0.5, 0), GOLD, { Material = "Metal" })
	MK.Cylinder(m, 0.3, 1.5, CF(0, 0.6, 0) * ANG(0, rad(90), 0), { 200, 200, 210 }, { Material = "Metal" })
	MK.Part(m, V3(0.25, 0.5, 0.1), CF(0, -0.5, -0.46), INK)
end

function B.Gem(m)
	B.Shard(m)
end

local cache = {}
function Icons.Build(name)
	local fn = B[name] or B.Star
	local m = model(name)
	fn(m)
	return m
end

function Icons.Get(name)
	if not cache[name] then
		cache[name] = Icons.Build(name)
	end
	return cache[name]:Clone()
end

Icons.Names = {}
for k in pairs(B) do
	table.insert(Icons.Names, k)
end
table.sort(Icons.Names)

return Icons
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000014"><Properties><string name="Name">ModelKit</string><ProtectedString name="Source"><![CDATA[-- ModelKit: строительные блоки для процедурных low-poly моделей.
-- Всё собирается из примитивов Roblox (Part, WedgePart, CornerWedgePart, SpecialMesh Sphere),
-- поэтому игре не нужны загруженные меши и текстуры.
local ModelKit = {}

local MATERIALS = {
	SmoothPlastic = Enum.Material.SmoothPlastic,
	Glass = Enum.Material.Glass,
	Neon = Enum.Material.Neon,
	Metal = Enum.Material.Metal,
	Ice = Enum.Material.Ice,
	Wood = Enum.Material.Wood,
	Slate = Enum.Material.Slate,
	Plastic = Enum.Material.Plastic,
	Rock = Enum.Material.Rock,
	Sand = Enum.Material.Sand,
	Grass = Enum.Material.Grass,
	Fabric = Enum.Material.Fabric,
	ForceField = Enum.Material.ForceField,
	Basalt = Enum.Material.Basalt,
	Snow = Enum.Material.Snow,
	Cobblestone = Enum.Material.Cobblestone,
	WoodPlanks = Enum.Material.WoodPlanks,
	Ground = Enum.Material.Ground,
	Mud = Enum.Material.Mud,
	Pebble = Enum.Material.Pebble,
	Sandstone = Enum.Material.Sandstone,
	Limestone = Enum.Material.Limestone,
	Glacier = Enum.Material.Glacier,
	Asphalt = Enum.Material.Asphalt,
	CrackedLava = Enum.Material.CrackedLava,
	Granite = Enum.Material.Granite,
	LeafyGrass = Enum.Material.LeafyGrass,
	Salt = Enum.Material.Salt,
	Marble = Enum.Material.Marble,
	Plaster = Enum.Material.Plaster,
	Brick = Enum.Material.Brick,
	Concrete = Enum.Material.Concrete,
	DiamondPlate = Enum.Material.DiamondPlate,
	CorrodedMetal = Enum.Material.CorrodedMetal,
	Foil = Enum.Material.Foil,
}
ModelKit.Materials = MATERIALS

-- «Мягкий» стиль (как в Pet Simulator): земля, трава и листва — гладкие, без «шумных» текстур.
-- Красивые текстуры оставлены точечно: дерево, булыжник, кирпич, мрамор, сланец (скалы и камни),
-- ткань, металл. Выключить фильтр полностью — ModelKit.Soft = false.
ModelKit.Soft = true
local KEEP = {
	[Enum.Material.SmoothPlastic] = true,
	[Enum.Material.Neon] = true,
	[Enum.Material.Glass] = true,
	[Enum.Material.ForceField] = true,
	[Enum.Material.Wood] = true,
	[Enum.Material.WoodPlanks] = true,
	[Enum.Material.Cobblestone] = true,
	[Enum.Material.Brick] = true,
	[Enum.Material.Marble] = true,
	[Enum.Material.Slate] = true,
	[Enum.Material.Granite] = true,
	[Enum.Material.Fabric] = true,
	[Enum.Material.Metal] = true,
	[Enum.Material.DiamondPlate] = true,
	[Enum.Material.Plaster] = true,
	[Enum.Material.Ice] = true,
}

-- материал как есть, без мягкого фильтра (блоки шахты — с родными текстурами)
function ModelKit.MatRaw(name)
	if typeof(name) == "EnumItem" then
		return name
	end
	return MATERIALS[name or "SmoothPlastic"] or Enum.Material.SmoothPlastic
end
function ModelKit.Mat(name)
	local m
	if typeof(name) == "EnumItem" then
		m = name
	else
		m = MATERIALS[name or "SmoothPlastic"] or Enum.Material.SmoothPlastic
	end
	if ModelKit.Soft and not KEEP[m] then
		return Enum.Material.SmoothPlastic
	end
	return m
end

function ModelKit.C(t)
	if typeof(t) == "Color3" then
		return t
	end
	return Color3.fromRGB(t[1], t[2], t[3])
end

function ModelKit.Shade(color, f)
	-- f > 0 светлее, f < 0 темнее
	color = ModelKit.C(color)
	if f >= 0 then
		return color:Lerp(Color3.new(1, 1, 1), f)
	end
	return color:Lerp(Color3.new(0, 0, 0), -f)
end

local function base(p, parent, props)
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	p.CastShadow = true
	if props then
		for k, v in pairs(props) do
			if k == "Color" then
				p.Color = ModelKit.C(v)
			elseif k == "Material" then
				p.Material = ModelKit.Mat(v)
			else
				p[k] = v
			end
		end
	end
	p.Parent = parent
	return p
end

function ModelKit.Part(parent, size, cf, color, props)
	local p = Instance.new("Part")
	p.Size = size
	p.CFrame = cf
	p.Color = ModelKit.C(color or { 200, 200, 200 })
	return base(p, parent, props)
end

function ModelKit.Wedge(parent, size, cf, color, props)
	local p = Instance.new("WedgePart")
	p.Size = size
	p.CFrame = cf
	p.Color = ModelKit.C(color or { 200, 200, 200 })
	return base(p, parent, props)
end

function ModelKit.Corner(parent, size, cf, color, props)
	local p = Instance.new("CornerWedgePart")
	p.Size = size
	p.CFrame = cf
	p.Color = ModelKit.C(color or { 200, 200, 200 })
	return base(p, parent, props)
end

-- Эллипсоид: Part + SpecialMesh Sphere растягивается под размер детали.
function ModelKit.Ellipsoid(parent, size, cf, color, props)
	local p = ModelKit.Part(parent, size, cf, color, props)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end

-- Цилиндр, ось вдоль X детали.
function ModelKit.Cylinder(parent, length, diameter, cf, color, props)
	local p = ModelKit.Part(parent, Vector3.new(length, diameter, diameter), cf, color, props)
	p.Shape = Enum.PartType.Cylinder
	return p
end

-- Цилиндр между двумя точками.
function ModelKit.CylinderBetween(parent, a, b, diameter, color, props)
	local len = (b - a).Magnitude
	local mid = (a + b) / 2
	local cf = CFrame.lookAt(mid, b) * CFrame.Angles(0, math.rad(90), 0)
	return ModelKit.Cylinder(parent, len, diameter, cf, color, props)
end

-- Вертикальный цилиндр (ось Y) с центром в pos.
function ModelKit.Disc(parent, height, diameter, pos, color, props)
	return ModelKit.Cylinder(parent, height, diameter, CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90)), color, props)
end

-- Блок между двумя точками (балка).
function ModelKit.Beam(parent, a, b, thickness, color, props)
	local len = (b - a).Magnitude
	local mid = (a + b) / 2
	return ModelKit.Part(parent, Vector3.new(thickness, thickness, len), CFrame.lookAt(mid, b), color, props)
end

-- Сваривает все BasePart модели с root и снимает якорь.
function ModelKit.WeldAll(model, root, keepAnchored)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d ~= root then
			local w = Instance.new("WeldConstraint")
			w.Part0 = root
			w.Part1 = d
			w.Parent = d
			d.Anchored = false
			d.Massless = true
		end
	end
	root.Anchored = keepAnchored and true or false
end

-- Текстовая табличка на грани детали.
function ModelKit.Sign(part, face, text, textColor, strokeColor, font)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face or Enum.NormalId.Front
	gui.CanvasSize = Vector2.new(400, math.floor(400 * part.Size.Y / math.max(part.Size.X, 0.1)))
	gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
	gui.LightInfluence = 0.2
	gui.Parent = part
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = font or Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = textColor and ModelKit.C(textColor) or Color3.new(1, 1, 1)
	label.Parent = gui
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0.06, 0)
	pad.PaddingRight = UDim.new(0.06, 0)
	pad.PaddingTop = UDim.new(0.1, 0)
	pad.PaddingBottom = UDim.new(0.1, 0)
	pad.Parent = label
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 4
	stroke.Color = strokeColor and ModelKit.C(strokeColor) or Color3.fromRGB(30, 24, 40)
	stroke.Parent = label
	return gui, label
end

-- Плавающая надпись над объектом.
function ModelKit.Billboard(adornee, text, color, size, offset)
	local bb = Instance.new("BillboardGui")
	bb.Size = size or UDim2.fromOffset(220, 60)
	bb.StudsOffset = offset or Vector3.new(0, 4, 0)
	bb.AlwaysOnTop = false
	bb.MaxDistance = 120
	bb.LightInfluence = 0
	bb.Adornee = adornee
	bb.Parent = adornee
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = color and ModelKit.C(color) or Color3.new(1, 1, 1)
	label.Parent = bb
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = Color3.fromRGB(30, 24, 40)
	stroke.Parent = label
	return bb, label
end

function ModelKit.Light(parent, color, range, brightness)
	local l = Instance.new("PointLight")
	l.Color = ModelKit.C(color)
	l.Range = range or 12
	l.Brightness = brightness or 1
	l.Shadows = false
	l.Parent = parent
	return l
end

-- Стандартный эмиттер искр (встроенная текстура Roblox).
function ModelKit.Sparkles(parent, color, rate, size)
	local e = Instance.new("ParticleEmitter")
	e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	e.Color = ColorSequence.new(ModelKit.C(color))
	e.LightEmission = 0.8
	e.Rate = rate or 4
	e.Lifetime = NumberRange.new(0.8, 1.4)
	e.Speed = NumberRange.new(0.5, 1.5)
	e.SpreadAngle = Vector2.new(180, 180)
	local s = size or 0.35
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.3, s), NumberSequenceKeypoint.new(1, 0) })
	e.Transparency = NumberSequence.new(0.1)
	e.Parent = parent
	return e
end

-- Объёмная надпись (как большие буквы над зонами в симуляторах): несколько слоёв SurfaceGui
-- со сдвигом назад — передний слой яркий с обводкой, задние темнее, получается «экструзия».
-- cf — центр надписи, лицом в -Z. height — высота букв в studs.
function ModelKit.Text3D(parent, text, cf, height, color, sideColor, opts)
	opts = opts or {}
	local n = utf8 and utf8.len(text) or #text
	local w = height * 0.68 * n + height * 0.4
	local layers = opts.Layers or 7
	local depth = opts.Depth or height * 0.32
	local model = Instance.new("Model")
	model.Name = "Text3D"
	model.Parent = parent
	local front = ModelKit.C(color)
	local side = sideColor and ModelKit.C(sideColor) or ModelKit.Shade(front, -0.45)
	for i = layers, 0, -1 do
		local p = Instance.new("Part")
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		p.Transparency = 1
		p.Size = Vector3.new(w, height, 0.05)
		p.CFrame = cf * CFrame.new(0, 0, depth * i / layers)
		p.Parent = model
		local gui = Instance.new("SurfaceGui")
		gui.Face = Enum.NormalId.Front
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 24
		gui.LightInfluence = i == 0 and 0.15 or 0.6
		gui.AlwaysOnTop = false
		gui.MaxDistance = opts.MaxDistance or 400
		gui.Parent = p
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.Size = UDim2.fromScale(1, 1)
		l.Font = Enum.Font.FredokaOne
		l.TextScaled = true
		l.Text = text
		l.TextColor3 = (i == 0) and front or side:Lerp(Color3.new(0, 0, 0), i / layers * 0.35)
		l.Parent = gui
		local st = Instance.new("UIStroke")
		st.Thickness = (i == 0) and 6 or 5
		st.Color = (i == 0) and ModelKit.C(opts.Outline or { 255, 255, 255 }) or side:Lerp(Color3.new(0, 0, 0), 0.4)
		st.LineJoinMode = Enum.LineJoinMode.Round
		st.Parent = l
		if i == 0 and opts.Gradient then
			local g = Instance.new("UIGradient")
			g.Color = ColorSequence.new(ModelKit.C(opts.Gradient[1]), ModelKit.C(opts.Gradient[2]))
			g.Rotation = 90
			g.Parent = l
		end
		-- сзади тоже читается (зеркальная надпись не нужна — делаем вторую сторону)
		if i == layers and opts.TwoSided then
			local back = gui:Clone()
			back.Face = Enum.NormalId.Back
			back.Parent = p
		end
	end
	return model
end

-- Гранёная «low-poly» глыба: блок, повёрнутый под случайными углами (грани дают разную тень)
function ModelKit.Facet(parent, size, pos, color, rng, props)
	rng = rng or Random.new()
	local cf = CFrame.new(pos) * CFrame.Angles(math.rad(rng:NextNumber(-28, 28)), rng:NextNumber() * math.pi * 2, math.rad(rng:NextNumber(-28, 28)))
	return ModelKit.Part(parent, size, cf, color, props)
end

return ModelKit]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000015"><Properties><string name="Name">NPCBuilder</string><ProtectedString name="Source"><![CDATA[-- NPCBuilder: квестовый робот Drill-Bot 3000.
-- Модель стоит на y = 0, смотрит в -Z. Детали "Eye", "Head", "Antenna", "Arm" анимирует клиент.
local MK = require(script.Parent.ModelKit)

local V3 = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local rad = math.rad

local NPCBuilder = {}

function NPCBuilder.DrillBot()
	local model = Instance.new("Model")
	model.Name = "DrillBot3000"
	local yellow = Color3.fromRGB(255, 196, 46)
	local dark = Color3.fromRGB(46, 44, 58)
	local steel = Color3.fromRGB(176, 182, 196)
	local screen = Color3.fromRGB(22, 30, 44)
	local cyan = Color3.fromRGB(90, 230, 255)

	local root = MK.Part(model, V3(1, 1, 1), CF(0, 3, 0), steel, { Name = "Root", Transparency = 1 })
	model.PrimaryPart = root

	-- гусеничная база
	for _, s in ipairs({ -1, 1 }) do
		MK.Part(model, V3(1.1, 1.3, 3.6), CF(s * 1.45, 0.65, 0), dark)
		for k = -1, 1 do
			MK.Cylinder(model, 1.16, 1.0, CF(s * 1.45, 0.6, k * 1.1), steel)
		end
		MK.Part(model, V3(1.16, 0.18, 3.7), CF(s * 1.45, 1.32, 0), yellow)
	end
	MK.Part(model, V3(2.0, 0.8, 2.6), CF(0, 1.1, 0), dark)

	-- корпус
	local body = MK.Part(model, V3(3.2, 2.6, 2.4), CF(0, 2.75, 0), yellow, { Name = "Body" })
	MK.Part(model, V3(3.3, 0.3, 2.5), CF(0, 1.55, 0), dark)
	MK.Part(model, V3(2.0, 1.2, 0.2), CF(0, 2.8, -1.25), screen)
	for i = -1, 1 do
		local c = (i == 0) and Color3.fromRGB(110, 230, 120) or ((i < 0) and Color3.fromRGB(255, 90, 90) or cyan)
		MK.Ellipsoid(model, V3(0.3, 0.3, 0.15), CF(i * 0.55, 2.55, -1.36), c, { Material = "Neon", Name = "Led" })
	end
	MK.Part(model, V3(1.4, 0.16, 0.12), CF(0, 3.1, -1.36), cyan, { Material = "Neon" })
	-- болты и полосы
	for _, x in ipairs({ -1.45, 1.45 }) do
		for _, y in ipairs({ 1.8, 3.7 }) do
			MK.Ellipsoid(model, V3(0.22, 0.22, 0.1), CF(x, y, -1.22), steel)
		end
	end
	for k = -2, 2 do
		MK.Wedge(model, V3(0.3, 0.4, 0.25), CF(k * 0.6, 3.95, -1.1) * ANG(0, 0, 0), dark)
	end

	-- шея и голова
	MK.Cylinder(model, 0.6, 0.9, CF(0, 4.3, 0) * ANG(0, 0, rad(90)), steel)
	local head = MK.Part(model, V3(2.6, 1.8, 2.0), CF(0, 5.4, 0), steel, { Name = "Head" })
	MK.Part(model, V3(2.2, 1.3, 0.12), CF(0, 5.4, -1.02), screen, { Name = "Visor" })
	for _, s in ipairs({ -1, 1 }) do
		local eye = MK.Ellipsoid(model, V3(0.5, 0.62, 0.12), CF(s * 0.5, 5.5, -1.1), cyan, { Material = "Neon", Name = "Eye" })
		eye:SetAttribute("BaseY", 0.62)
		MK.Cylinder(model, 0.3, 0.7, CF(s * 1.42, 5.4, 0), yellow)
	end
	MK.Ellipsoid(model, V3(0.7, 0.18, 0.1), CF(0, 5.05, -1.1), cyan, { Material = "Neon", Name = "Mouth" })
	-- каска с фонарём
	MK.Part(model, V3(2.8, 0.4, 2.2), CF(0, 6.45, 0), yellow)
	MK.Part(model, V3(3.1, 0.15, 2.5), CF(0, 6.3, -0.1), yellow)
	MK.Cylinder(model, 0.3, 0.6, CF(0, 6.5, -1.15) * ANG(0, rad(90), 0), Color3.fromRGB(255, 250, 210), { Material = "Neon" })
	-- антенна
	MK.Cylinder(model, 1.1, 0.12, CF(0.8, 7.2, 0.3) * ANG(0, 0, rad(90)), dark, { Name = "Antenna" })
	local bulb = MK.Ellipsoid(model, V3(0.4, 0.4, 0.4), CF(0.8, 7.8, 0.3), Color3.fromRGB(255, 80, 80), { Material = "Neon", Name = "AntennaBulb" })
	MK.Light(bulb, { 255, 80, 80 }, 6, 1)

	-- руки: левая — клешня, правая — бур
	for _, s in ipairs({ -1, 1 }) do
		local shoulder = V3(s * 1.85, 3.4, 0)
		MK.Ellipsoid(model, V3(0.9, 0.9, 0.9), CF(shoulder), dark, { Name = "Arm" })
		MK.CylinderBetween(model, shoulder, shoulder + V3(s * 0.3, -1.2, -0.5), 0.45, steel).Name = "Arm"
		local hand = shoulder + V3(s * 0.3, -1.4, -0.7)
		if s < 0 then
			MK.Part(model, V3(0.5, 0.25, 0.7), CF(hand + V3(0, 0.15, -0.2)), dark).Name = "Arm"
			MK.Part(model, V3(0.5, 0.25, 0.7), CF(hand + V3(0, -0.2, -0.2)), dark).Name = "Arm"
		else
			MK.Cylinder(model, 0.5, 0.75, CF(hand) * ANG(0, rad(90), 0), dark).Name = "Arm"
			local z = hand.Z - 0.25
			for i, d in ipairs({ 0.6, 0.42, 0.26 }) do
				MK.Cylinder(model, 0.35, d, CF(hand.X, hand.Y, z - 0.18) * ANG(0, rad(90), 0), steel, { Material = "Metal", Name = "DrillBit" })
				z = z - 0.32
			end
		end
	end

	model:SetAttribute("Npc", "DrillBot")
	return model
end

return NPCBuilder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000016"><Properties><string name="Name">Net</string><ProtectedString name="Source"><![CDATA[-- Net: создание и получение RemoteEvent/RemoteFunction в ReplicatedStorage.Remotes.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local EVENTS = {
	"MineBlock",      -- c->s: удар по блоку
	"HitResult",      -- s->c: результат удара (урон, крит)
	"BlockBroken",    -- s->c: блок сломан (для VFX)
	"SystemAlert",    -- s->c: баннеры вайпа, уведомления
	"DataSync",       -- s->c: снимок данных игрока
	"TeleportBase",   -- c->s: каст телепорта на базу
	"Notify",         -- s->c: тосты
	"CoinsGained",    -- s->c: всплывающие монеты
	"Tutorial",       -- c->s: шаг обучения новичка
	"SaveSettings",   -- c->s: настройки (графика, громкость)
}

local FUNCTIONS = {
	"SellBackpack", "OpenEgg", "UseBoost",
	"BuyItem", "EquipItem", "PetAction",
	"Incubator", "ClaimQuest", "Rebirth", "BuyPerk", "Travel", "RequestSync",
	"ClaimDaily", "SpinWheel", "AdminCommand", "BuyPetStorage",
}

local Net = {}
local folder

local function getFolder()
	if folder then
		return folder
	end
	if RunService:IsServer() then
		folder = ReplicatedStorage:FindFirstChild("Remotes")
		if not folder then
			folder = Instance.new("Folder")
			folder.Name = "Remotes"
			folder.Parent = ReplicatedStorage
		end
		for _, name in ipairs(EVENTS) do
			if not folder:FindFirstChild(name) then
				local r = Instance.new("RemoteEvent")
				r.Name = name
				r.Parent = folder
			end
		end
		for _, name in ipairs(FUNCTIONS) do
			if not folder:FindFirstChild(name) then
				local r = Instance.new("RemoteFunction")
				r.Name = name
				r.Parent = folder
			end
		end
	else
		folder = ReplicatedStorage:WaitForChild("Remotes")
	end
	return folder
end

function Net.Init()
	getFolder()
end

function Net.Get(name)
	local f = getFolder()
	if RunService:IsServer() then
		return f:FindFirstChild(name)
	end
	return f:WaitForChild(name)
end

return Net
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000017"><Properties><string name="Name">PetBuilder</string><ProtectedString name="Source"><![CDATA[-- PetBuilder: процедурная сборка chibi-питомцев в стиле популярных симуляторов.
-- Каждый питомец = архетип (силуэт) + набор деталей из PetLooks.
-- Модель смотрит в -Z, ноги на y = 0, Root (pivot) в (0, 1, 0).
local Configs = script.Parent.Parent:WaitForChild("Configs")
local PetLooks = require(Configs.PetLooks)
local PetsData = require(Configs.PetsData)
local MK = require(script.Parent.ModelKit)

local V3 = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local rad = math.rad

local PetBuilder = {}

local WHITE = Color3.fromRGB(255, 255, 255)
local INK = Color3.fromRGB(26, 22, 36)
local IVORY = Color3.fromRGB(250, 242, 222)
local PINK = Color3.fromRGB(255, 150, 170)
local GOLD = Color3.fromRGB(255, 205, 60)

-- Размер по редкости: мифики и эксклюзивы примерно в 2 раза больше обычных, «Огромные» — в 3 раза
local RARITY_SCALE = { Common = 1, Uncommon = 1.05, Rare = 1.1, Epic = 1.16, Legendary = 1.3, Mythic = 2.2, Secret = 2, Huge = 3 }

---------------------------------------------------------------------------------------------
-- Контекст сборки
---------------------------------------------------------------------------------------------
local ctx

local function colorOf(key)
	if typeof(key) == "Color3" then
		return key, "Fixed"
	elseif type(key) == "table" then
		return MK.C(key), "Fixed"
	elseif key == "C" then
		return ctx.C, "C"
	elseif key == "Cd" then
		return ctx.Cd, "Cd"
	elseif key == "C2" then
		return ctx.C2, "C2"
	elseif key == "C3" then
		return ctx.C3, "C3"
	end
	return ctx.C, "C"
end

local function matFor(paint, opts)
	if opts and opts.Material then
		return opts.Material
	end
	if paint == "C" or paint == "Cd" then
		return ctx.mat
	elseif paint == "C2" then
		return ctx.mat2
	end
	return "SmoothPlastic"
end

local function finish(p, paint, opts)
	p:SetAttribute("Paint", paint)
	p.Material = MK.Mat(matFor(paint, opts))
	if p.Material == Enum.Material.Glass and not (opts and opts.Transparency) then
		p.Transparency = 0.2
	end
	if opts then
		if opts.Transparency then
			p.Transparency = opts.Transparency
		end
		if opts.NoShadow then
			p.CastShadow = false
		end
	end
	if p.Size.Magnitude < 0.8 then
		p.CastShadow = false
	end
	return p
end

-- Эллипсоид
local function E(size, cf, color, opts)
	if typeof(cf) == "Vector3" then
		cf = CF(cf)
	end
	local c, paint = colorOf(color)
	local p = MK.Ellipsoid(ctx.model, size, cf, c)
	return finish(p, paint, opts)
end

-- Блок
local function B(size, cf, color, opts)
	if typeof(cf) == "Vector3" then
		cf = CF(cf)
	end
	local c, paint = colorOf(color)
	local p = MK.Part(ctx.model, size, cf, c)
	return finish(p, paint, opts)
end

-- Цилиндр между точками
local function Cyl(a, b, d, color, opts)
	local c, paint = colorOf(color)
	local p = MK.CylinderBetween(ctx.model, a, b, d, c)
	return finish(p, paint, opts)
end

-- Равнобедренный треугольник в плоскости XY фрейма cf (вершина вверх).
local function Tri(cf, w, h, t, color, opts)
	local c, paint = colorOf(color)
	local a = MK.Wedge(ctx.model, V3(t, h, w / 2), cf * CF(-w / 4, 0, 0) * ANG(0, rad(90), 0), c)
	local b = MK.Wedge(ctx.model, V3(t, h, w / 2), cf * CF(w / 4, 0, 0) * ANG(0, rad(-90), 0), c)
	finish(a, paint, opts)
	finish(b, paint, opts)
	return a, b
end

-- Конус из трёх цилиндров, от base в направлении dir.
local function Cone(base, dir, len, d, color, opts)
	dir = dir.Unit
	local p1 = base
	local steps = { { 0.45, 1 }, { 0.32, 0.7 }, { 0.23, 0.42 } }
	local last
	for _, s in ipairs(steps) do
		local p2 = p1 + dir * len * s[1]
		last = Cyl(p1, p2, d * s[2], color, opts)
		p1 = p2 - dir * len * 0.03
	end
	E(V3(d * 0.3, d * 0.3, d * 0.3), p1 + dir * len * 0.02, color, opts)
	return last
end

-- Скруглённый куб (как у питомцев популярных симуляторов): 3 перекрещенных блока,
-- 12 цилиндров по рёбрам и 8 сфер в углах. r — радиус скругления.
local function RoundBox(size, cf, color, r, opts)
	r = math.min(r, size.X / 2.2, size.Y / 2.2, size.Z / 2.2)
	local x, y, z = size.X / 2 - r, size.Y / 2 - r, size.Z / 2 - r
	local d = r * 2
	B(V3(size.X, size.Y - d, size.Z - d), cf, color, opts)
	B(V3(size.X - d, size.Y, size.Z - d), cf, color, opts)
	B(V3(size.X - d, size.Y - d, size.Z), cf, color, opts)
	local c, paint = colorOf(color)
	local function cyl(len, lcf)
		local p = MK.Cylinder(ctx.model, len, d, cf * lcf, c)
		finish(p, paint, opts)
	end
	for _, sy in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			cyl(size.X - d, CF(0, sy * y, sz * z))
		end
	end
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			cyl(size.Y - d, CF(sx * x, 0, sz * z) * ANG(0, 0, rad(90)))
		end
		for _, sy in ipairs({ -1, 1 }) do
			cyl(size.Z - d, CF(sx * x, sy * y, 0) * ANG(0, rad(90), 0))
		end
	end
	for _, sx in ipairs({ -1, 1 }) do
		for _, sy in ipairs({ -1, 1 }) do
			for _, sz in ipairs({ -1, 1 }) do
				E(V3(d, d, d), cf * CF(sx * x, sy * y, sz * z), color, opts)
			end
		end
	end
end

-- Z передней поверхности эллипсоида головы в точке (x, y)
local function surfZ(a, x, y)
	local hx, hy, hz = a.hs.X, a.hs.Y, a.hs.Z
	if a.flat then
		return a.hc.Z - hz
	end
	local k = 1 - (x / hx) ^ 2 - (y / hy) ^ 2
	if k < 0.05 then
		k = 0.05
	end
	return a.hc.Z - hz * math.sqrt(k)
end

-- Точка на лице: смещения относительно центра головы
local function faceAt(a, x, y, out)
	return V3(a.hc.X + x, a.hc.Y + y, surfZ(a, x, y) - (out or 0))
end

---------------------------------------------------------------------------------------------
-- Архетипы
---------------------------------------------------------------------------------------------
local ARCH = {}

ARCH.quad = function(look)
	-- chibi-пропорции: крупная голова, маленькое туловище, круглые лапки
	local long = look.Long and 0.55 or 0
	E(V3(1.55, 1.25, 1.75 + long), V3(0, 0.95, 0.45 + long / 2), "C")
	E(V3(1.0, 0.8, 0.5), V3(0, 0.92, -0.3), "C2")
	local hc = V3(0, 1.95, -0.55)
	local hs = V3(2.15, 1.95, 1.85)
	E(hs, hc, "C")
	if not (ctx.has.snout or ctx.has.trunk or ctx.has.stripe_head or ctx.has.nose_big) then
		E(V3(1.05, 0.66, 0.55), hc + V3(0, -0.42, -0.72), "C2")
	end
	local front = { V3(-0.5, 0.26, -0.1), V3(0.5, 0.26, -0.1) }
	for _, p in ipairs(front) do
		E(V3(0.56, 0.52, 0.66), p, "Cd")
		E(V3(0.4, 0.14, 0.24), p + V3(0, -0.14, -0.28), "C2")
	end
	E(V3(0.56, 0.52, 0.66), V3(-0.5, 0.26, 1.05 + long), "Cd")
	E(V3(0.56, 0.52, 0.66), V3(0.5, 0.26, 1.05 + long), "Cd")
	return {
		hc = hc, hs = hs / 2, eyeY = 0.1,
		back = V3(0, 1.55, 0.5 + long / 2), tail = V3(0, 1.05, 1.3 + long),
		side = 0.78, wingY = 1.5, front = front, top = hc + V3(0, 0.97, 0),
		bodyC = V3(0, 0.95, 0.45 + long / 2), bodyS = V3(0.78, 0.62, 0.88 + long / 2),
	}
end

ARCH.blob = function(look)
	local hc = V3(0, 1.05, 0)
	local hs = V3(2.3, 2.1, 2.2)
	E(hs, hc, "C")
	E(V3(0.62, 0.3, 0.75), V3(-0.55, 0.12, -0.35), "Cd")
	E(V3(0.62, 0.3, 0.75), V3(0.55, 0.12, -0.35), "Cd")
	return {
		hc = hc, hs = hs / 2, eyeY = 0.18,
		back = V3(0, 2.05, 0.25), tail = V3(0, 0.75, 1.05),
		side = 1.15, wingY = 1.2, front = { V3(-0.55, 0.12, -0.6), V3(0.55, 0.12, -0.6) },
		top = hc + V3(0, 1.05, 0), bodyC = hc, bodyS = hs / 2,
	}
end

ARCH.bird = function(look)
	local hc = V3(0, 1.2, 0.05)
	local hs = V3(1.9, 2.05, 1.85)
	E(hs, hc, "C")
	E(V3(1.35, 1.45, 1.0), V3(0, 1.0, -0.42), "C2")
	local feet = Color3.fromRGB(255, 170, 60)
	E(V3(0.36, 0.16, 0.52), V3(-0.35, 0.08, -0.2), feet)
	E(V3(0.36, 0.16, 0.52), V3(0.35, 0.08, -0.2), feet)
	if not (ctx.has.wings_feather or ctx.has.wings_bat or ctx.has.wings_crystal or ctx.has.flippers) then
		E(V3(0.35, 1.05, 1.15), CF(-0.98, 1.15, 0.2) * ANG(0, 0, rad(-12)), "Cd")
		E(V3(0.35, 1.05, 1.15), CF(0.98, 1.15, 0.2) * ANG(0, 0, rad(12)), "Cd")
	end
	return {
		hc = hc, hs = hs / 2, eyeY = 0.35,
		back = V3(0, 2.15, 0.25), tail = V3(0, 0.85, 0.95),
		side = 0.95, wingY = 1.25, front = {}, top = hc + V3(0, 1.0, 0),
		bodyC = hc, bodyS = hs / 2,
	}
end

ARCH.bat = function(look)
	local hc = V3(0, 1.55, 0)
	local hs = V3(1.6, 1.5, 1.45)
	E(hs, hc, "C")
	E(V3(1.0, 0.9, 0.6), V3(0, 1.35, -0.45), "C2")
	ctx.has.wings_bat = true
	return {
		hc = hc, hs = hs / 2, eyeY = 0.16,
		back = V3(0, 2.25, 0.2), tail = V3(0, 1.2, 0.7),
		side = 0.8, wingY = 1.6, front = {}, top = hc + V3(0, 0.75, 0),
		bodyC = hc, bodyS = hs / 2,
	}
end

ARCH.bug = function(look)
	E(V3(1.9, 1.05, 2.3), V3(0, 0.85, 0.3), "C")
	if not ctx.has.segments then
		B(V3(0.07, 0.1, 2.0), CF(0, 1.36, 0.32), INK, { Transparency = 0.3 })
	end
	local hc = V3(0, 0.88, -0.95)
	local hs = V3(1.3, 1.0, 1.0)
	E(hs, hc, "C3")
	for _, z in ipairs({ -0.3, 0.3, 0.9 }) do
		for _, s in ipairs({ -1, 1 }) do
			Cyl(V3(s * 0.7, 0.6, z), V3(s * 1.2, 0.04, z - 0.1), 0.17, "Cd")
		end
	end
	return {
		hc = hc, hs = hs / 2, eyeY = 0.05,
		back = V3(0, 1.38, 0.3), tail = V3(0, 0.8, 1.45),
		side = 0.95, wingY = 1.2, front = {}, top = hc + V3(0, 0.5, 0),
		bodyC = V3(0, 0.85, 0.3), bodyS = V3(0.95, 0.52, 1.15),
	}
end

ARCH.crab = function(look)
	E(V3(2.4, 1.15, 1.7), V3(0, 0.95, 0), "C")
	E(V3(1.6, 0.5, 1.1), V3(0, 0.62, -0.1), "C2")
	for _, s in ipairs({ -1, 1 }) do
		Cyl(V3(s * 1.0, 0.95, -0.35), V3(s * 1.4, 1.0, -0.7), 0.3, "Cd")
		E(V3(0.9, 0.75, 1.05), V3(s * 1.5, 1.05, -0.95), "C")
		E(V3(0.4, 0.35, 0.6), V3(s * 1.3, 1.25, -1.45), "C")
		for i, z in ipairs({ -0.2, 0.2, 0.55 }) do
			Cyl(V3(s * 1.0, 0.75, z), V3(s * 1.55, 0.04, z + 0.15), 0.15, "Cd")
		end
		Cyl(V3(s * 0.4, 1.3, -0.55), V3(s * 0.45, 1.85, -0.6), 0.14, "Cd")
		E(V3(0.5, 0.5, 0.5), V3(s * 0.45, 1.95, -0.6), WHITE)
		E(V3(0.3, 0.32, 0.2), V3(s * 0.45, 1.95, -0.82), INK)
		E(V3(0.1, 0.1, 0.06), V3(s * 0.45 + 0.07, 2.04, -0.92), WHITE)
	end
	return {
		hc = V3(0, 1.0, -0.2), hs = V3(1.0, 0.5, 0.75), noEyes = true,
		back = V3(0, 1.5, 0), tail = V3(0, 0.9, 0.85),
		side = 1.2, wingY = 1.2, front = {}, top = V3(0, 1.55, 0),
		bodyC = V3(0, 0.95, 0), bodyS = V3(1.2, 0.58, 0.85),
	}
end

ARCH.fish = function(look)
	local size = look.Narrow and V3(1.3, 1.15, 3.0) or V3(1.6, 1.1, 2.6)
	local bc = V3(0, 1.2, 0)
	E(size, bc, "C")
	E(V3(size.X * 0.7, size.Y * 0.5, size.Z * 0.75), bc + V3(0, -0.25, 0), "C2")
	if look.Wide then
		E(V3(3.8, 0.22, 1.9), CF(0, 1.1, 0.15), "C2")
	else
		E(V3(0.75, 0.14, 0.85), CF(-0.85, 1.05, 0.15) * ANG(0, rad(-25), rad(-20)), "Cd")
		E(V3(0.75, 0.14, 0.85), CF(0.85, 1.05, 0.15) * ANG(0, rad(25), rad(20)), "Cd")
	end
	if not (ctx.has.tail_fluke or ctx.has.tail_whip) then
		E(V3(0.18, 1.0, 0.75), CF(0, 1.3, size.Z / 2 + 0.2) * ANG(rad(-20), 0, 0), "Cd")
	end
	return {
		hc = bc, hs = size / 2, eyeY = 0.18,
		back = bc + V3(0, size.Y / 2, 0), tail = bc + V3(0, 0, size.Z / 2),
		side = size.X / 2, wingY = 1.2, front = {}, top = bc + V3(0, size.Y / 2, -0.4),
		bodyC = bc, bodyS = size / 2,
	}
end

ARCH.dino = function(look)
	E(V3(1.75, 1.5, 2.3), V3(0, 1.1, 0.3), "C")
	E(V3(1.2, 1.0, 1.45), V3(0, 0.95, -0.1), "C2")
	local hc, hs
	if ctx.has.long_neck then
		hc = V3(0, 3.05, -1.45)
		hs = V3(1.25, 1.1, 1.3)
		Cyl(V3(0, 1.6, -0.55), V3(0, 2.75, -1.3), 0.75, "C")
		E(V3(0.8, 0.8, 1.0), V3(0, 2.2, -0.9), "C")
	elseif ctx.has.big_head then
		hc = V3(0, 2.1, -1.1)
		hs = V3(1.8, 1.6, 1.9)
	else
		hc = V3(0, 2.0, -1.0)
		hs = V3(1.75, 1.55, 1.7)
	end
	E(hs, hc, "C")
	E(V3(hs.X * 0.68, hs.Y * 0.55, hs.Z * 0.55), hc + V3(0, -0.22, -hs.Z * 0.45), "C")
	if look.Biped then
		E(V3(0.65, 0.85, 0.75), V3(-0.55, 0.42, 0.55), "Cd")
		E(V3(0.65, 0.85, 0.75), V3(0.55, 0.42, 0.55), "Cd")
	else
		for _, p in ipairs({ V3(-0.55, 0.35, -0.35), V3(0.55, 0.35, -0.35), V3(-0.55, 0.35, 0.95), V3(0.55, 0.35, 0.95) }) do
			E(V3(0.55, 0.7, 0.6), p, "Cd")
		end
	end
	E(V3(0.75, 0.7, 1.6), CF(0, 1.0, 1.75) * ANG(rad(8), 0, 0), "C")
	E(V3(0.42, 0.42, 0.95), CF(0, 0.85, 2.5) * ANG(rad(12), 0, 0), "C")
	return {
		hc = hc, hs = hs / 2, eyeY = 0.12,
		back = V3(0, 1.82, 0.3), tail = V3(0, 0.85, 2.9),
		side = 0.88, wingY = 1.7, front = { V3(-0.55, 0.35, -0.35), V3(0.55, 0.35, -0.35) },
		top = hc + V3(0, hs.Y / 2, 0), bodyC = V3(0, 1.1, 0.3), bodyS = V3(0.88, 0.75, 1.15),
	}
end

ARCH.dragon = ARCH.dino

ARCH.golem = function(look)
	-- округлый "плюшевый" голем: всё из эллипсоидов
	E(V3(2.0, 1.75, 1.6), V3(0, 1.45, 0), "C")
	E(V3(1.2, 0.9, 0.4), V3(0, 1.45, -0.68), "C2")
	local hc = V3(0, 2.7, -0.08)
	local hs = V3(1.8, 1.55, 1.55)
	E(hs, hc, "C")
	for _, s in ipairs({ -1, 1 }) do
		E(V3(0.8, 1.25, 0.85), CF(s * 1.25, 1.45, -0.05) * ANG(0, 0, rad(s * -10)), "Cd")
		E(V3(0.95, 0.8, 0.95), V3(s * 1.4, 0.72, -0.12), "C3")
		E(V3(0.78, 0.7, 0.85), V3(s * 0.5, 0.35, 0), "Cd")
	end
	return {
		hc = hc, hs = hs / 2, eyeY = 0.06,
		back = V3(0, 2.25, 0.35), tail = V3(0, 1.2, 0.75),
		side = 1.0, wingY = 2.0, front = { V3(-1.4, 0.4, -0.5), V3(1.4, 0.4, -0.5) },
		top = hc + V3(0, 0.75, 0), shoulders = { V3(-1.05, 2.15, 0), V3(1.05, 2.15, 0) },
		bodyC = V3(0, 1.45, 0), bodyS = V3(1.0, 0.85, 0.8),
	}
end

ARCH.orb = function(look)
	local hc = V3(0, 1.75, 0)
	local hs = V3(1.95, 1.95, 1.95)
	E(hs, hc, "C")
	if look.M ~= "Neon" then
		E(hs * 0.82, hc + V3(0, -0.15, -0.12), "C2", { Transparency = 0.6 })
	end
	return {
		hc = hc, hs = hs / 2, eyeY = 0.1,
		back = hc + V3(0, 0.95, 0), tail = hc + V3(0, 0, 0.95),
		side = 1, wingY = 1.75, front = {}, top = hc + V3(0, 0.98, 0),
		bodyC = hc, bodyS = hs / 2,
	}
end

ARCH.serpent = function(look)
	local fly = look.Fly ~= false
	local dy = fly and 0 or -0.58
	local hc = V3(0, 1.55 + dy, -1.15)
	local hs = V3(1.55, 1.35, 1.45)
	E(hs, hc, "C")
	local segs = {
		{ V3(0, 1.25 + dy, -0.25), 1.25 },
		{ V3(0, 1.5 + dy, 0.6), 1.1 },
		{ V3(0, 1.25 + dy, 1.35), 0.95 },
		{ V3(0, 1.45 + dy, 2.0), 0.8 },
		{ V3(0, 1.25 + dy, 2.55), 0.62 },
	}
	for i, s in ipairs(segs) do
		local col = (i % 2 == 0) and "C2" or "C"
		if not fly then
			col = (i % 2 == 0) and "Cd" or "C"
		end
		E(V3(s[2], s[2], s[2] * 1.05), s[1], col)
	end
	return {
		hc = hc, hs = hs / 2, eyeY = 0.12,
		back = V3(0, 2.0 + dy, -0.25), tail = segs[5][1],
		side = 0.7, wingY = 1.6 + dy, front = {}, top = hc + V3(0, 0.68, 0),
		segs = segs, bodyC = segs[2][1], bodyS = V3(0.6, 0.6, 1.2),
	}
end

ARCH.wisp = function(look)
	local hc = V3(0, 1.65, 0)
	local hs = V3(1.85, 1.8, 1.8)
	E(hs, hc, "C", { Transparency = look.M == "Neon" and 0 or 0.3 })
	E(V3(0.95, 0.95, 0.95), hc + V3(0, -0.05, 0.1), "C2", { Material = "Neon", Transparency = 0.15 })
	E(V3(0.9, 1.3, 0.9), CF(hc + V3(0, -0.85, 0.55)) * ANG(rad(-50), 0, 0), "C", { Transparency = look.M == "Neon" and 0 or 0.3 })
	MK.Light(ctx.root, ctx.C2, 8, 1.2)
	return {
		hc = hc, hs = hs / 2, eyeY = 0.12,
		back = hc + V3(0, 0.9, 0.1), tail = hc + V3(0, -0.6, 0.9),
		side = 0.92, wingY = 1.6, front = {}, top = hc + V3(0, 0.9, 0),
		bodyC = hc, bodyS = hs / 2,
	}
end

-- Кубический питомец в стиле Pet Simulator: скруглённый куб-голова-тело и маленькие лапки.
-- kind — исходный архетип (quad/blob/bird/bat/golem): от него зависят пропорции и лапы.
ARCH.cube = function(look, kind)
	kind = kind or "quad"
	local size = V3(2.3, 2.15, 2.15)
	local footH = 0.42
	if kind == "blob" then
		size = V3(2.5, 1.95, 2.35)
		footH = 0.05
	elseif kind == "golem" then
		size = V3(2.6, 2.4, 2.3)
	elseif kind == "bird" or kind == "bat" then
		size = V3(2.2, 2.1, 2.0)
		footH = 0.32
	end
	if look.Long then
		size = size + V3(0, 0, 0.5)
	end
	if look.Box then
		size = V3(look.Box[1], look.Box[2], look.Box[3])
	end
	local hc = V3(0, footH + size.Y / 2, 0)
	local r = kind == "blob" and 0.75 or 0.42
	RoundBox(size, CF(hc), "C", r)
	-- светлая «мордочка»/животик на передней грани
	if not (ctx.has.snout or ctx.has.trunk or ctx.has.stripe_head or ctx.has.nose_big or ctx.has.eye_single) then
		E(V3(size.X * 0.48, size.Y * 0.3, 0.16), hc + V3(0, -size.Y * 0.24, -size.Z / 2 - 0.01), "C2")
	end
	local front = {}
	if kind == "bird" then
		local feet = Color3.fromRGB(255, 170, 60)
		for _, sx in ipairs({ -1, 1 }) do
			E(V3(0.42, 0.22, 0.6), V3(sx * 0.42, 0.12, -0.2), feet)
		end
		if not (ctx.has.wings_feather or ctx.has.wings_bat or ctx.has.wings_crystal) then
			for _, sx in ipairs({ -1, 1 }) do
				E(V3(0.3, 1.1, 1.2), CF(sx * (size.X / 2 + 0.08), hc.Y - 0.1, 0.1) * ANG(0, 0, rad(sx * -10)), "Cd")
			end
		end
	elseif kind == "golem" then
		for _, sx in ipairs({ -1, 1 }) do
			RoundBox(V3(0.75, 1.35, 0.8), CF(sx * (size.X / 2 + 0.35), hc.Y - 0.2, -0.1) * ANG(0, 0, rad(sx * 8)), "Cd", 0.3)
			RoundBox(V3(0.75, 0.6, 0.85), CF(sx * 0.62, 0.3, 0), "C3", 0.25)
		end
	elseif kind ~= "blob" then
		for _, sx in ipairs({ -1, 1 }) do
			for _, sz in ipairs({ -1, 1 }) do
				local p = V3(sx * (size.X / 2 - 0.45), footH * 0.55, sz * (size.Z / 2 - 0.45))
				E(V3(0.6, footH * 1.4 + 0.15, 0.62), p, "Cd")
				if sz < 0 then
					table.insert(front, p)
				end
			end
		end
	end
	return {
		hc = hc, hs = size / 2, flat = true, eyeY = 0.1,
		back = hc + V3(0, size.Y / 2, 0.35), tail = hc + V3(0, -size.Y * 0.2, size.Z / 2),
		side = size.X / 2, wingY = hc.Y + 0.2, front = front, top = hc + V3(0, size.Y / 2, 0),
		bodyC = hc, bodyS = size / 2,
	}
end

-- Мифик: крупный кубический или сферический (Body = "orb") питомец + эффекты (см. mythicFx)
ARCH.mythic = function(look)
	local m = look.Mythic or {}
	if m.Body == "orb" then
		return ARCH.orb(look)
	end
	return ARCH.cube(look, m.Kind or "quad")
end

---------------------------------------------------------------------------------------------
-- Глаза
---------------------------------------------------------------------------------------------
-- Глаза в стиле аниме: белок, цветная радужка с переходом, зрачок и два блика.
local IRIS = {
	Color3.fromRGB(255, 176, 40), Color3.fromRGB(90, 200, 90), Color3.fromRGB(70, 160, 255),
	Color3.fromRGB(170, 100, 255), Color3.fromRGB(255, 110, 150), Color3.fromRGB(60, 210, 200),
}
local function buildEyes(look, a)
	if a.noEyes or ctx.has.eye_single then
		return
	end
	local w = a.hs.X * 2
	local style = look.E
	local size = math.clamp(w * 0.3, 0.32, 0.72)
	if style == "small" then
		size = size * 0.75
	elseif style == "big" then
		size = size * 1.18
	end
	local ex = w * 0.22
	local ey = (a.eyeY or 0.1) * a.hs.Y * 2
	-- у «Огромных» всегда живые аниме-глаза с цветной радужкой (так милее), у мификов — светящиеся
	local glow = (style == "glow" or (look.Mythic ~= nil)) and not look.Huge and not look.CuteEyes
	local iris = look.Iris and MK.C(look.Iris) or (look.EyeColor and MK.C(look.EyeColor)) or IRIS[(ctx.hash % #IRIS) + 1]
	for _, sx in ipairs({ -1, 1 }) do
		local pos = faceAt(a, sx * ex, ey, 0.02)
		local n
		if a.flat then
			n = V3(0, 0, -1)
		else
			n = ((pos - a.hc) * V3(0.35, 0.2, 1)).Unit
		end
		local f = CF(pos, pos + n)
		local h = size * 1.28
		if glow then
			local ec = look.EyeColor and MK.C(look.EyeColor) or iris
			E(V3(size * 1.08, h * 1.05, 0.12), f, INK)
			E(V3(size * 0.9, h * 0.88, 0.14), f * CF(0, 0, -0.02), ec, { Material = "Neon" })
			E(V3(size * 0.36, h * 0.5, 0.12), f * CF(0, -h * 0.02, -0.05), Color3.new(1, 1, 1), { Material = "Neon" })
		else
			-- тёмная обводка + белок
			E(V3(size * 1.06, h * 1.04, 0.1), f, INK)
			E(V3(size * 0.92, h * 0.9, 0.12), f * CF(0, 0, -0.015), WHITE)
			-- радужка: тёмный низ и светлый верх (переход)
			E(V3(size * 0.78, h * 0.78, 0.12), f * CF(0, -h * 0.04, -0.035), iris:Lerp(INK, 0.35))
			E(V3(size * 0.62, h * 0.5, 0.12), f * CF(0, h * 0.06, -0.045), iris:Lerp(WHITE, 0.15))
			-- зрачок
			E(V3(size * 0.38, h * 0.46, 0.12), f * CF(0, -h * 0.02, -0.06), INK)
			-- блики
			E(V3(size * 0.32, size * 0.32, 0.1), f * CF(-sx * size * 0.16, h * 0.2, -0.08), WHITE)
			E(V3(size * 0.15, size * 0.15, 0.1), f * CF(sx * size * 0.17, -h * 0.2, -0.08), WHITE)
		end
	end
	local beaked = ctx.has.beak or ctx.has.beak_long or ctx.has.snout or ctx.has.trunk
	-- румянец
	for _, sx in ipairs({ -1, 1 }) do
		local pos = faceAt(a, sx * w * 0.37, ey - size * 0.9, -0.02)
		E(V3(size * 0.7, size * 0.34, 0.08), pos, PINK, { Transparency = ctx.has.cheeks and 0.05 or 0.35 })
	end
	if not beaked then
		-- ротик «ω»
		local my = ey - size * 1.0
		for _, sx in ipairs({ -1, 1 }) do
			local pos = faceAt(a, sx * size * 0.15, my, 0.02)
			B(V3(size * 0.32, size * 0.08, 0.06), CF(pos) * ANG(0, 0, rad(sx * -28)), Color3.fromRGB(70, 34, 44))
		end
	end
	a.eyeSize = size
	a.eyeYabs = ey
end

---------------------------------------------------------------------------------------------
-- Детали
---------------------------------------------------------------------------------------------
local X = {}

local function ears(a, k, pointy)
	for _, s in ipairs({ -1, 1 }) do
		local base = a.hc + V3(s * a.hs.X * 0.62, a.hs.Y * 0.78, 0.08)
		if pointy then
			local cf = CF(base + V3(0, 0.3 * k, 0)) * ANG(0, 0, rad(s * -14))
			Tri(cf, 0.62 * k, 0.8 * k, 0.22, "C")
			Tri(cf * CF(0, -0.06 * k, -0.08), 0.36 * k, 0.5 * k, 0.12, "C2")
		else
			E(V3(0.62 * k, 0.62 * k, 0.26), CF(base + V3(0, 0.12 * k, 0)) * ANG(0, 0, rad(s * -18)), "C")
			E(V3(0.38 * k, 0.38 * k, 0.12), CF(base + V3(0, 0.12 * k, -0.11)) * ANG(0, 0, rad(s * -18)), "C2")
		end
	end
end

X.ears_round = function(look, a) ears(a, 1, false) end
X.ears_round_big = function(look, a) ears(a, 1.45, false) end
X.ears_pointy = function(look, a) ears(a, 1, true) end
X.ears_pointy_big = function(look, a) ears(a, 1.4, true) end

X.ears_long = function(look, a)
	for _, s in ipairs({ -1, 1 }) do
		local cf = CF(a.hc + V3(s * 0.38, a.hs.Y + 0.55, 0.12)) * ANG(rad(-8), 0, rad(s * -10))
		E(V3(0.46, 1.5, 0.32), cf, "C")
		E(V3(0.26, 1.1, 0.12), cf * CF(0, 0, -0.12), PINK)
	end
end

X.ear_tufts = function(look, a)
	for _, s in ipairs({ -1, 1 }) do
		Tri(CF(a.hc + V3(s * a.hs.X * 0.62, a.hs.Y * 0.95, 0)) * ANG(0, 0, rad(s * -22)), 0.4, 0.6, 0.18, "Cd")
	end
end

X.tail_thin = function(look, a)
	local p1 = a.tail
	local p2 = p1 + V3(0, 0.35, 0.65)
	local p3 = p2 + V3(0, 0.45, 0.25)
	Cyl(p1, p2, 0.2, "C")
	Cyl(p2, p3, 0.16, "C")
	E(V3(0.26, 0.26, 0.26), p3, ctx.has.flame_tail and "C2" or "C", ctx.has.flame_tail and { Material = "Neon" } or nil)
end

X.tail_long = function(look, a)
	E(V3(0.62, 0.5, 1.3), CF(a.tail + V3(0, -0.15, 0.45)) * ANG(rad(10), 0, 0), "C")
	E(V3(0.42, 0.36, 1.1), CF(a.tail + V3(0, -0.35, 1.3)) * ANG(rad(8), 0, 0), "C")
	E(V3(0.26, 0.24, 0.7), a.tail + V3(0, -0.45, 1.95), "C")
end

X.tail_fluffy = function(look, a)
	local cf = CF(a.tail + V3(0, 0.45, 0.6)) * ANG(rad(40), 0, 0)
	E(V3(0.85, 0.85, 1.55), cf, "C")
	E(V3(0.6, 0.6, 0.65), cf * CF(0, 0, 0.62), "C2")
end

X.tails_multi = function(look, a)
	-- три пушистых хвоста веером (кицунэ)
	for i, ang in ipairs({ -38, 0, 38 }) do
		local cf = CF(a.tail) * ANG(0, rad(ang), 0) * ANG(rad(40), 0, 0) * CF(0, 0.15, 0.75)
		E(V3(0.8, 0.8, 1.6), cf, "C")
		E(V3(0.62, 0.62, 0.7), cf * CF(0, 0, 0.7), "C2", { Material = "Neon", Transparency = 0.1 })
	end
end

X.bell = function(look, a)
	local gold = Color3.fromRGB(255, 205, 60)
	local y = a.hc.Y - a.hs.Y * 0.95
	E(V3(a.hs.X * 1.5, 0.22, a.hs.Z * 1.4), V3(0, y + 0.05, a.hc.Z + 0.1), Color3.fromRGB(230, 50, 70))
	E(V3(0.5, 0.5, 0.5), V3(0, y - 0.15, a.hc.Z - a.hs.Z * 0.62), gold, { Material = "Metal" })
end

X.tail_puff = function(look, a)
	E(V3(0.75, 0.75, 0.75), a.tail + V3(0, 0.15, 0.05), ctx.has.tail_puff and "C2" or "C")
end

X.tail_spikes = function(look, a)
	for _, s in ipairs({ -1, 1 }) do
		Tri(CF(a.tail + V3(s * 0.22, 0.35, -0.1)) * ANG(0, 0, rad(s * -35)), 0.3, 0.7, 0.15, IVORY)
	end
end

X.club_tail = function(look, a)
	E(V3(0.9, 0.7, 0.9), a.tail + V3(0, 0.05, 0.2), "C3")
	for _, s in ipairs({ -1, 1 }) do
		Tri(CF(a.tail + V3(s * 0.48, 0.05, 0.2)) * ANG(0, 0, rad(s * -90)), 0.3, 0.45, 0.15, IVORY)
	end
end

X.tail_feathers = function(look, a)
	for i, ang in ipairs({ -28, 0, 28 }) do
		local col = (i == 2) and "C2" or "C"
		E(V3(0.42, 0.14, 1.3), CF(a.tail) * ANG(rad(-20), rad(ang), 0) * CF(0, 0, 0.6), col)
	end
end

X.tail_fluke = function(look, a)
	E(V3(1.5, 0.16, 0.65), CF(a.tail + V3(0, 0.1, 0.25)), "Cd")
end

X.tail_whip = function(look, a)
	Cyl(a.tail, a.tail + V3(0, 0.1, 1.6), 0.16, "Cd")
	E(V3(0.3, 0.3, 0.3), a.tail + V3(0, 0.1, 1.6), "C2", { Material = "Neon" })
end

X.flame_tail = function() end

X.whiskers = function(look, a)
	local y = (a.eyeYabs or 0) - (a.eyeSize or 0.3) * 0.9
	for _, s in ipairs({ -1, 1 }) do
		local o = faceAt(a, s * a.hs.X * 0.35, y, 0.02)
		for _, dy in ipairs({ -0.08, 0.08 }) do
			Cyl(o, o + V3(s * 0.65, dy * 2, 0.08), 0.05, INK, { NoShadow = true })
		end
	end
end

local function nose(a, size, color)
	local y = (a.eyeYabs or 0) - (a.eyeSize or 0.3) * 0.75
	local p = faceAt(a, 0, y, 0.05)
	E(V3(size, size * 0.75, size * 0.6), p, color)
end
X.nose = function(look, a) nose(a, 0.26, Color3.fromRGB(60, 40, 50)) end
X.nose_big = function(look, a) nose(a, 0.55, PINK) end

X.snout = function(look, a)
	local y = (a.eyeYabs or 0) - (a.eyeSize or 0.3) * 1.25
	local p = faceAt(a, 0, y, -0.12)
	E(V3(0.95, 0.62, 0.75), p, "C2")
	E(V3(0.3, 0.22, 0.2), p + V3(0, 0.12, -0.35), INK)
end

X.tongue = function(look, a)
	local p = faceAt(a, 0, -(a.hs.Y * 0.35), 0.1)
	E(V3(0.22, 0.08, 0.7), p + V3(0, 0, -0.25), PINK)
end

X.claws = function(look, a)
	for _, f in ipairs(a.front or {}) do
		for i = -1, 1 do
			E(V3(0.1, 0.12, 0.22), f + V3(i * 0.14, -0.22, -0.3), IVORY)
		end
	end
end

X.spikes_back = function(look, a)
	-- пирамидки CornerWedge: видны с любого ракурса и стоят всего 1 деталь
	local bc, bs = a.bodyC, a.bodyS
	local rows = { { -0.55, 0.88 }, { 0, 1 }, { 0.55, 0.88 } }
	for _, r in ipairs(rows) do
		for k = -2, 2 do
			local z = bc.Z + k * bs.Z * 0.36
			local x = r[1] * bs.X
			local y = bc.Y + bs.Y * r[2] * math.sqrt(math.max(0.2, 1 - (k * 0.36) ^ 2)) - 0.08
			local tilt = ANG(rad(-32), rad(45), rad(-r[1] * 45))
			local c, paint = colorOf("C3")
			local sp = MK.Corner(ctx.model, V3(0.42, 0.72, 0.42), CF(x, y + 0.22, z) * tilt, c)
			finish(sp, paint)
		end
	end
end

X.plates_back = function(look, a)
	local bc, bs = a.bodyC, a.bodyS
	for k = -2, 2 do
		local z = bc.Z + k * bs.Z * 0.38
		local h = 0.75 - math.abs(k) * 0.12
		Tri(CF(0, bc.Y + bs.Y + h * 0.35, z) * ANG(0, rad(90), 0), 0.7, h, 0.14, "C2")
	end
end

X.shell = function(look, a)
	local bc, bs = a.bodyC, a.bodyS
	-- панцирь крупнее тела, с тёмными поясами
	E(V3(bs.X * 2.45, bs.Y * 2.0, bs.Z * 2.35), bc + V3(0, bs.Y * 0.45, 0.05), "C3")
	for k = -1, 1 do
		E(V3(bs.X * 2.5, bs.Y * 1.7, 0.2), bc + V3(0, bs.Y * 0.62, k * bs.Z * 0.55 + 0.05), MK.Shade(ctx.C3, -0.3))
	end
end

local function crystal(pos, h, tilt, color)
	color = color or "C2"
	local cf = CF(pos) * tilt * ANG(0, rad(45), 0)
	B(V3(0.32, h, 0.32), cf * CF(0, h / 2, 0), color, { Material = "Glass", Transparency = 0.1 })
	Tri(cf * CF(0, h + 0.12, 0), 0.32, 0.24, 0.3, color, { Material = "Glass", Transparency = 0.1 })
end

X.crystals = function(look, a)
	local pts = a.shoulders or { a.back + V3(-0.35, -0.05, 0.1), a.back + V3(0.35, -0.05, -0.1) }
	for i, p in ipairs(pts) do
		local s = (i == 1) and -1 or 1
		crystal(p, 0.75, ANG(rad(-10), 0, rad(s * -25)))
		crystal(p + V3(s * 0.25, -0.05, 0.25), 0.5, ANG(rad(15), 0, rad(s * -45)))
	end
	crystal(a.back + V3(0, -0.05, 0.3), 0.9, ANG(rad(-15), 0, 0))
end

X.moss = function(look, a)
	local green = Color3.fromRGB(110, 190, 80)
	E(V3(1.0, 0.25, 0.8), a.top + V3(0.1, 0.02, 0.05), green)
	E(V3(0.6, 0.22, 0.5), a.back + V3(-0.4, 0, 0.2), green)
end

X.horns = function(look, a)
	local c = (ctx.has.glow and "C2") or IVORY
	for _, s in ipairs({ -1, 1 }) do
		local base = a.hc + V3(s * a.hs.X * 0.5, a.hs.Y * 0.8, 0.15)
		Cone(base, V3(s * 0.45, 1, 0.35), 0.95, 0.32, c, (c == "C2") and { Material = "Neon" } or nil)
	end
end

X.horns_small = function(look, a)
	for _, s in ipairs({ -1, 1 }) do
		Cone(a.hc + V3(s * a.hs.X * 0.5, a.hs.Y * 0.82, 0.05), V3(s * 0.3, 1, 0), 0.5, 0.24, IVORY)
	end
end

X.horn_single = function(look, a)
	Cone(faceAt(a, 0, a.hs.Y * 0.45, -0.1), V3(0, 1, -0.6), 0.9, 0.3, "C3", { Material = "Metal" })
end

X.horn_single_long = function(look, a)
	Cone(faceAt(a, 0, a.hs.Y * 0.1, -0.15), V3(0, 0.12, -1), 2.1, 0.28, IVORY)
end

X.antlers = function(look, a)
	for _, s in ipairs({ -1, 1 }) do
		local b0 = a.hc + V3(s * a.hs.X * 0.45, a.hs.Y * 0.85, 0.1)
		local b1 = b0 + V3(s * 0.35, 0.7, 0.1)
		local b2 = b1 + V3(s * 0.4, 0.55, 0.15)
		local opts = { Material = "Glass", Transparency = 0.05 }
		Cyl(b0, b1, 0.16, "C2", opts)
		Cyl(b1, b2, 0.13, "C2", opts)
		Cyl(b1, b1 + V3(s * -0.1, 0.5, -0.25), 0.11, "C2", opts)
		Cyl(b2, b2 + V3(s * 0.05, 0.35, -0.2), 0.1, "C2", opts)
		Cyl(b2, b2 + V3(s * 0.35, 0.15, 0.05), 0.1, "C2", opts)
	end
end

X.tusks = function(look, a)
	local y = (a.eyeYabs or 0) - (a.eyeSize or 0.3) * 1.4
	for _, s in ipairs({ -1, 1 }) do
		local p = faceAt(a, s * a.hs.X * 0.35, y, 0)
		Cone(p, V3(s * 0.25, 0.35, -1), 0.95, 0.22, IVORY)
	end
end

X.tusks_down = function(look, a)
	local y = (a.eyeYabs or 0) - (a.eyeSize or 0.3) * 1.5
	for _, s in ipairs({ -1, 1 }) do
		local p = faceAt(a, s * a.hs.X * 0.22, y, -0.02)
		Cone(p, V3(0, -1, -0.25), 0.75, 0.2, IVORY)
	end
end

X.trunk = function(look, a)
	local y = (a.eyeYabs or 0) - (a.eyeSize or 0.3) * 1.0
	local p = faceAt(a, 0, y, 0)
	E(V3(0.5, 0.55, 0.55), p + V3(0, -0.1, -0.15), "C")
	E(V3(0.42, 0.5, 0.45), p + V3(0, -0.5, -0.3), "C")
	E(V3(0.36, 0.4, 0.4), p + V3(0, -0.85, -0.38), "C")
end

X.fangs = function(look, a)
	local y = (a.eyeYabs or 0) - (a.eyeSize or 0.3) * 1.3
	for _, s in ipairs({ -1, 1 }) do
		local p = faceAt(a, s * 0.14, y, 0.02)
		Tri(CF(p) * ANG(0, 0, rad(180)), 0.14, 0.22, 0.08, WHITE)
	end
end

X.teeth = function(look, a)
	local y = -a.hs.Y * 0.25
	for i = -2, 2 do
		local p = faceAt(a, i * 0.17, y, 0.02)
		Tri(CF(p) * ANG(0, 0, rad(180)), 0.14, 0.18, 0.08, WHITE)
	end
end

local function wing(s, root, len, h, color, opts, spread)
	local cf = CF(root) * ANG(rad(-10), rad(s * -15), rad(s * (spread or 25))) * CF(s * len / 2, 0, 0.1)
	return E(V3(len, h, 0.14), cf, color, opts)
end

X.wings_bat = function(look, a)
	for _, s in ipairs({ -1, 1 }) do
		local root = V3(s * a.side * 0.8, a.wingY + 0.2, a.bodyC.Z + 0.15)
		wing(s, root, 2.0, 1.1, "C2", nil, 22)
		local tip = root + V3(s * 1.8, 0.85, 0.1)
		Cyl(root, tip, 0.14, "Cd")
		for k = 1, 2 do
			Cyl(root + V3(s * 0.6 * k, 0.25 * k, 0.05), root + V3(s * (0.75 + 0.55 * k), -0.35, 0.1), 0.08, "Cd")
		end
	end
end

X.wings_feather = function(look, a)
	for _, s in ipairs({ -1, 1 }) do
		local root = V3(s * a.side * 0.8, a.wingY + 0.25, a.bodyC.Z + 0.2)
		wing(s, root, 1.9, 0.9, "C", nil, 30)
		wing(s, root + V3(0, -0.2, 0.08), 1.6, 0.75, "C2", nil, 15)
		wing(s, root + V3(0, -0.35, 0.16), 1.25, 0.6, "Cd", nil, 2)
	end
end

X.wings_crystal = function(look, a)
	for _, s in ipairs({ -1, 1 }) do
		local root = V3(s * a.side * 0.6, a.wingY + 0.3, a.bodyC.Z + 0.1)
		local opts = { Material = "Glass", Transparency = 0.35 }
		wing(s, root, 1.7, 0.95, "C2", opts, 35)
		wing(s, root + V3(0, -0.15, 0.25), 1.3, 0.7, "C2", opts, 5)
	end
end

X.flippers = function(look, a)
	for _, s in ipairs({ -1, 1 }) do
		E(V3(0.3, 1.0, 0.6), CF(s * (a.side + 0.05), a.wingY - 0.2, a.bodyC.Z) * ANG(0, 0, rad(s * 25)), "C")
	end
end

X.crest_small = function(look, a)
	for k = 0, 2 do
		Tri(CF(a.top + V3(0, 0.1, k * 0.3 - 0.2)) * ANG(rad(-20), rad(90), 0), 0.35, 0.4 - k * 0.07, 0.1, "C3")
	end
end

X.crest_long = function(look, a)
	Tri(CF(a.top + V3(0, 0.2, 0.55)) * ANG(rad(-55), rad(90), 0), 0.5, 1.3, 0.14, "C2")
end

X.beak = function(look, a)
	local y = (a.eyeYabs or 0) - (a.eyeSize or 0.3) * 0.95
	local p = faceAt(a, 0, y, -0.05)
	Cone(p, V3(0, -0.15, -1), 0.5, 0.42, Color3.fromRGB(255, 170, 50))
end

X.beak_long = function(look, a)
	local y = (a.eyeYabs or 0) - (a.eyeSize or 0.3) * 0.9
	local p = faceAt(a, 0, y, -0.05)
	Cone(p, V3(0, -0.1, -1), 1.3, 0.42, Color3.fromRGB(255, 190, 90))
end

X.belly = function() end

X.scarf = function(look, a)
	local red = Color3.fromRGB(230, 60, 70)
	local y = a.hc.Y - a.hs.Y * 0.15
	E(V3(a.hs.X * 2.05, 0.36, a.hs.Z * 2.0), V3(0, y, a.hc.Z), red)
	E(V3(0.36, 0.7, 0.18), CF(0.35, y - 0.35, a.hc.Z + a.hs.Z * 0.95) * ANG(0, 0, rad(10)), red)
end

X.helmet = function(look, a)
	local yellow = Color3.fromRGB(255, 200, 40)
	E(V3(a.hs.X * 1.6, a.hs.Y * 1.0, a.hs.Z * 1.6), a.top + V3(0, -0.1, 0), yellow)
	E(V3(a.hs.X * 1.9, 0.12, a.hs.Z * 1.9), a.top + V3(0, -0.35, -0.05), yellow)
	E(V3(0.36, 0.36, 0.2), faceAt(a, 0, a.hs.Y * 0.75, 0.02) + V3(0, 0.05, -0.1), Color3.fromRGB(255, 250, 200), { Material = "Neon" })
end

X.fur_top = function(look, a)
	for i = -1, 1 do
		E(V3(0.45, 0.55, 0.45), CF(a.top + V3(i * 0.2, 0.05, i * 0.05)) * ANG(rad(-15), 0, rad(i * -20)), "C2")
	end
end

local SPOT_PTS = { { 0.4, 0.75, -0.2 }, { -0.5, 0.6, 0.3 }, { 0.15, 0.9, 0.55 }, { -0.25, 0.85, -0.45 }, { 0.6, 0.4, 0.45 } }
local function spots(a, glow)
	local bc, bs = a.bodyC, a.bodyS
	for _, p in ipairs(SPOT_PTS) do
		local pos = bc + V3(p[1] * bs.X, p[2] * bs.Y, p[3] * bs.Z)
		local n = (pos - bc)
		local cf = CF(pos, pos + n)
		E(V3(0.4, 0.32, 0.14), cf, glow and "C2" or "C3", glow and { Material = "Neon" } or nil)
	end
end
X.spots = function(look, a) spots(a, false) end
X.spots_glow = function(look, a) spots(a, true) end

X.stripes = function(look, a)
	local bc, bs = a.bodyC, a.bodyS
	for k = -1, 1 do
		E(V3(bs.X * 1.7, 0.18, 0.28), CF(bc + V3(0, bs.Y * 0.82, k * bs.Z * 0.45)) * ANG(0, 0, 0), "C3")
	end
	E(V3(0.6, 0.14, 0.24), a.top + V3(0, 0.02, 0.1), "C3")
end

X.stripe_head = function(look, a)
	E(V3(0.36, a.hs.Y * 2.05, a.hs.Z * 2.05), a.hc + V3(0, 0.03, -0.02), "C2")
end

X.frills = function(look, a)
	for _, s in ipairs({ -1, 1 }) do
		Tri(CF(a.hc + V3(s * a.hs.X * 0.95, 0, 0.1)) * ANG(0, rad(s * 70), rad(s * -60)), 0.7, 0.6, 0.1, "C2")
	end
end

X.cracks_glow = function(look, a)
	local bc, bs = a.bodyC, a.bodyS
	local lines = { { 0.5, 0.55, -0.3, 30 }, { -0.55, 0.45, 0.2, -40 }, { 0.1, 0.92, 0.3, 80 }, { -0.2, 0.6, -0.7, 10 } }
	for _, l in ipairs(lines) do
		local pos = bc + V3(l[1] * bs.X, l[2] * bs.Y, l[3] * bs.Z)
		local cf = CF(pos, pos + (pos - bc)) * ANG(0, 0, rad(l[4]))
		B(V3(0.1, 0.6, 0.1), cf, "C2", { Material = "Neon" })
	end
end

X.shoulder_lava = function(look, a)
	for _, p in ipairs(a.shoulders or {}) do
		E(V3(0.7, 0.45, 0.7), p + V3(0, 0.1, 0), "C2", { Material = "Neon" })
	end
end

X.drips = function(look, a)
	for i, x in ipairs({ -0.6, 0.1, 0.65 }) do
		E(V3(0.3, 0.45, 0.3), a.hc + V3(x, -a.hs.Y * 0.75, -a.hs.Z * 0.6), "C", { Transparency = 0.15 })
	end
end

X.inner_core = function(look, a)
	E(V3(0.9, 0.9, 0.9), a.bodyC + V3(0, -0.15, 0.2), "C2", { Material = "Neon" })
end

X.flame = function(look, a)
	local base = a.top
	local cols = { "C2", Color3.fromRGB(255, 240, 160), Color3.fromRGB(255, 255, 240) }
	local sizes = { 0.75, 0.5, 0.28 }
	for i = 1, 3 do
		E(V3(sizes[i], sizes[i] * 1.5, sizes[i]), CF(base + V3(0, 0.15 + (i - 1) * 0.32, 0.18 * i)) * ANG(rad(-20 * i), 0, 0), cols[i], { Material = "Neon", Transparency = 0.05 })
	end
end

X.arms_small = function(look, a)
	for _, s in ipairs({ -1, 1 }) do
		E(V3(0.42, 0.42, 0.75), CF(a.bodyC + V3(s * (a.side + 0.05), -0.15, -0.2)) * ANG(rad(25), 0, rad(s * 20)), "C")
	end
end

X.hood = function(look, a)
	E(V3(a.hs.X * 2.2, a.hs.Y * 1.6, a.hs.Z * 1.8), a.hc + V3(0, a.hs.Y * 0.35, a.hs.Z * 0.35), "Cd")
	Tri(CF(a.top + V3(0, 0.35, 0.45)) * ANG(rad(-35), rad(90), 0), 0.6, 0.8, 0.2, "Cd")
end

X.crown = function(look, a)
	local gold = Color3.fromRGB(255, 210, 60)
	local base = a.top + V3(0, 0.05, 0)
	E(V3(1.0, 0.18, 1.0), base, gold, { Material = "Metal" })
	for i = 0, 4 do
		local ang = i * math.pi * 2 / 5
		local p = base + V3(math.cos(ang) * 0.42, 0.22, math.sin(ang) * 0.42)
		Tri(CF(p, base + V3(0, 0.22, 0)) * ANG(0, rad(180), 0), 0.24, 0.4, 0.08, gold, { Material = "Metal" })
	end
	E(V3(0.2, 0.2, 0.2), base + V3(0, 0.15, -0.48), Color3.fromRGB(255, 60, 120), { Material = "Neon" })
end

local function ring(center, radius, n, size, color, tilt, opts)
	for i = 0, n - 1 do
		local ang = i * math.pi * 2 / n
		local off = V3(math.cos(ang) * radius, 0, math.sin(ang) * radius)
		local p = (CF(center) * tilt):PointToWorldSpace(off)
		E(V3(size, size * 0.8, size), p, color, opts)
	end
end

X.halo = function(look, a)
	ring(a.top + V3(0, 0.6, 0.1), 0.62, 12, 0.24, Color3.fromRGB(255, 236, 140), ANG(rad(-12), 0, 0), { Material = "Neon" })
end

X.rings = function(look, a)
	ring(a.bodyC, math.max(a.bodyS.X, a.bodyS.Z) + 0.5, 16, 0.22, "C2", ANG(rad(18), 0, rad(-14)), { Material = "Neon" })
end
X.ring_self = X.rings

X.shards = function(look, a)
	for i = 0, 2 do
		local ang = i * math.pi * 2 / 3
		local p = a.hc + V3(math.cos(ang) * 1.35, -0.2 + i * 0.3, math.sin(ang) * 1.35)
		crystal(p, 0.55, ANG(rad(20), ang, rad(15)), "C2")
	end
end

X.eye_single = function(look, a)
	local p = faceAt(a, 0, a.hs.Y * 0.05, 0.05)
	E(V3(1.25, 1.25, 0.5), p, WHITE)
	E(V3(0.8, 0.8, 0.35), p + V3(0, 0, -0.12), "C2", { Material = "Neon" })
	E(V3(0.36, 0.55, 0.25), p + V3(0, 0, -0.22), INK)
	E(V3(0.16, 0.16, 0.1), p + V3(0.18, 0.2, -0.3), WHITE)
end

X.tentacles = function(look, a)
	for i = 0, 3 do
		local ang = i * math.pi / 2 + math.pi / 4
		local p0 = a.hc + V3(math.cos(ang) * 0.5, -a.hs.Y * 0.8, math.sin(ang) * 0.5)
		local p1 = p0 + V3(math.cos(ang) * 0.25, -0.5, math.sin(ang) * 0.25)
		local p2 = p1 + V3(math.cos(ang) * -0.15, -0.4, math.sin(ang) * -0.15)
		Cyl(p0, p1, 0.2, "C")
		Cyl(p1, p2, 0.14, "C2")
	end
end

X.star_points = function(look, a)
	for i = 0, 4 do
		local ang = rad(90 + i * 72)
		local dir = V3(math.cos(ang), math.sin(ang), 0)
		local p = a.hc + dir * (a.hs.X * 0.95)
		local cf = CF(p) * ANG(0, 0, ang - rad(90))
		Tri(cf * CF(0, 0.35, 0), 0.65, 0.75, 0.5, "C", { Material = "Neon" })
	end
end

X.stars = function(look, a)
	local bc, bs = a.bodyC, a.bodyS
	for i, p in ipairs(SPOT_PTS) do
		local pos = bc + V3(p[1] * bs.X * 1.02, p[2] * bs.Y * 1.02, p[3] * bs.Z * 1.02)
		E(V3(0.16, 0.16, 0.16), pos, Color3.fromRGB(255, 255, 230), { Material = "Neon" })
	end
end

X.sparkle = function(look, a)
	MK.Sparkles(ctx.root, ctx.C2, 5, 0.3)
end

X.glow = function(look, a)
	MK.Light(ctx.root, ctx.C2, 9, 1.4)
end

X.leaf = function(look, a)
	local green = Color3.fromRGB(100, 200, 70)
	Cyl(a.top, a.top + V3(0, 0.35, 0.05), 0.1, Color3.fromRGB(90, 140, 60))
	E(V3(0.7, 0.12, 0.42), CF(a.top + V3(0.3, 0.42, 0)) * ANG(0, 0, rad(25)), green)
	E(V3(0.55, 0.12, 0.34), CF(a.top + V3(-0.22, 0.36, 0.05)) * ANG(0, rad(30), rad(-30)), green)
end

X.flowers = function(look, a)
	local cols = { Color3.fromRGB(255, 120, 170), Color3.fromRGB(255, 255, 255) }
	for i, x in ipairs({ -0.55, 0.6 }) do
		local p = a.hc + V3(x, a.hs.Y * 0.7, 0.2)
		for k = 0, 4 do
			local ang = k * math.pi * 2 / 5
			E(V3(0.16, 0.08, 0.16), p + V3(math.cos(ang) * 0.12, 0.05, math.sin(ang) * 0.12), cols[i])
		end
		E(V3(0.1, 0.1, 0.1), p + V3(0, 0.08, 0), Color3.fromRGB(255, 220, 60))
	end
end

X.extra_heads = function(look, a)
	for _, s in ipairs({ -1, 1 }) do
		local base = a.back + V3(s * 0.4, -0.2, 0.2)
		local hp = base + V3(s * 0.9, 0.8, -0.5)
		Cyl(base, hp, 0.42, "C")
		E(V3(0.9, 0.8, 0.95), hp, "C")
		for _, e in ipairs({ -1, 1 }) do
			E(V3(0.16, 0.18, 0.1), hp + V3(e * 0.2, 0.1, -0.44), MK.C(look.EyeColor or { 255, 230, 100 }), { Material = "Neon" })
		end
	end
end

X.clock_face = function(look, a)
	local p = a.bodyC + V3(0, 0.1, -a.bodyS.Z - 0.05)
	MK.Cylinder(ctx.model, 0.1, 0.9, CF(p) * ANG(0, rad(90), 0), ctx.C2):SetAttribute("Paint", "Fixed")
	B(V3(0.06, 0.32, 0.04), CF(p + V3(0, 0.14, -0.07)), WHITE, { Material = "Neon" })
	B(V3(0.22, 0.06, 0.04), CF(p + V3(0.1, 0, -0.07)), WHITE, { Material = "Neon" })
end

X.bolts = function(look, a)
	for _, s in ipairs({ -1, 1 }) do
		E(V3(0.12, 0.26, 0.26), a.bodyC + V3(s * (a.bodyS.X + 0.02), 0.1, 0), "C3", { Material = "Metal" })
	end
end

X.feelers = function(look, a)
	for _, s in ipairs({ -1, 1 }) do
		local p0 = faceAt(a, s * 0.3, -a.hs.Y * 0.2, 0)
		local p1 = p0 + V3(s * 0.2, -0.3, -0.5)
		local p2 = p1 + V3(s * -0.05, 0.25, -0.35)
		Cyl(p0, p1, 0.16, "C2")
		Cyl(p1, p2, 0.12, "C2")
	end
end

X.segments = function(look, a)
	local bc, bs = a.bodyC, a.bodyS
	for k = -2, 2 do
		E(V3(bs.X * 2.05, bs.Y * 0.6, 0.16), bc + V3(0, bs.Y * 0.55, k * bs.Z * 0.38), "Cd")
	end
end

X.pincers = function(look, a)
	for _, s in ipairs({ -1, 1 }) do
		local p0 = a.hc + V3(s * a.hs.X * 0.8, -0.05, -0.1)
		local p1 = p0 + V3(s * 0.45, 0.05, -0.6)
		Cyl(p0, p1, 0.22, "C")
		E(V3(0.55, 0.42, 0.75), p1 + V3(0, 0, -0.3), "C")
		Tri(CF(p1 + V3(s * -0.1, 0.05, -0.7)) * ANG(rad(-90), 0, 0), 0.22, 0.35, 0.12, "C2")
	end
end

X.stinger = function(look, a)
	local p0 = a.tail
	local p1 = p0 + V3(0, 0.75, 0.45)
	local p2 = p1 + V3(0, 0.75, -0.1)
	local p3 = p2 + V3(0, 0.35, -0.55)
	Cyl(p0, p1, 0.36, "C")
	Cyl(p1, p2, 0.3, "C")
	Cyl(p2, p3, 0.26, "C")
	Cone(p3, V3(0, -0.35, -1), 0.5, 0.3, "C2", { Material = "Neon" })
end

X.antennae = function(look, a)
	for _, s in ipairs({ -1, 1 }) do
		local p0 = a.hc + V3(s * a.hs.X * 0.35, a.hs.Y * 0.8, -0.05)
		local p1 = p0 + V3(s * 0.3, 0.6, -0.25)
		Cyl(p0, p1, 0.08, INK)
		E(V3(0.2, 0.2, 0.2), p1, "C2")
	end
end

X.tiny_arms = function(look, a)
	for _, s in ipairs({ -1, 1 }) do
		E(V3(0.22, 0.22, 0.5), CF(s * 0.5, 1.35, -0.75) * ANG(rad(40), 0, 0), "C")
	end
end

X.long_neck = function() end
X.big_head = function() end

X.fins = function(look, a)
	for i, s in ipairs(a.segs or {}) do
		if i <= 3 then
			Tri(CF(s[1] + V3(0, s[2] * 0.5, 0)) * ANG(rad(-30), rad(90), 0), 0.5, 0.45, 0.1, "C2", { Material = "Glass", Transparency = 0.1 })
		end
	end
end

---------------------------------------------------------------------------------------------
-- Публичный API
---------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------
-- Мифики: огромные крылья, рога, пламя, ауры, нимбы, светящиеся грани
---------------------------------------------------------------------------------------------
local function mc(t, fallback)
	if t == nil then
		return fallback
	end
	return MK.C(t)
end

-- одно «перо»/лопасть крыла: плоский эллипсоид от точки root под углами
local function blade(root, s, len, h, yaw, roll, color, opts)
	local cf = CF(root) * ANG(0, rad(s * yaw), rad(s * roll)) * CF(s * len / 2, 0, 0)
	return E(V3(len, h, 0.16), cf, color, opts)
end

local WINGS = {}
-- крылья демона: перепонки-треугольники с неоновыми кромками
WINGS.demon = function(a, m, s, root)
	local dark, edge = mc(m.C1, ctx.C3), mc(m.Glow, ctx.C2)
	-- перепонка
	local mem = CF(root) * ANG(rad(-8), rad(s * -18), rad(s * 18)) * CF(s * 1.9, 0.35, 0.05)
	E(V3(3.8, 2.4, 0.14), mem, dark)
	E(V3(3.2, 1.7, 0.16), mem * CF(s * 0.1, -0.05, -0.02), dark:Lerp(edge, 0.25))
	-- «кости» крыла с неоном
	for k = 0, 2 do
		local tip = (mem * CF(s * (1.9 - k * 0.2), 1.2 - k * 1.05, 0)).Position
		Cyl(root, tip, 0.18 - k * 0.03, edge, { Material = "Neon" })
	end
	local top = (mem * CF(s * 1.9, 1.2, 0)).Position
	Cone(top, V3(s * 0.5, 1, 0.1), 0.9, 0.32, edge, { Material = "Neon" })
end
-- ангельские крылья: слои белых/золотых перьев
WINGS.angel = function(a, m, s, root)
	local c1, c2 = mc(m.C1, WHITE), mc(m.C2, GOLD)
	for layer = 0, 2 do
		for k = 0, 4 do
			local len = 2.9 - layer * 0.7 - k * 0.18
			local col = (layer == 1) and c2 or c1
			blade(root + V3(0, -layer * 0.25, layer * 0.12), s, len, 0.62, -15, 62 - k * 16 - layer * 4, col, layer == 1 and { Material = "Neon", Transparency = 0.15 } or nil)
		end
	end
end
-- крылья бабочки: две большие лопасти с узорами
WINGS.butterfly = function(a, m, s, root)
	local c1, c2, c3 = mc(m.C1, ctx.C), mc(m.C2, ctx.C2), mc(m.Glow, GOLD)
	local up = CF(root) * ANG(rad(-8), rad(s * -20), rad(s * 32)) * CF(s * 1.7, 0.3, 0)
	E(V3(3.4, 2.6, 0.14), up, c1)
	E(V3(2.6, 1.9, 0.16), up * CF(s * 0.15, 0.05, -0.02), c2)
	E(V3(0.9, 0.9, 0.18), up * CF(s * 0.6, 0.3, -0.04), c3, { Material = "Neon" })
	E(V3(0.5, 0.5, 0.2), up * CF(s * -0.3, -0.45, -0.05), c3, { Material = "Neon" })
	local low = CF(root) * ANG(rad(-8), rad(s * -20), rad(s * -22)) * CF(s * 1.3, -0.3, 0.05)
	E(V3(2.5, 1.7, 0.14), low, c1)
	E(V3(1.8, 1.1, 0.16), low * CF(s * 0.1, 0, -0.02), c3, { Material = "Neon", Transparency = 0.2 })
end
-- кристальные крылья
WINGS.crystal = function(a, m, s, root)
	local c1 = mc(m.Glow, ctx.C2)
	for k = 0, 4 do
		local len = 1.6 + k * 0.5
		local cf = CF(root) * ANG(rad(-10), rad(s * -15), rad(s * (70 - k * 22))) * CF(s * len / 2, 0, 0) * ANG(rad(45), 0, 0)
		B(V3(len, 0.42, 0.42), cf, c1, { Material = "Glass", Transparency = 0.25 })
		B(V3(len * 0.6, 0.18, 0.18), cf, c1, { Material = "Neon" })
	end
end
-- огненные крылья
WINGS.flame = function(a, m, s, root)
	local c1, c2 = mc(m.C1, Color3.fromRGB(255, 90, 30)), mc(m.Glow, Color3.fromRGB(255, 220, 80))
	for k = 0, 4 do
		local len = 3.2 - k * 0.35
		blade(root, s, len, 0.7, -15, 66 - k * 20, (k % 2 == 0) and c1 or c2, { Material = "Neon", Transparency = 0.1 })
	end
end

-- королевские крылья: три слоя перьев — длинные светлые, золотые и короткие с неоновым кантом
WINGS.royal = function(a, m, s, root)
	local c1, c2, c3 = mc(m.C1, WHITE), mc(m.C2, GOLD), mc(m.Glow, ctx.C2)
	for k = 0, 5 do
		blade(root, s, 3.5 - k * 0.32, 0.74, -14, 80 - k * 17, c1)
	end
	for k = 0, 4 do
		blade(root + V3(0, -0.08, -0.1), s, 2.6 - k * 0.26, 0.62, -14, 72 - k * 18, c2, { Material = "Metal" })
	end
	for k = 0, 3 do
		blade(root + V3(0, -0.14, -0.2), s, 1.6 - k * 0.16, 0.5, -14, 66 - k * 21, c3, { Material = "Neon", Transparency = 0.1 })
	end
	E(V3(0.75, 0.75, 0.55), root, c2, { Material = "Metal" })
end
local RAINBOW7 = {
	Color3.fromRGB(255, 92, 120), Color3.fromRGB(255, 160, 60), Color3.fromRGB(255, 228, 90), Color3.fromRGB(110, 226, 120),
	Color3.fromRGB(90, 196, 255), Color3.fromRGB(140, 120, 255), Color3.fromRGB(226, 120, 255),
}
-- радужные крылья: веер из перьев всех цветов и тонкие светящиеся «жилки»
WINGS.rainbow = function(a, m, s, root)
	for k = 0, 6 do
		local col = RAINBOW7[k + 1]
		blade(root, s, 3.4 - k * 0.2, 0.7, -14, 84 - k * 15, col)
		blade(root + V3(0, 0, -0.06), s, 2.3 - k * 0.12, 0.2, -14, 84 - k * 15, col:Lerp(WHITE, 0.45), { Material = "Neon", Transparency = 0.15 })
	end
	E(V3(0.7, 0.7, 0.5), root, WHITE)
end
-- крылья феникса: огненный веер в три слоя (красный -> оранжевый -> жёлтый), кончики светятся
WINGS.phoenix = function(a, m, s, root)
	local cols = { Color3.fromRGB(230, 50, 30), Color3.fromRGB(255, 130, 30), Color3.fromRGB(255, 220, 80) }
	for layer = 0, 2 do
		for k = 0, 5 - layer do
			local len = 3.1 - layer * 0.7 - k * 0.2
			blade(root + V3(0, -layer * 0.12, -layer * 0.1), s, len, 0.68 - layer * 0.08, -12, 82 - k * 17 - layer * 3, cols[layer + 1], layer == 2 and { Material = "Neon", Transparency = 0.05 } or nil)
		end
	end
	for k = 0, 3 do
		local cf = CF(root) * ANG(0, rad(s * -12), rad(s * (82 - k * 17))) * CF(s * (2.95 - k * 0.2), 0, 0)
		E(V3(0.5, 0.36, 0.2), cf, Color3.fromRGB(255, 240, 150), { Material = "Neon" })
	end
end
-- галактические крылья: тёмная перепонка, звёзды и светящаяся кромка
WINGS.galaxy = function(a, m, s, root)
	local dark, edge = mc(m.C1, Color3.fromRGB(30, 24, 80)), mc(m.Glow, Color3.fromRGB(120, 220, 255))
	local mem = CF(root) * ANG(rad(-8), rad(s * -18), rad(s * 24)) * CF(s * 2.0, 0.4, 0.05)
	E(V3(4.0, 2.6, 0.14), mem, dark)
	E(V3(3.3, 1.9, 0.16), mem * CF(s * 0.1, -0.05, -0.02), dark:Lerp(Color3.fromRGB(150, 80, 220), 0.45))
	for k = 0, 2 do
		local tip = (mem * CF(s * (2.0 - k * 0.25), 1.3 - k * 1.1, 0)).Position
		Cyl(root, tip, 0.16 - k * 0.03, edge, { Material = "Neon" })
	end
	for i = 1, 7 do
		local x, y = ((ctx.hash * i) % 7) / 7 - 0.5, ((ctx.hash * i * 3) % 5) / 5 - 0.5
		E(V3(0.16, 0.16, 0.2), mem * CF(s * x * 2.6, y * 1.6, -0.06), (i % 3 == 0) and edge or WHITE, { Material = "Neon" })
	end
end

-- лепестковые крылья: веер из розовых и белых лепестков с золотыми прожилками
WINGS.petal = function(a, m, s, root)
	local c1, c2, c3 = mc(m.C1, Color3.fromRGB(255, 160, 200)), mc(m.C2, WHITE), mc(m.Glow, GOLD)
	for k = 0, 5 do
		local cf = CF(root) * ANG(0, rad(s * -14), rad(s * (82 - k * 17))) * CF(s * (1.5 - k * 0.05), 0, 0)
		E(V3(3.0 - k * 0.18, 1.15 - k * 0.05, 0.14), cf, (k % 2 == 0) and c1 or c2)
		E(V3(2.2 - k * 0.15, 0.16, 0.16), cf * CF(0, 0, -0.04), c3, { Material = "Neon", Transparency = 0.25 })
	end
	for k = 0, 3 do
		local cf = CF(root + V3(0, -0.15, -0.1)) * ANG(0, rad(s * -14), rad(s * (70 - k * 22))) * CF(s * 1.0, 0, 0)
		E(V3(1.9, 0.8, 0.16), cf, c1:Lerp(WHITE, 0.4))
	end
	E(V3(0.6, 0.6, 0.45), root, c3, { Material = "Metal" })
end

local HORNS = {}
-- изогнутые рога из цепочки цилиндров
HORNS.curved = function(a, m, s)
	local col = mc(m.HornColor, Color3.fromRGB(40, 34, 48))
	local glow = mc(m.Glow, ctx.C2)
	local p = a.top + V3(s * a.hs.X * 0.55, -0.15, 0.1)
	local dir = V3(s * 0.6, 1, 0.25).Unit
	local d = 0.62
	for k = 1, 4 do
		local q = p + dir * 0.55
		Cyl(p, q, d, k < 4 and col or glow, k == 4 and { Material = "Neon" } or nil)
		p = q
		dir = (dir + V3(s * 0.25, -0.15, 0.25)).Unit
		d = d * 0.78
	end
end
HORNS.straight = function(a, m, s)
	Cone(a.top + V3(s * a.hs.X * 0.5, -0.1, 0), V3(s * 0.35, 1, 0.1), 1.6, 0.45, mc(m.HornColor, GOLD), { Material = "Metal" })
end
HORNS.unicorn = function(a, m, s)
	if s < 0 then
		Cone(a.top + V3(0, -0.1, -a.hs.Z * 0.45), V3(0, 1, -0.35), 1.9, 0.5, mc(m.HornColor, GOLD), { Material = "Neon" })
	end
end

local function mythicFx(look, a)
	local m = look.Mythic
	local glow = mc(m.Glow, ctx.C2)
	-- светящиеся «швы» по рёбрам куба
	if a.flat and m.Trim ~= false then
		local h = a.hs
		for _, sx in ipairs({ -1, 1 }) do
			B(V3(0.14, h.Y * 1.5, 0.14), CF(a.hc + V3(sx * (h.X + 0.02), 0, -(h.Z + 0.02))), glow, { Material = "Neon" })
		end
		B(V3(h.X * 1.5, 0.14, 0.14), CF(a.hc + V3(0, h.Y + 0.02, -(h.Z + 0.02))), glow, { Material = "Neon" })
	end
	-- самоцвет на лбу
	if m.Gem ~= false then
		local g = faceAt(a, 0, a.hs.Y * 0.62, 0.05)
		B(V3(0.38, 0.38, 0.2), CF(g) * ANG(0, 0, rad(45)), glow, { Material = "Neon" })
	end
	-- крылья
	local wf = WINGS[m.Wings or ""]
	if wf then
		for _, s in ipairs({ -1, 1 }) do
			wf(a, m, s, V3(s * a.side * 0.75, a.wingY + 0.45, a.bodyC.Z + a.bodyS.Z * 0.6))
		end
	end
	-- рога
	local hf = HORNS[m.Horns or ""]
	if hf then
		for _, s in ipairs({ -1, 1 }) do
			hf(a, m, s)
		end
	end
	-- нимб
	if m.Halo then
		ring(a.top + V3(0, 0.9, 0.15), 0.85, 16, 0.26, mc(m.HaloColor, Color3.fromRGB(255, 236, 140)), ANG(rad(-14), 0, 0), { Material = "Neon" })
	end
	-- корона
	if m.Crown then
		X.crown(look, a)
	end
	-- парящие кристаллы-спутники
	if m.Orbit then
		for i = 0, 3 do
			local ang = i * math.pi / 2 + 0.4
			local p = a.hc + V3(math.cos(ang) * (a.hs.X + 1.1), 0.3 + (i % 2) * 0.7, math.sin(ang) * (a.hs.Z + 1.1))
			B(V3(0.42, 0.7, 0.42), CF(p) * ANG(rad(20), ang, rad(15)) * ANG(0, rad(45), 0), glow, { Material = "Neon" })
		end
	end
	-- хвост-пламя
	if m.FlameTail then
		local t = a.tail
		for k = 0, 2 do
			E(V3(0.7 - k * 0.15, 0.9 - k * 0.2, 0.7 - k * 0.15), t + V3(0, 0.3 + k * 0.45, 0.35 + k * 0.25), (k % 2 == 0) and glow or ctx.C2, { Material = "Neon", Transparency = 0.1 })
		end
	end
	-- пламя, свет и частицы (всё встроенное в Roblox)
	if m.Fire then
		local f = Instance.new("Fire")
		f.Color = mc(m.Fire, Color3.fromRGB(255, 120, 30))
		f.SecondaryColor = mc(m.Fire2, Color3.fromRGB(255, 220, 80))
		f.Size = 4
		f.Heat = 6
		f.Parent = ctx.root
	end
	MK.Light(ctx.root, glow, 12, 2)
	local e = MK.Sparkles(ctx.root, { 255, 255, 255 }, 12, 0.45)
	e.Color = ColorSequence.new(glow, ctx.C2)
	e.Name = "MythicAura"
	if m.Smoke then
		local sm = Instance.new("ParticleEmitter")
		sm.Texture = "rbxasset://textures/particles/smoke_main.dds"
		sm.Color = ColorSequence.new(mc(m.Smoke, Color3.fromRGB(60, 40, 80)))
		sm.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 2.4) })
		sm.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 1) })
		sm.Lifetime = NumberRange.new(1, 1.8)
		sm.Speed = NumberRange.new(0.5, 1.5)
		sm.Rate = 6
		sm.SpreadAngle = Vector2.new(180, 180)
		sm.LightEmission = 0.3
		sm.Parent = ctx.root
	end
end

---------------------------------------------------------------------------------------------
-- «Огромные» питомцы: аура-пьедестал, облако, бант, мантия, радужная грива и хвост,
-- ледяная корона, самоцвет на груди, звёзды-спутники. Всё из примитивов Roblox.
---------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------
-- Сказочные детали (Сказочное яйцо)
---------------------------------------------------------------------------------------------
local FLOWER_COLS = { Color3.fromRGB(255, 130, 180), WHITE, Color3.fromRGB(255, 214, 90), Color3.fromRGB(190, 150, 255) }
local function flower(pos, size, col, up)
	local cf = CF(pos) * (up or ANG(0, 0, 0))
	for k = 0, 4 do
		local ang = k * math.pi * 2 / 5
		E(V3(size * 0.62, size * 0.22, size * 0.62), cf * CF(math.cos(ang) * size * 0.42, 0, math.sin(ang) * size * 0.42), col)
	end
	E(V3(size * 0.42, size * 0.3, size * 0.42), cf * CF(0, size * 0.08, 0), Color3.fromRGB(255, 214, 80))
end

-- шляпка мухомора: большая красная шляпка с белыми пятнами на коротком «пеньке»
X.mushroom_hat = function(look, a)
	local cap = mc(look.HatColor, Color3.fromRGB(235, 60, 60))
	local top = a.top + V3(0, -0.05, 0.05)
	E(V3(0.9, 0.5, 0.9), top + V3(0, 0.15, 0), IVORY)
	E(V3(a.hs.X * 2.35, 1.0, a.hs.Z * 2.3), top + V3(0, 0.55, 0), cap)
	E(V3(a.hs.X * 2.1, 0.3, a.hs.Z * 2.05), top + V3(0, 0.22, 0), MK.Shade(cap, -0.25))
	-- белые пятна прямо на поверхности шляпки (эллипсоид: полуоси rx, 0.5, rz)
	local rx, rz = a.hs.X * 1.175, a.hs.Z * 1.15
	local spots = { { -0.55, -0.35, 0.46 }, { 0.6, -0.2, 0.4 }, { 0.05, 0.1, 0.48 }, { -0.2, -0.85, 0.36 }, { 0.7, 0.5, 0.34 }, { -0.75, 0.45, 0.32 }, { 0.3, -0.75, 0.3 } }
	for _, sp in ipairs(spots) do
		local k = 1 - (sp[1] / rx) ^ 2 - (sp[2] / rz) ^ 2
		if k > 0.05 then
			local y = 0.55 + 0.5 * math.sqrt(k)
			E(V3(sp[3], sp[3] * 0.4, sp[3]), top + V3(sp[1], y - 0.04, sp[2]), WHITE)
		end
	end
end

-- венок из цветов по краю макушки
X.flower_crown = function(look, a)
	local n = 7
	local leaf = Color3.fromRGB(110, 200, 90)
	for i = 0, n - 1 do
		local ang = i / n * math.pi * 2 + 0.2
		local p = a.top + V3(math.cos(ang) * a.hs.X * 0.82, 0.08, math.sin(ang) * a.hs.Z * 0.82)
		E(V3(0.36, 0.14, 0.24), CF(p + V3(0, -0.05, 0)) * ANG(0, -ang, 0) * CF(0.18, 0, 0), leaf)
		flower(p, 0.5, FLOWER_COLS[i % #FLOWER_COLS + 1], ANG(rad(math.sin(ang) * 18), 0, rad(-math.cos(ang) * 18)))
	end
end

-- крылья феи: две пары полупрозрачных крыльев-бабочки с неоновой кромкой
X.fairy_wings = function(look, a)
	local c = mc(look.WingColor, ctx.C2)
	local edge = mc(look.WingEdge, Color3.fromRGB(255, 240, 255))
	for _, sd in ipairs({ -1, 1 }) do
		local root = V3(sd * a.side * 0.55, a.wingY + 0.3, a.bodyC.Z + a.bodyS.Z * 0.75)
		local up = CF(root) * ANG(rad(-10), rad(sd * -25), rad(sd * 38)) * CF(sd * 1.05, 0.15, 0)
		E(V3(2.1, 1.4, 0.1), up, edge, { Material = "Neon", Transparency = 0.35 })
		E(V3(1.95, 1.25, 0.12), up * CF(0, 0, -0.02), c, { Material = "Glass", Transparency = 0.25 })
		E(V3(0.5, 0.5, 0.14), up * CF(sd * 0.35, 0.15, -0.04), WHITE, { Material = "Neon", Transparency = 0.2 })
		local low = CF(root) * ANG(rad(-10), rad(sd * -25), rad(sd * -18)) * CF(sd * 0.8, -0.1, 0.05)
		E(V3(1.4, 0.95, 0.1), low, edge, { Material = "Neon", Transparency = 0.35 })
		E(V3(1.28, 0.84, 0.12), low * CF(0, 0, -0.02), c:Lerp(WHITE, 0.3), { Material = "Glass", Transparency = 0.25 })
	end
end

-- рога из хрусталя
X.crystal_antlers = function(look, a)
	local col = mc(look.AntlerColor, Color3.fromRGB(170, 230, 255))
	for _, sd in ipairs({ -1, 1 }) do
		local base = a.top + V3(sd * a.hs.X * 0.45, -0.05, 0.1)
		crystal(base, 1.1, ANG(rad(-8), 0, rad(sd * -22)), col)
		crystal(base + V3(sd * 0.32, 0.25, 0.05), 0.65, ANG(rad(-5), 0, rad(sd * -55)), col)
		crystal(base + V3(sd * 0.05, 0.35, -0.1), 0.5, ANG(rad(-35), 0, rad(sd * -10)), col)
	end
end

-- панцирь-купол на спине с узором, сверху мох, цветы и грибок
X.shell_flowers = function(look, a)
	local moss = Color3.fromRGB(110, 190, 90)
	local sh = a.top + V3(0, -0.15, 0.45)
	E(V3(a.hs.X * 2.25, 1.3, a.hs.Z * 1.9), sh, "C3")
	E(V3(a.hs.X * 2.35, 0.3, a.hs.Z * 2.0), sh + V3(0, -0.4, 0), MK.Shade(ctx.C3, -0.2))
	for i = 0, 5 do
		local ang = i / 6 * math.pi * 2
		E(V3(0.5, 0.18, 0.5), sh + V3(math.cos(ang) * 0.75, 0.42, math.sin(ang) * 0.6), MK.Shade(ctx.C3, 0.25))
	end
	local b = sh + V3(0, 0.55, 0)
	E(V3(1.4, 0.3, 1.2), b, moss)
	flower(b + V3(-0.35, 0.18, -0.15), 0.62, FLOWER_COLS[1])
	flower(b + V3(0.4, 0.15, 0.2), 0.52, FLOWER_COLS[2])
	flower(b + V3(0.05, 0.22, 0.45), 0.44, FLOWER_COLS[3])
	E(V3(0.22, 0.4, 0.22), b + V3(0.55, 0.25, -0.35), Color3.fromRGB(240, 240, 230))
	E(V3(0.5, 0.25, 0.5), b + V3(0.55, 0.48, -0.35), Color3.fromRGB(235, 70, 70))
end

-- длинные светящиеся щупальца медузы (6 штук, волной)
X.jelly_tentacles = function(look, a)
	for i = 0, 5 do
		local ang = i / 6 * math.pi * 2 + 0.3
		local p = a.hc + V3(math.cos(ang) * 0.6, -a.hs.Y * 0.75, math.sin(ang) * 0.6)
		for k = 0, 3 do
			local q = p + V3(math.sin(k + i) * 0.12, -0.38, math.cos(k + i) * 0.12)
			Cyl(p, q, 0.2 - k * 0.035, (k % 2 == 0) and "C" or "C2", (k % 2 == 1) and { Material = "Neon", Transparency = 0.1 } or { Transparency = 0.15 })
			p = q
		end
	end
	-- бахрома по краю «купола»
	for i = 0, 13 do
		local ang = i / 14 * math.pi * 2
		E(V3(0.4, 0.28, 0.4), a.hc + V3(math.cos(ang) * a.hs.X * 0.92, -a.hs.Y * 0.62, math.sin(ang) * a.hs.Z * 0.92), "C2", { Transparency = 0.2 })
	end
end

local function star4(pos, size, color, tilt)
	local cf = CF(pos) * (tilt or ANG(0, 0, 0))
	B(V3(size, size * 0.22, size * 0.22), cf, color, { Material = "Neon" })
	B(V3(size * 0.22, size, size * 0.22), cf, color, { Material = "Neon" })
	E(V3(size * 0.45, size * 0.45, size * 0.3), cf, WHITE, { Material = "Neon" })
end

local function hugeFx(look, a)
	local h = look.Huge
	local m = look.Mythic or {}
	local glow = mc(h.Aura, mc(m.Glow, ctx.C2))
	local zc = a.bodyC.Z
	local R = math.max(a.bodyS.X, a.bodyS.Z) * 1.45
	-- облако под лапами
	if h.Cloud then
		for i = 0, 7 do
			local ang = i / 8 * math.pi * 2
			E(V3(1.25, 0.75, 1.25), V3(math.cos(ang) * R * 0.75, 0.2, zc + math.sin(ang) * R * 0.75), WHITE)
		end
		E(V3(R * 1.6, 0.6, R * 1.6), V3(0, 0.18, zc), Color3.fromRGB(240, 246, 255))
	end
	-- аура-пьедестал: кольцо светящихся бусин и мягкий диск
	local n = 30
	for i = 0, n - 1 do
		local ang = i / n * math.pi * 2
		local col = h.Rainbow and RAINBOW7[i % #RAINBOW7 + 1] or glow
		E(V3(0.36, 0.12, 0.36), V3(math.cos(ang) * R, 0.06, zc + math.sin(ang) * R), col, { Material = "Neon", NoShadow = true })
	end
	local disc = MK.Disc(ctx.model, 0.05, R * 2, V3(0, 0.03, zc), glow)
	finish(disc, "Fixed", { Material = "Neon", Transparency = 0.8, NoShadow = true })
	-- цветочная поляна на пьедестале
	if h.Bloom then
		for i = 0, 9 do
			local ang = i / 10 * math.pi * 2 + 0.15
			flower(V3(math.cos(ang) * R * 0.82, 0.12, zc + math.sin(ang) * R * 0.82), 0.7, FLOWER_COLS[i % #FLOWER_COLS + 1])
		end
	end
	-- звёзды-спутники
	if h.Stars then
		for i = 0, 3 do
			local ang = i / 4 * math.pi * 2 + 0.6
			local p = a.bodyC + V3(math.cos(ang) * (R + 0.2), 0.6 + (i % 2) * 0.9, math.sin(ang) * (R + 0.2))
			star4(p, 0.45, (i % 2 == 0) and glow or Color3.fromRGB(255, 226, 120), ANG(0, ang, rad(20)))
		end
	end
	-- бант на макушке
	if h.Bow then
		local bc = mc(h.Bow, Color3.fromRGB(255, 120, 180))
		local base = a.top + V3(a.hs.X * 0.45, 0.1, -0.2)
		for _, sx in ipairs({ -1, 1 }) do
			E(V3(0.75, 0.55, 0.3), CF(base + V3(sx * 0.42, 0.05, 0)) * ANG(0, 0, rad(sx * -20)), bc)
			E(V3(0.3, 0.25, 0.32), CF(base + V3(sx * 0.42, 0.05, -0.02)), bc:Lerp(INK, 0.25))
		end
		E(V3(0.32, 0.32, 0.34), base, bc:Lerp(WHITE, 0.2))
	end
	-- королевская мантия за спиной и золотой воротник
	if h.Cape then
		local cc = mc(h.Cape, Color3.fromRGB(120, 40, 160))
		local back = a.bodyC + V3(0, -0.05, a.bodyS.Z + 0.12)
		E(V3(a.bodyS.X * 2.15, a.bodyS.Y * 1.9, 0.22), CF(back) * ANG(rad(10), 0, 0), cc)
		E(V3(a.bodyS.X * 2.0, a.bodyS.Y * 1.7, 0.24), CF(back + V3(0, 0, 0.03)) * ANG(rad(10), 0, 0), cc:Lerp(INK, 0.3))
		for i = 0, 8 do
			local t = i / 8 - 0.5
			E(V3(0.3, 0.3, 0.3), a.bodyC + V3(t * a.bodyS.X * 2.0, a.bodyS.Y * 0.95, a.bodyS.Z * 0.75 - math.abs(t) * 0.4), (i % 2 == 0) and GOLD or WHITE, { Material = (i % 2 == 0) and "Metal" or "SmoothPlastic" })
		end
	end
	-- радужная грива по макушке и затылку
	if h.Mane then
		for i = 0, 6 do
			local col = RAINBOW7[i + 1]
			E(V3(0.62, 0.8, 0.5), a.top + V3(0, 0.12 - i * 0.07, -0.55 + i * 0.32), col)
		end
	end
	-- пушистый радужный хвост
	if h.RainbowTail then
		local t0 = a.tail
		for i = 0, 6 do
			local col = RAINBOW7[i + 1]
			E(V3(0.95 - i * 0.07, 0.9 - i * 0.06, 0.8 - i * 0.05), t0 + V3(0, 0.22 * i + 0.1, 0.35 + 0.26 * i), col)
		end
	end
	-- фонтанчик кита: столбик капель и брызги
	if h.Spout then
		local sc = mc(h.Spout, Color3.fromRGB(140, 220, 255))
		local base = a.top + V3(0, 0, 0.1)
		for i = 0, 2 do
			E(V3(0.4 - i * 0.06, 0.55, 0.4 - i * 0.06), base + V3(0, 0.3 + i * 0.45, 0), sc, { Material = "Glass", Transparency = 0.15 })
		end
		for i = 0, 5 do
			local ang = i / 6 * math.pi * 2
			E(V3(0.3, 0.38, 0.3), base + V3(math.cos(ang) * 0.6, 1.35 - (i % 2) * 0.15, math.sin(ang) * 0.6), (i % 2 == 0) and sc or WHITE, { Material = (i % 2 == 0) and "Glass" or "Neon", Transparency = 0.1 })
		end
	end
	-- ледяная корона
	if h.IceCrown then
		for i = 0, 5 do
			local ang = i / 6 * math.pi * 2
			local p = a.top + V3(math.cos(ang) * a.hs.X * 0.55, -0.05, math.sin(ang) * a.hs.Z * 0.55)
			crystal(p, (i % 2 == 0) and 1.0 or 0.65, ANG(rad(math.cos(ang) * -12), 0, rad(math.sin(ang) * 12)), mc(h.CrownColor, Color3.fromRGB(170, 230, 255)))
		end
	end
	-- самоцвет на груди в золотой оправе
	if h.Gem then
		local g = a.hc + V3(0, -a.hs.Y * 0.62, -a.hs.Z - 0.08)
		B(V3(0.62, 0.62, 0.16), CF(g) * ANG(0, 0, rad(45)), GOLD, { Material = "Metal" })
		B(V3(0.42, 0.42, 0.22), CF(g + V3(0, 0, -0.04)) * ANG(0, 0, rad(45)), mc(h.Gem, glow), { Material = "Neon" })
	end
	MK.Light(ctx.root, glow, 18, 3)
	local e = MK.Sparkles(ctx.root, { 255, 255, 255 }, 18, 0.6)
	e.Color = ColorSequence.new(glow, WHITE)
	e.Name = "HugeAura"
end

function PetBuilder.Build(id)
	local look = PetLooks[id]
	local def = PetsData.ById[id]
	if not look or not def then
		warn("[PetBuilder] нет описания питомца", id)
		look = look or { A = "blob", C = { 200, 200, 200 } }
	end
	local model = Instance.new("Model")
	model.Name = id
	local root = MK.Part(model, V3(1, 1, 1), CF(0, 1, 0), { 255, 255, 255 }, { Transparency = 1, Name = "Root" })
	root.CastShadow = false
	model.PrimaryPart = root

	local C = MK.C(look.C or { 200, 200, 200 })
	local C2 = MK.C(look.C2 or { 255, 255, 255 })
	ctx = {
		model = model,
		root = root,
		C = C,
		Cd = MK.Shade(C, -0.18),
		C2 = C2,
		C3 = look.C3 and MK.C(look.C3) or MK.Shade(C, -0.38),
		mat = look.M or "SmoothPlastic",
		mat2 = look.M2 or look.M or "SmoothPlastic",
		has = {},
		hash = 0,
	}
	for i = 1, #id do
		ctx.hash = (ctx.hash * 31 + string.byte(id, i)) % 1000003
	end
	for _, x in ipairs(look.X or {}) do
		ctx.has[x] = true
	end

	-- зверушки — кубические «как в симуляторах», остальные архетипы остаются своими
	local CUBE = { quad = true, blob = true, bird = true, bat = true, golem = true }
	local a
	if look.Mythic then
		a = ARCH.mythic(look)
	elseif CUBE[look.A] and not look.Classic then
		a = ARCH.cube(look, look.A)
	else
		a = (ARCH[look.A] or ARCH.blob)(look)
	end
	buildEyes(look, a)
	for _, x in ipairs(look.X or {}) do
		local fn = X[x]
		if fn then
			fn(look, a)
		end
	end
	if look.A == "bat" and not table.find(look.X or {}, "wings_bat") then
		X.wings_bat(look, a)
	end
	if look.Mythic then
		mythicFx(look, a)
	end
	if look.Huge then
		hugeFx(look, a)
	end

	local fly = look.Fly
	if fly == nil then
		fly = (look.A == "bird" or look.A == "bat" or look.A == "orb" or look.A == "wisp" or look.A == "fish" or look.A == "dragon" or look.A == "serpent")
	end
	local rarity = def and def.Rarity or "Common"
	local scale = (RARITY_SCALE[rarity] or 1) * (look.S or 1)
	if rarity == "Legendary" or rarity == "Secret" then
		if not ctx.has.sparkle then
			MK.Sparkles(root, ctx.C2, 3, 0.28)
		end
	end
	model:SetAttribute("Fly", fly)
	model:SetAttribute("Scale", scale)
	model:SetAttribute("Rarity", rarity)
	model:SetAttribute("Huge", look.Huge ~= nil)
	if scale ~= 1 then
		model:ScaleTo(scale)
	end
	ctx = nil
	return model
end

-- Перекраска в золотой вариант (крафт 5 одинаковых петов).
function PetBuilder.ApplyGolden(model)
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") then
			local paint = p:GetAttribute("Paint")
			if paint == "C" then
				p.Color = GOLD
			elseif paint == "Cd" then
				p.Color = Color3.fromRGB(226, 168, 36)
			elseif paint == "C3" then
				p.Color = Color3.fromRGB(190, 126, 26)
			elseif paint == "C2" then
				p.Color = Color3.fromRGB(255, 240, 170)
			end
			if (paint == "C" or paint == "Cd" or paint == "C3") and p.Material ~= Enum.Material.Glass and p.Material ~= Enum.Material.Neon then
				p.Material = Enum.Material.Metal
				p.Reflectance = 0.05
			end
		end
	end
	local root = model.PrimaryPart
	if root and not root:FindFirstChild("GoldSparkle") then
		local e = MK.Sparkles(root, { 255, 220, 90 }, 4, 0.3)
		e.Name = "GoldSparkle"
	end
	model:SetAttribute("Golden", true)
end

-- Радужный вариант (5-е улучшение): основные части перекрашиваются в радугу,
-- клиент (WorldFxController) плавно гоняет оттенок по тегу "Rainbow".
function PetBuilder.ApplyRainbow(model)
	PetBuilder.ApplyGolden(model)
	local i = 0
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") then
			local paint = p:GetAttribute("Paint")
			if paint == "C" or paint == "Cd" or paint == "C3" then
				i = i + 1
				p:SetAttribute("Hue", (i * 0.13) % 1)
				p.Color = Color3.fromHSV((i * 0.13) % 1, 0.65, 1)
				if p.Material == Enum.Material.Metal then
					p.Material = Enum.Material.SmoothPlastic
					p.Reflectance = 0.1
				end
			end
		end
	end
	local root = model.PrimaryPart
	if root and root:FindFirstChild("GoldSparkle") then
		root.GoldSparkle.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 120, 120)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(120, 255, 160)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(130, 160, 255)),
		})
	end
	model:SetAttribute("Rainbow", true)
	game:GetService("CollectionService"):AddTag(model, "Rainbow")
end

-- Звёзды над питомцем (улучшения ★..★★★) и подпись для Золотого/Радужного
-- Шайни: те же цвета, но светлее и с глянцем, переливающимися искрами и мягким сиянием
function PetBuilder.ApplyShiny(model)
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") and p.Material ~= Enum.Material.Neon and p.Transparency < 0.5 then
			local c = p.Color
			-- не трогаем тёмные зрачки и обводки глаз
			if (c.R + c.G + c.B) / 3 > 0.18 then
				p.Color = c:Lerp(Color3.new(1, 1, 1), 0.18)
				p.Reflectance = 0.18
			end
		end
	end
	local root = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
	if root then
		local e = Instance.new("ParticleEmitter")
		e.Name = "ShinySparkle"
		e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		e.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(140, 240, 255)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 255, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 150, 230)),
		})
		e.LightEmission = 1
		e.Rate = 7
		e.Lifetime = NumberRange.new(0.8, 1.4)
		e.Speed = NumberRange.new(0.4, 1.2)
		e.SpreadAngle = Vector2.new(180, 180)
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.3, 0.45), NumberSequenceKeypoint.new(1, 0) })
		e.Parent = root
		local l = Instance.new("PointLight")
		l.Color = Color3.fromRGB(200, 240, 255)
		l.Range = 8
		l.Brightness = 0.8
		l.Parent = root
	end
	model:SetAttribute("Shiny", true)
end

function PetBuilder.ApplyTier(model, tier)
	tier = tier or 0
	if tier == 6 then
		PetBuilder.ApplyShiny(model)
	elseif tier >= 5 then
		PetBuilder.ApplyRainbow(model)
	elseif tier >= 4 then
		PetBuilder.ApplyGolden(model)
	end
	model:SetAttribute("Tier", tier)
end

return PetBuilder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000018"><Properties><string name="Name">Stats</string><ProtectedString name="Source"><![CDATA[-- Stats: все производные характеристики игрока. Используется и сервером, и клиентом,
-- чтобы цифры в интерфейсе всегда совпадали с серверными расчётами.
local Configs = script.Parent.Parent:WaitForChild("Configs")
local Balance = require(Configs.Balance)
local PetsData = require(Configs.PetsData)
local DrillsData = require(Configs.DrillsData)
local BackpacksData = require(Configs.BackpacksData)
local BiomesData = require(Configs.BiomesData)
local RebirthData = require(Configs.RebirthData)
local BoostsData = require(Configs.BoostsData)
local GamepassesData = require(Configs.GamepassesData)

local Stats = {}
Stats.INFINITE = 1e18 -- вместимость «бесконечного» рюкзака (геймпасс)
local FX = GamepassesData.Effects

-- геймпассы
function Stats.HasPass(data, key)
	return data ~= nil and data.Passes ~= nil and data.Passes[key] == true
end

-- серверные события (админ-панель): множители лежат в атрибутах workspace
-- Event_Coins / Event_Damage / Event_Luck и время окончания Event_<Kind>_Until (os.time)
function Stats.EventMult(kind)
	local ok, v, t = pcall(function()
		return workspace:GetAttribute("Event_" .. kind), workspace:GetAttribute("Event_" .. kind .. "_Until")
	end)
	if ok and type(v) == "number" and type(t) == "number" and os.time() < t then
		return v
	end
	return 1
end

local perkById = {}
for _, p in ipairs(RebirthData.Perks) do
	perkById[p.Id] = p
end
Stats.PerkById = perkById

function Stats.PerkLevel(data, id)
	return (data.Perks and data.Perks[id]) or 0
end

-- Сила питомца с учётом улучшения (★) и уровня
function Stats.PetTier(pet)
	return Balance.PetTiers[(pet.T or 0) + 1] or Balance.PetTiers[1]
end

function Stats.PetLevelMult(pet)
	return 1 + Balance.PetLevelBonus * ((pet.L or 1) - 1)
end

function Stats.PetPower(pet)
	local def = PetsData.ById[pet.Id]
	if not def then
		return 0
	end
	return (pet.B or def.P or 0) * Stats.PetTier(pet).Mult * Stats.PetLevelMult(pet)
end

-- бонусы одного питомца: к урону и к продаже (доли: 0.25 = +25%)
function Stats.PetBonus(pet)
	local def = PetsData.ById[pet.Id]
	if not def then
		return 0, 0
	end
	local p = Stats.PetPower(pet)
	return p * (def.DmgF or 1), p * (def.SellF or 1)
end

-- для сортировки и коротких подписей
function Stats.PetMult(pet)
	local d, s = Stats.PetBonus(pet)
	return 1 + (d + s) / 2
end

function Stats.PetXpNeed(level)
	return math.floor(Balance.PetXpBase * math.pow(level, Balance.PetXpExp))
end

function Stats.EquippedPets(data)
	local list = {}
	for uid, pet in pairs(data.Pets or {}) do
		if pet.E then
			table.insert(list, { Uid = uid, Pet = pet })
		end
	end
	table.sort(list, function(a, b)
		local ma, mb = Stats.PetMult(a.Pet), Stats.PetMult(b.Pet)
		if ma ~= mb then
			return ma > mb
		end
		return a.Uid < b.Uid
	end)
	return list
end

-- Множитель урона от питомцев: 1 + сумма бонусов экипированных
function Stats.PetSum(data)
	local sum = 1
	for _, e in ipairs(Stats.EquippedPets(data)) do
		local d = Stats.PetBonus(e.Pet)
		sum = sum + d
	end
	return sum
end

-- Множитель продажи от питомцев
function Stats.PetCoinFactor(data)
	local sum = 1
	for _, e in ipairs(Stats.EquippedPets(data)) do
		local _, sb = Stats.PetBonus(e.Pet)
		sum = sum + sb
	end
	return sum
end

function Stats.BoostActive(data, id)
	return data.ActiveBoosts and (data.ActiveBoosts[id] or 0) > 0
end

function Stats.Drill(data)
	return DrillsData.ById[data.Drill] or DrillsData.ById[DrillsData.Starter]
end

function Stats.Backpack(data)
	return BackpacksData.ById[data.Backpack] or BackpacksData.ById[BackpacksData.Starter]
end

-- Урон = урон бура x множитель урона питомцев x бусты
function Stats.Damage(data)
	local dmg = Stats.Drill(data).Damage * Stats.PetSum(data)
	if Stats.BoostActive(data, "DrillOvercharge") then
		dmg = dmg * BoostsData.ById.DrillOvercharge.Mult
	end
	return dmg * Stats.PassDamageMult(data) * Stats.EventMult("Damage")
end

function Stats.PassDamageMult(data)
	local m = 1
	if Stats.HasPass(data, "Damage2x") then
		m = m * FX.Damage2x
	end
	if Stats.HasPass(data, "VIP") then
		m = m * FX.VIPDamage
	end
	return m
end

function Stats.PassCoinMult(data)
	local m = 1
	if Stats.HasPass(data, "Coins2x") then
		m = m * FX.Coins2x
	end
	if Stats.HasPass(data, "VIP") then
		m = m * FX.VIPCoins
	end
	return m
end

-- множитель редких питомцев: Талисман удачи (буст) x2.5, геймпасс «Удача» x2, событие удачи
function Stats.LuckMult(data)
	local m = 1
	if Stats.BoostActive(data, "LuckyCharm") then
		m = m * 2.5
	end
	if Stats.HasPass(data, "Lucky") then
		m = m * FX.LuckyMult
	end
	return m * Stats.EventMult("Luck")
end

function Stats.HitInterval(data)
	local lvl = Stats.PerkLevel(data, "DrillSpeed")
	return Balance.HitInterval / (1 + perkById.DrillSpeed.PerLevel * lvl)
end

function Stats.Capacity(data)
	local lvl = Stats.PerkLevel(data, "Capacity")
	if Stats.HasPass(data, "InfiniteBackpack") then
		return Stats.INFINITE
	end
	local cap = Stats.Backpack(data).Capacity * (1 + perkById.Capacity.PerLevel * lvl)
	if Stats.HasPass(data, "BigBackpack") then
		cap = cap * FX.BigBackpack
	end
	return math.floor(cap)
end

function Stats.RebirthMult(data)
	return 1 + RebirthData.SellBonusPerRebirth * (data.Rebirths or 0)
end

-- Монеты = цена руды x множитель продажи питомцев x ребёрс x буст
function Stats.SellMult(data, sellBiome)
	local biome = BiomesData[sellBiome] or BiomesData[1]
	local m = biome.SellMult * Stats.PetCoinFactor(data) * Stats.RebirthMult(data)
	if Stats.BoostActive(data, "CoinElixir") then
		m = m * BoostsData.ById.CoinElixir.Mult
	end
	return m * Stats.PassCoinMult(data) * Stats.EventMult("Coins")
end

function Stats.PetSlots(data)
	local slots = Balance.BasePetSlots + (data.PetSlotBonus or 0) + Stats.PerkLevel(data, "PetSlot")
	slots = math.min(slots, Balance.MaxPetSlots)
	if Stats.HasPass(data, "PetSlots") then
		slots = slots + FX.PetSlots
	end
	if Stats.HasPass(data, "VIP") then
		slots = slots + FX.VIPSlots
	end
	return math.min(slots, Balance.MaxPetSlotsWithPasses or 8)
end

function Stats.IncubatorSlots(data, hasPass)
	local n = 1
	if (data.Rebirths or 0) >= RebirthData.IncubatorSlotAt then
		n = n + 1
	end
	if hasPass or Stats.HasPass(data, "Incubator") then
		n = n + 1
	end
	return n
end

-- Ауры питомцев из семян
function Stats.Auras(data)
	local speed, splash = 0, 0
	for _, e in ipairs(Stats.EquippedPets(data)) do
		local def = PetsData.ById[e.Pet.Id]
		if def and def.Aura then
			local a = def.Aura
			if a.Kind == "Speed" then
				speed = speed + a.Value
			elseif a.Kind == "Splash" then
				splash = splash + a.Value
			elseif a.Kind == "Both" then
				splash = splash + a.Value
				speed = speed + 0.1
			end
		end
	end
	return speed, math.min(splash, 0.6)
end

function Stats.WalkSpeed(data)
	local lvl = Stats.PerkLevel(data, "WalkSpeed")
	local auraSpeed = Stats.Auras(data)
	local pass = Stats.HasPass(data, "Speed") and FX.Speed or 1
	return Balance.BaseWalkSpeed * (1 + perkById.WalkSpeed.PerLevel * lvl) * (1 + auraSpeed) * pass
end

function Stats.PickupRadius(data)
	local lvl = Stats.PerkLevel(data, "Magnet")
	if lvl <= 0 then
		return Balance.BasePickupRadius
	end
	return perkById.Magnet.Radius[math.min(lvl, #perkById.Magnet.Radius)]
end

function Stats.RebirthCost(data)
	return RebirthData.BaseCoins * math.pow(RebirthData.CoinScale, data.Rebirths or 0)
end

function Stats.RebirthShards(data)
	local shards = RebirthData.BaseShards
	if (data.UnlockedBiome or 1) >= 5 then
		shards = shards + RebirthData.ShardsPerExtraBiome
	end
	return shards
end

function Stats.CanRebirth(data)
	return (data.UnlockedBiome or 1) >= RebirthData.RequiredBiome and (data.Coins or 0) >= Stats.RebirthCost(data)
end

-- Глубина в метрах по номеру биома и координате Y (верх шахты = 0, низ = -100).
function Stats.DepthAt(biomeId, y)
	local biome = BiomesData[biomeId]
	if not biome then
		return 0
	end
	local total = Balance.Layers * Balance.BlockSize
	local t = math.clamp(-y / total, 0, 1)
	return biome.MinDepth + (biome.MaxDepth - biome.MinDepth) * t
end

-- Шлюз в следующий ярус открывается только с топовым буром этого яруса
function Stats.GateDrill(biome)
	return DrillsData.TopOf[biome]
end

function Stats.CanOpenGate(data, biome)
	local top = DrillsData.TopOf[biome]
	return top == nil or (data.OwnedDrills and data.OwnedDrills[top.Id]) == true
end

-- Покупка по порядку: предмет доступен, только если куплены все предыдущие.
-- Возвращает "owned" | "next" | "locked" и предмет, который нужно купить раньше.
function Stats.ShopState(data, kind, item)
	local list = kind == "Drill" and DrillsData.List or BackpacksData.List
	local owned = (kind == "Drill" and data.OwnedDrills or data.OwnedBackpacks) or {}
	if owned[item.Id] then
		return "owned"
	end
	for i = 1, item.Index - 1 do
		if not owned[list[i].Id] then
			return "locked", list[i]
		end
	end
	return "next"
end

-- вместимость инвентаря питомцев
function Stats.PetStorage(data)
	local n = Balance.BasePetStorage + Balance.PetStorageStep * (data.PetStorageLevel or 0)
	if Stats.HasPass(data, "Storage100") then
		n = n + 100
	end
	return math.min(n, Balance.PetStorageMax or 500)
end

-- цена следующих +10 мест (nil — больше докупать нельзя)
function Stats.PetStorageCost(data)
	local lvl = data.PetStorageLevel or 0
	if lvl >= Balance.PetStorageMaxBuys then
		return nil
	end
	return Balance.PetStorageBaseCost * math.pow(Balance.PetStorageCostGrow, lvl)
end

function Stats.PetCount(data)
	local n = 0
	for _ in pairs(data.Pets or {}) do
		n = n + 1
	end
	return n
end

return Stats
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000019"><Properties><string name="Name">Util</string><ProtectedString name="Source"><![CDATA[-- Util: форматирование чисел, интерполяция, взвешенный выбор и прочие мелочи.
local Util = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

local function trimZeros(s)
	if string.find(s, "%.") then
		s = string.gsub(s, "0+$", "")
		s = string.gsub(s, "%.$", "")
	end
	return s
end

-- 1234567 -> "1.23M"
function Util.Format(n)
	n = tonumber(n) or 0
	if n ~= n then
		return "0"
	end
	local neg = n < 0
	if neg then
		n = -n
	end
	local out
	if n < 1000 then
		if n == math.floor(n) then
			out = tostring(math.floor(n))
		else
			out = trimZeros(string.format("%.1f", n))
		end
	else
		local i = 1
		while n >= 1000 and i < #SUFFIXES do
			n = n / 1000
			i = i + 1
		end
		local fmt
		if n < 10 then
			fmt = "%.2f"
		elseif n < 100 then
			fmt = "%.1f"
		else
			fmt = "%.0f"
		end
		out = trimZeros(string.format(fmt, n)) .. SUFFIXES[i]
	end
	if neg then
		out = "-" .. out
	end
	return out
end

-- 1234567 -> "1 234 567"
function Util.Commas(n)
	n = math.floor(tonumber(n) or 0)
	local s = tostring(math.abs(n))
	if #s > 15 then
		return Util.Format(n)
	end
	local out = string.reverse(string.gsub(string.reverse(s), "(%d%d%d)", "%1 "))
	out = string.gsub(out, "^ ", "")
	if n < 0 then
		out = "-" .. out
	end
	return out
end

function Util.Mult(n)
	return "x" .. Util.Format(n)
end

-- 3725 -> "1:02:05", 125 -> "2:05"
function Util.Time(sec)
	sec = math.max(0, math.floor(sec or 0))
	local h = math.floor(sec / 3600)
	local m = math.floor((sec % 3600) / 60)
	local s = sec % 60
	if h > 0 then
		return string.format("%d:%02d:%02d", h, m, s)
	end
	return string.format("%d:%02d", m, s)
end

function Util.Lerp(a, b, t)
	return a + (b - a) * t
end

function Util.Clamp(x, a, b)
	if x < a then
		return a
	elseif x > b then
		return b
	end
	return x
end

-- items = { {weight=..}, ... } или функция веса; rng = Random
function Util.WeightedPick(items, weightOf, rng)
	local total = 0
	for _, it in ipairs(items) do
		total = total + weightOf(it)
	end
	local roll = (rng and rng:NextNumber() or math.random()) * total
	local acc = 0
	for _, it in ipairs(items) do
		acc = acc + weightOf(it)
		if roll <= acc then
			return it
		end
	end
	return items[#items]
end

function Util.DeepCopy(t)
	if type(t) ~= "table" then
		return t
	end
	local out = {}
	for k, v in pairs(t) do
		out[k] = Util.DeepCopy(v)
	end
	return out
end

-- Дописывает в data недостающие поля из template (для обновлений сохранений).
function Util.Reconcile(data, template)
	for k, v in pairs(template) do
		if data[k] == nil then
			data[k] = Util.DeepCopy(v)
		elseif type(v) == "table" and type(data[k]) == "table" and next(v) ~= nil and #v == 0 then
			Util.Reconcile(data[k], v)
		end
	end
	return data
end

function Util.Color(t)
	return Color3.fromRGB(t[1], t[2], t[3])
end

function Util.Count(t)
	local n = 0
	for _ in pairs(t) do
		n = n + 1
	end
	return n
end

return Util
]]></ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX00000000000000000000000000000050"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX00000000000000000000000000000020"><Properties><string name="Name">Core</string></Properties><Item class="ModuleScript" referent="RBX0000000000000000000000000000001B"><Properties><string name="Name">DataManager</string><ProtectedString name="Source"><![CDATA[-- DataManager: загрузка и сохранение профилей игроков.
-- Аналог ProfileService на встроенном DataStoreService: сессионная блокировка,
-- автосейв, сохранение при выходе и при закрытии сервера, миграция новых полей.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Configs = ReplicatedStorage:WaitForChild("Configs")
local Balance = require(Configs.Balance)
local DrillsData = require(Configs.DrillsData)
local BackpacksData = require(Configs.BackpacksData)
local Util = require(ReplicatedStorage.Shared.Util)

local DataManager = {}
DataManager.Profiles = {}
DataManager.Session = {} -- данные, которые не сохраняются (счётчики за сессию)

local LOCK_TIMEOUT = 600
local store
local storeOk = pcall(function()
	store = DataStoreService:GetDataStore(Balance.DataStoreName)
end)
if not storeOk then
	store = nil
end

local loadedEvent = Instance.new("BindableEvent")
DataManager.Loaded = loadedEvent.Event

function DataManager.Template()
	return {
		Version = 1,
		Coins = 0,
		TotalCoins = 0,
		Shards = 0,
		Rebirths = 0,
		Drill = DrillsData.Starter,
		OwnedDrills = { [DrillsData.Starter] = true },
		Backpack = BackpacksData.Starter,
		OwnedBackpacks = { [BackpacksData.Starter] = true },
		Ore = { Count = 0, Value = 0 },
		UnlockedBiome = 1,
		CurrentBiome = 1,
		RunMaxDepth = 0,
		Pets = {},
		NextPetUid = 1,
		PetSlotBonus = 0,
		AutoDelete = {}, -- [Id питомца] = true — удалять сразу при выпадении из яйца
		PetStorageLevel = 0, -- сколько раз докуплено +10 мест в инвентаре питомцев
		Seeds = {},
		Incubator = {},
		Boosts = { CoinElixir = 0, DrillOvercharge = 0, LuckyCharm = 0, BioFertilizer = 0 },
		Passes = {}, -- [Key] = true — купленные/выданные геймпасы
		ActiveBoosts = { CoinElixir = 0, DrillOvercharge = 0, LuckyCharm = 0 },
		Perks = { DrillSpeed = 0, Capacity = 0, WalkSpeed = 0, Magnet = 0, PetSlot = 0 },
		StoryIndex = 1,
		Daily = { Streak = 0, Last = 0 },
		WheelLast = 0,
		Dynamic = {},
		QuestHistory = {},
		Weekly = { Week = 0, Quests = {}, BonusClaimed = false },
		TutorialStep = 0,
		Settings = { Quality = "", Music = 0.5, Sfx = 0.75 },
		Index = {},
		Stats = {
			BlocksBroken = 0, Biome1Blocks = 0, AmberBlocks = 0, IceBlocks = 0,
			EggsOpened = 0, EggsBiome1 = 0, MaxDepth = 0, TotalDamage = 0,
			SeedsPlanted = 0, SeedsGrown = 0, RareSeedsGrown = 0, GoldenCrafted = 0,
			Crits = 0, Sells = 0, PlayTime = 0, DailyClaims = 0, WheelSpins = 0,
			QuestsDone = 0, WeeklyDone = 0, Nuggets = 0, VeinsBroken = 0,
		},
		Tutorial = true,
	}
end

local function keyFor(player)
	return "Player_" .. player.UserId
end

local function cleanForSave(data)
	local copy = Util.DeepCopy(data)
	return copy
end

function DataManager.Get(player)
	return DataManager.Profiles[player]
end

function DataManager.GetSession(player)
	local s = DataManager.Session[player]
	if not s then
		s = { Eggs = 0, LastSellFull = false }
		DataManager.Session[player] = s
	end
	return s
end

local function tryLoad(player)
	if not store then
		return nil, "nostore"
	end
	local key = keyFor(player)
	local result
	for attempt = 1, 6 do
		local locked = false
		local ok, err = pcall(function()
			store:UpdateAsync(key, function(old)
				old = old or {}
				local lock = old._Lock
				if lock and lock.Job ~= game.JobId and (os.time() - (lock.Time or 0)) < LOCK_TIMEOUT and attempt < 6 then
					locked = true
					return nil
				end
				old._Lock = { Job = game.JobId, Time = os.time() }
				result = old
				return old
			end)
		end)
		if ok and not locked then
			return result
		end
		if not ok then
			warn("[DataManager] ошибка загрузки:", err)
		end
		if not player.Parent then
			return nil, "left"
		end
		task.wait(locked and 4 or 2)
	end
	return nil, "failed"
end

function DataManager.Load(player)
	local raw, err = tryLoad(player)
	if not player.Parent then
		return
	end
	local data
	if raw then
		raw._Lock = nil
		data = Util.Reconcile(raw, DataManager.Template())
	else
		data = DataManager.Template()
		if err == "nostore" then
			warn("[DataManager] DataStore недоступен (в Studio включите Game Settings → Security → Enable Studio Access to API Services). Прогресс не сохранится.")
		elseif err == "failed" then
			warn("[DataManager] не удалось загрузить данные, прогресс этой сессии не будет сохранён", player.Name)
		end
		data._NoSave = (err ~= nil)
	end
	data.Ore = data.Ore or { Count = 0, Value = 0 }
	DataManager.Profiles[player] = data
	DataManager.GetSession(player)
	loadedEvent:Fire(player, data)
	return data
end

function DataManager.Save(player, release)
	local data = DataManager.Profiles[player]
	if not data or data._NoSave or not store then
		return
	end
	local copy = cleanForSave(data)
	copy._NoSave = nil
	local key = keyFor(player)
	for attempt = 1, 3 do
		local ok, err = pcall(function()
			store:UpdateAsync(key, function(old)
				if old and old._Lock and old._Lock.Job ~= game.JobId then
					-- кто-то другой захватил профиль — не перезаписываем
					return nil
				end
				if release then
					copy._Lock = nil
				else
					copy._Lock = { Job = game.JobId, Time = os.time() }
				end
				return copy
			end)
		end)
		if ok then
			return true
		end
		warn("[DataManager] ошибка сохранения:", err)
		task.wait(1)
	end
	return false
end

function DataManager.Release(player)
	DataManager.Save(player, true)
	DataManager.Profiles[player] = nil
	DataManager.Session[player] = nil
end

function DataManager.Init()
	task.spawn(function()
		while true do
			task.wait(Balance.AutoSaveInterval)
			for _, player in ipairs(Players:GetPlayers()) do
				if DataManager.Profiles[player] then
					task.spawn(DataManager.Save, player, false)
				end
			end
		end
	end)

	game:BindToClose(function()
		if RunService:IsStudio() and not store then
			return
		end
		local pending = 0
		for _, player in ipairs(Players:GetPlayers()) do
			if DataManager.Profiles[player] then
				pending = pending + 1
				task.spawn(function()
					DataManager.Save(player, true)
					pending = pending - 1
				end)
			end
		end
		local t = os.clock()
		while pending > 0 and os.clock() - t < 25 do
			task.wait(0.2)
		end
	end)
end

return DataManager
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000001C"><Properties><string name="Name">MineResetService</string><ProtectedString name="Source"><![CDATA[-- MineResetService: 20-минутный цикл вайпа шахт (ТЗ 6).
-- Время следующего вайпа лежит в атрибуте workspace.MineResetAt (unix), клиент рисует таймер.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Configs = ReplicatedStorage:WaitForChild("Configs")
local Balance = require(Configs.Balance)

local Notifier = require(script.Parent.Notifier)

local MineReset = {}

function MineReset.Start(Mining, Travel, DataManager)
	local function schedule()
		workspace:SetAttribute("MineResetAt", os.time() + Balance.ResetInterval)
	end

	local function startGoldRush()
		workspace:SetAttribute("GoldRushUntil", os.time() + Balance.GoldRushDuration)
		Notifier.AlertAll("GoldRush", { Duration = Balance.GoldRushDuration })
	end

	local function evacuate()
		for _, player in ipairs(Players:GetPlayers()) do
			local char = player.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if root and root.Position.Y < 0 then
				local data = DataManager.Get(player)
				local b = data and data.CurrentBiome or 1
				Travel.ToPod(player, b)
			end
		end
	end

	task.spawn(function()
		-- первая генерация шахт при старте сервера
		workspace:SetAttribute("GoldRushUntil", os.time() + Balance.GoldRushDuration)
		Mining.ResetAll()
		schedule()
		while true do
			local warned1, warned2, evacuated = false, false, false
			while true do
				local left = (workspace:GetAttribute("MineResetAt") or 0) - os.time()
				if left <= Balance.ResetWarn1 and not warned1 then
					warned1 = true
					Notifier.AlertAll("ResetWarn", { Seconds = Balance.ResetWarn1, Level = 1 })
				end
				if left <= Balance.ResetWarn2 and not warned2 then
					warned2 = true
					Notifier.AlertAll("ResetWarn", { Seconds = Balance.ResetWarn2, Level = 2 })
				end
				if left <= 1 and not evacuated then
					evacuated = true
					evacuate()
				end
				if left <= 0 then
					break
				end
				task.wait(0.25)
			end
			Notifier.AlertAll("Reset", {})
			startGoldRush()
			Mining.ResetAll()
			schedule()
		end
	end)
end

return MineReset
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000001D"><Properties><string name="Name">Notifier</string><ProtectedString name="Source"><![CDATA[-- Notifier: тосты, баннеры и всплывающие монеты для клиентов.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Net = require(ReplicatedStorage.Shared.Net)

local Notifier = {}

-- kind: "info" | "good" | "warn" | "error" | "seed" | "unlock"
function Notifier.Toast(player, text, kind, sound)
	Net.Get("Notify"):FireClient(player, text, kind or "info", sound)
end

function Notifier.ToastAll(text, kind, sound)
	Net.Get("Notify"):FireAllClients(text, kind or "info", sound)
end

-- Баннер (вайп шахты и т.п.)
function Notifier.Alert(player, kind, payload)
	Net.Get("SystemAlert"):FireClient(player, kind, payload)
end

function Notifier.AlertAll(kind, payload)
	Net.Get("SystemAlert"):FireAllClients(kind, payload)
end

function Notifier.Coins(player, amount, where)
	Net.Get("CoinsGained"):FireClient(player, amount, where)
end

return Notifier
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX0000000000000000000000000000001E"><Properties><string name="Name">PlayerInit</string><ProtectedString name="Source"><![CDATA[-- PlayerInit: точка входа сервера. Собирает ассеты и мир, запускает все сервисы,
-- загружает профили игроков и готовит персонажей.
local Players = game:GetService("Players")
local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")
local StarterPlayer = game:GetService("StarterPlayer")

local Configs = ReplicatedStorage:WaitForChild("Configs")
local Balance = require(Configs.Balance)
local Stats = require(ReplicatedStorage.Shared.Stats)
local Net = require(ReplicatedStorage.Shared.Net)

local Core = script.Parent
local Managers = script.Parent.Parent:WaitForChild("Managers")

Net.Init()

-- Коллизии: игроки проходят друг сквозь друга (ТЗ 1.3)
pcall(function()
	PhysicsService:RegisterCollisionGroup("Players")
end)
PhysicsService:CollisionGroupSetCollidable("Players", "Players", false)
-- осколки блоков (клиентские) не толкают игроков и друг друга
pcall(function()
	PhysicsService:RegisterCollisionGroup("Debris")
end)
PhysicsService:CollisionGroupSetCollidable("Debris", "Players", false)
PhysicsService:CollisionGroupSetCollidable("Debris", "Debris", false)

StarterPlayer.CharacterWalkSpeed = Balance.BaseWalkSpeed
StarterPlayer.CharacterJumpPower = 50
StarterPlayer.CameraMaxZoomDistance = 80
Players.RespawnTime = 2

local DataManager = require(Core.DataManager)
local StateSync = require(Core.StateSync)
local Notifier = require(Core.Notifier)
local MineReset = require(Core.MineResetService)

local AssetForge = require(Managers.AssetForge)
local WorldBuilder = require(Managers.WorldBuilder)
local QuestService = require(Managers.QuestService)
local Mining = require(Managers.MiningManager)
local Travel = require(Managers.TravelManager)
local PetManager = require(Managers.PetManager)
local Incubator = require(Managers.IncubatorManager)
local Shop = require(Managers.ShopManager)
local Boosts = require(Managers.BoostManager)
local Rebirth = require(Managers.RebirthManager)
local Admin = require(Managers.AdminCommands)
local RewardsManager = require(Managers.RewardsManager)
local Leaderboards = require(Managers.LeaderboardService)
local Passes = require(Managers.PassManager)

local assets = AssetForge.Build()
local points = WorldBuilder.Build(assets)

DataManager.Init()
StateSync.Init()
Travel.Init()
Mining.Init(Travel)
QuestService.Init()
local npcList = {}
for _, pts in pairs(points) do
	table.insert(npcList, pts.NPC)
end
QuestService.SetNpcPositions(npcList)
PetManager.Init()
Incubator.Init()
Shop.Init()
Boosts.Init()
Rebirth.Init()
RewardsManager.Init()
Leaderboards.Init()
Passes.Init()
Admin.Init(Mining, Travel, Passes)

-- настройки игрока (графика и громкость) — только проверенные значения
local QUALITIES = { Low = true, Medium = true, High = true }
Net.Get("SaveSettings").OnServerEvent:Connect(function(player, key, value)
	local data = DataManager.Get(player)
	if not data then
		return
	end
	data.Settings = data.Settings or {}
	if key == "Quality" and QUALITIES[value] then
		data.Settings.Quality = value
	elseif (key == "Music" or key == "Sfx") and type(value) == "number" and value == value then
		data.Settings[key] = math.clamp(value, 0, 1)
	else
		return
	end
	StateSync.MarkDirty(player)
end)
MineReset.Start(Mining, Travel, DataManager)
workspace:SetAttribute("WorldReady", true)

---------------------------------------------------------------------------------------------
-- Персонаж
---------------------------------------------------------------------------------------------
local function setGroup(inst)
	if inst:IsA("BasePart") then
		inst.CollisionGroup = "Players"
	end
end

local function onCharacter(player, char)
	for _, d in ipairs(char:GetDescendants()) do
		setGroup(d)
	end
	char.DescendantAdded:Connect(setGroup)
	local hum = char:WaitForChild("Humanoid", 10)
	local root = char:WaitForChild("HumanoidRootPart", 10)
	if not hum or not root then
		return
	end
	local data = DataManager.Get(player)
	while not data and player.Parent do
		task.wait(0.2)
		data = DataManager.Get(player)
	end
	if not data then
		return
	end
	hum.WalkSpeed = Stats.WalkSpeed(data)
	hum.BreakJointsOnDeath = false
	task.wait()
	Travel.ToHub(player)
	Shop.AttachGear(player)
	PetManager.RefreshAttribute(player)
end

local function onPlayer(player)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	ls.Parent = player
	local coins = Instance.new("StringValue")
	coins.Name = "Монеты"
	coins.Value = "0"
	coins.Parent = ls
	local eggs = Instance.new("StringValue")
	eggs.Name = "Яйца"
	eggs.Value = "0"
	eggs.Parent = ls
	local reb = Instance.new("IntValue")
	reb.Name = "Перерождения"
	reb.Parent = ls

	player.CharacterAdded:Connect(function(char)
		onCharacter(player, char)
	end)

	local data = DataManager.Load(player)
	if not data then
		return
	end
	StateSync.SendNow(player)
	if player.Character then
		task.spawn(onCharacter, player, player.Character)
	end
	task.delay(2, function()
		if player.Parent then
			Notifier.Toast(player, "Добро пожаловать в Chrono-Drill! Зажми ЛКМ по блоку, чтобы бурить.", "info")
			if Admin.Allowed(player) then
				Notifier.Toast(player, "Ты админ: панель разработчика — F2 или кнопка со щитом. В чате: !coins 1m", "info")
			end
		end
	end)
end

Players.PlayerAdded:Connect(onPlayer)
for _, p in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayer, p)
end

Players.PlayerRemoving:Connect(function(player)
	DataManager.Release(player)
end)

-- покупка геймпассов — в Managers/PassManager.lua
]]></ProtectedString><bool name="Disabled">false</bool></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000001F"><Properties><string name="Name">StateSync</string><ProtectedString name="Source"><![CDATA[-- StateSync: отправляет клиенту снимок его данных + производные характеристики.
-- Изменения помечаются Dirty и пачкой улетают не чаще 6 раз в секунду.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Stats = require(ReplicatedStorage.Shared.Stats)
local Util = require(ReplicatedStorage.Shared.Util)
local Net = require(ReplicatedStorage.Shared.Net)
local DataManager = require(script.Parent.DataManager)

local StateSync = {}
local dirty = {}
local passCache = {}

function StateSync.SetPass(player, value)
	passCache[player] = value
	StateSync.MarkDirty(player)
end

function StateSync.HasPass(player)
	return passCache[player] == true
end

function StateSync.MarkDirty(player)
	dirty[player] = true
end

local function leaderstats(player, data)
	local ls = player:FindFirstChild("leaderstats")
	if not ls then
		return
	end
	local coins = ls:FindFirstChild("Монеты")
	if coins then
		coins.Value = Util.Format(data.Coins)
	end
	local eggs = ls:FindFirstChild("Яйца")
	if eggs then
		eggs.Value = Util.Format(data.Stats and data.Stats.EggsOpened or 0)
	end
	local reb = ls:FindFirstChild("Перерождения")
	if reb then
		reb.Value = data.Rebirths
	end
end

function StateSync.Snapshot(player)
	local data = DataManager.Get(player)
	if not data then
		return nil
	end
	local session = DataManager.GetSession(player)
	local snap = {}
	for k, v in pairs(data) do
		if string.sub(k, 1, 1) ~= "_" then
			snap[k] = v
		end
	end
	local hasPass = StateSync.HasPass(player)
	snap.Derived = {
		Damage = Stats.Damage(data),
		PetSum = Stats.PetSum(data),
		Capacity = Stats.Capacity(data),
		SellMult = Stats.SellMult(data, data.CurrentBiome),
		CoinFactor = Stats.PetCoinFactor(data),
		RebirthMult = Stats.RebirthMult(data),
		PetSlots = Stats.PetSlots(data),
		IncubatorSlots = Stats.IncubatorSlots(data, hasPass),
		HitInterval = Stats.HitInterval(data),
		WalkSpeed = Stats.WalkSpeed(data),
		PickupRadius = Stats.PickupRadius(data),
		RebirthCost = Stats.RebirthCost(data),
		RebirthShards = Stats.RebirthShards(data),
		CanRebirth = Stats.CanRebirth(data),
		HasIncubatorPass = hasPass,
		SessionEggs = session.Eggs,
		ServerTime = os.time(),
		NoSave = data._NoSave == true,
	}
	return snap
end

function StateSync.SendNow(player)
	local snap = StateSync.Snapshot(player)
	if snap then
		Net.Get("DataSync"):FireClient(player, snap)
		local data = DataManager.Get(player)
		leaderstats(player, data)
	end
	dirty[player] = nil
end

function StateSync.Init()
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc = acc + dt
		if acc < 0.25 then
			return
		end
		acc = 0
		for player in pairs(dirty) do
			if player.Parent then
				StateSync.SendNow(player)
			else
				dirty[player] = nil
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		dirty[player] = nil
		passCache[player] = nil
	end)
	Net.Get("RequestSync").OnServerInvoke = function(player)
		return StateSync.Snapshot(player)
	end
end

return StateSync
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX00000000000000000000000000000030"><Properties><string name="Name">Managers</string></Properties><Item class="ModuleScript" referent="RBX00000000000000000000000000000021"><Properties><string name="Name">AdminCommands</string><ProtectedString name="Source"><![CDATA[-- AdminCommands: консоль разработчика. Доступ — в Studio, владельцу плейса, админам группы (ранг 254+)
-- и тем, чей UserId вписан в EXTRA_ADMINS. Открывается клавишей F2 (или кнопкой «Консоль» у админа).
-- Те же команды работают и в чате: !coins 1e9  (или /coins 1e9)
--
-- Цель команды: по умолчанию ты сам. Чтобы применить к другому игроку, добавь @ник в конце:
--   coins 1e6 @Player2      ·  всем на сервере: coins 1e6 @all
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Configs = ReplicatedStorage:WaitForChild("Configs")
local SeedsData = require(Configs.SeedsData)
local BoostsData = require(Configs.BoostsData)
local DrillsData = require(Configs.DrillsData)
local BackpacksData = require(Configs.BackpacksData)
local PetsData = require(Configs.PetsData)
local BiomesData = require(Configs.BiomesData)
local Balance = require(Configs.Balance)
local Util = require(ReplicatedStorage.Shared.Util)
local Stats = require(ReplicatedStorage.Shared.Stats)
local Net = require(ReplicatedStorage.Shared.Net)

local Core = script.Parent.Parent.Core
local DataManager = require(Core.DataManager)
local StateSync = require(Core.StateSync)
local Notifier = require(Core.Notifier)

local EXTRA_ADMINS = {
	-- [12345678] = true,
}

local GamepassesData = require(Configs.GamepassesData)

local Admin = {}
local Mining, Travel, Passes

local function allowed(player)
	if RunService:IsStudio() or EXTRA_ADMINS[player.UserId] then
		return true
	end
	if game.CreatorType == Enum.CreatorType.User then
		return player.UserId == game.CreatorId
	end
	local ok, rank = pcall(function()
		return player:GetRankInGroup(game.CreatorId)
	end)
	return ok and rank >= 254
end
Admin.Allowed = allowed

local function num(s, default)
	if s == nil then
		return default
	end
	s = string.lower(s)
	local mult = 1
	local last = string.sub(s, -1)
	local suffix = { k = 1e3, m = 1e6, b = 1e9, t = 1e12, q = 1e15 }
	if suffix[last] then
		mult = suffix[last]
		s = string.sub(s, 1, -2)
	end
	local n = tonumber(s)
	return n and n * mult or default
end

local function findPet(name)
	if not name then
		return nil
	end
	if PetsData.ById[name] then
		return name
	end
	local low = string.lower(name)
	for id, def in pairs(PetsData.ById) do
		if string.lower(id) == low or string.lower(def.Name) == low then
			return id
		end
	end
	for id, def in pairs(PetsData.ById) do
		if string.find(string.lower(id), low, 1, true) or string.find(string.lower(def.Name), low, 1, true) then
			return id
		end
	end
	return nil
end

local function refresh(player)
	local PetManager = require(script.Parent.PetManager)
	local Shop = require(script.Parent.ShopManager)
	pcall(Shop.AttachGear, player)
	pcall(PetManager.RefreshAttribute, player)
	StateSync.MarkDirty(player)
end

-- команды: { args, описание, функция(player, data, args) -> текст }
local COMMANDS = {}
local ORDER = {}
local function cmd(name, usage, desc, fn)
	COMMANDS[name] = { Usage = usage, Desc = desc, Fn = fn }
	table.insert(ORDER, name)
end

cmd("help", "", "список команд", function()
	local lines = {}
	for _, n in ipairs(ORDER) do
		local c = COMMANDS[n]
		table.insert(lines, n .. (c.Usage ~= "" and (" " .. c.Usage) or "") .. " — " .. c.Desc)
	end
	return table.concat(lines, "\n")
end)

cmd("coins", "<n>", "добавить монет (можно 5k, 2m, 3b, 1t)", function(_, data, a)
	local n = num(a[1], 1e6)
	data.Coins = data.Coins + n
	data.TotalCoins = data.TotalCoins + math.max(0, n)
	return "Монеты: " .. Util.Format(data.Coins)
end)

cmd("setcoins", "<n>", "установить монеты", function(_, data, a)
	data.Coins = math.max(0, num(a[1], 0))
	return "Монеты: " .. Util.Format(data.Coins)
end)

cmd("unlock", "<1-5>", "открыть ярусы до N", function(_, data, a)
	data.UnlockedBiome = math.clamp(math.floor(num(a[1], 5)), 1, #BiomesData)
	return "Открыто ярусов: " .. data.UnlockedBiome
end)

cmd("drill", "<номер|max>", "выдать буры до номера (и надеть)", function(_, data, a)
	local n = a[1] == "max" and #DrillsData.List or math.clamp(math.floor(num(a[1], 1)), 1, #DrillsData.List)
	for i = 1, n do
		data.OwnedDrills[DrillsData.List[i].Id] = true
	end
	data.Drill = DrillsData.List[n].Id
	return "Бур: " .. DrillsData.List[n].Name .. " (урон " .. Util.Format(DrillsData.List[n].Damage) .. ")"
end)

cmd("pack", "<номер|max>", "выдать рюкзаки до номера (и надеть)", function(_, data, a)
	local n = a[1] == "max" and #BackpacksData.List or math.clamp(math.floor(num(a[1], 1)), 1, #BackpacksData.List)
	for i = 1, n do
		data.OwnedBackpacks[BackpacksData.List[i].Id] = true
	end
	data.Backpack = BackpacksData.List[n].Id
	return "Рюкзак: " .. BackpacksData.List[n].Name .. " (" .. Util.Format(BackpacksData.List[n].Capacity) .. ")"
end)

cmd("pet", "<id|имя> [улучш. 0-5] [уровень] [кол-во]", "выдать питомца", function(_, data, a)
	local id = findPet(a[1])
	if not id then
		return "Питомец не найден. Пример: pet Worm 2 10"
	end
	local PetManager = require(script.Parent.PetManager)
	local tier = math.clamp(math.floor(num(a[2], 0)), 0, #Balance.PetTiers - 1)
	local level = math.clamp(math.floor(num(a[3], 1)), 1, Balance.PetMaxLevel)
	local count = math.clamp(math.floor(num(a[4], 1)), 1, 50)
	local def = PetsData.ById[id]
	local power = nil
	if def.Special or def.Seed then
		power = def.P
	end
	for _ = 1, count do
		local uid = PetManager.AddPet(data, id, power, tier)
		data.Pets[uid].L = level
	end
	return "Выдано: " .. def.Name .. " x" .. count .. " (улучш. " .. tier .. ", ур. " .. level .. ")"
end)

cmd("pets", "", "список Id питомцев", function()
	local ids = {}
	for id in pairs(PetsData.ById) do
		table.insert(ids, id)
	end
	table.sort(ids)
	return table.concat(ids, ", ")
end)

cmd("clearpets", "", "удалить всех питомцев", function(_, data)
	data.Pets = {}
	return "Питомцы удалены"
end)

cmd("petlevel", "<уровень>", "уровень всем надетым питомцам", function(_, data, a)
	local lvl = math.clamp(math.floor(num(a[1], Balance.PetMaxLevel)), 1, Balance.PetMaxLevel)
	local n = 0
	for _, p in pairs(data.Pets) do
		if p.E then
			p.L = lvl
			p.X = 0
			n = n + 1
		end
	end
	return "Уровень " .. lvl .. " у " .. n .. " питомцев"
end)

cmd("boosts", "[n]", "по N каждого буста", function(_, data, a)
