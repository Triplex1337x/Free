		},
	},
	-- СКАЗОЧНОЕ ЯЙЦО: 4-е яйцо первого яруса (в конце списка, чтобы не сдвигать силу остальных яиц).
	-- PowerIndex = 3.5 — сила питомцев между Пушистым (3) и Окаменелым (4) яйцом.
	{
		Id = "Fairy", Name = "Сказочное яйцо", Biome = 1, Price = 150000, Slot = 4, PowerIndex = 3.5,
		Look = { Base = rgb(236, 214, 255), Accent = rgb(255, 150, 210), Band = rgb(255, 214, 90), Pattern = "spots" },
		Pets = {
			{ "MushroomPup", "Грибной Щенок", 46.0, 0 },
			{ "PetalBunny", "Лепестковый Зайка", 24.0, 0 },
			{ "MossTurtle", "Моховая Черепашка", 15.0, 0 },
			{ "GlowJelly", "Светящаяся Медуза", 11.0, 0 },
			{ "FairyFox", "Фея-Лисичка", 3.0, 0 },
			{ "CrystalDeer", "Хрустальный Олень", 0.9, 0 },
			{ "FairyQueen", "Королева Фей", 0.09, 0, "Mythic" },
			{ "HugeBloomDragon", "Огромный Цветочный Дракон", 0.01, 0, "Huge" },
		},
	},
}

local byId = {}
for _, egg in ipairs(Eggs) do
	byId[egg.Id] = egg
end

return {
	List = Eggs,
	ById = byId,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000007"><Properties><string name="Name">GamepassesData</string><ProtectedString name="Source"><![CDATA[-- GamepassesData: геймпассы доната (магазин «Донат» в меню).
--
-- КАК ПОДКЛЮЧИТЬ: Creator Hub → твоя игра → Monetization → Passes → Create a Pass.
-- Скопируй ID пасса и впиши в поле Id нужной строки (вместо 0). Цену (Price) поставь ту же,
-- что указал на сайте, — она только показывается в меню.
-- Пока Id = 0, кнопка «Купить» пишет, что пасс не настроен (а админ может выдать пасс в F2).
local List = {
	{ Key = "VIP", Name = "VIP", Desc = "x1.25 монет и урона, +1 слот питомца, VIP-тег над головой", Price = 399, Glyph = "Crown", Color = { 255, 190, 40 }, Id = 0 },
	{ Key = "Coins2x", Name = "x2 Монеты", Desc = "Вся руда продаётся в 2 раза дороже", Price = 349, Glyph = "Coin", Color = { 255, 160, 30 }, Id = 0 },
	{ Key = "Damage2x", Name = "x2 Урон", Desc = "Бур бьёт в 2 раза сильнее", Price = 299, Glyph = "Pickaxe", Color = { 255, 84, 84 }, Id = 0 },
	{ Key = "Lucky", Name = "Удача", Desc = "x2 шанс редких, легендарных и мифических питомцев", Price = 249, Glyph = "Clover", Color = { 70, 205, 100 }, Id = 0 },
	{ Key = "HatchX8", Name = "Открытие x8", Desc = "Открывай сразу 8 яиц за раз", Price = 299, Glyph = "Egg", Color = { 170, 110, 255 }, Id = 0 },
	{ Key = "PetSlots", Name = "+2 питомца", Desc = "Надевай одновременно на 2 питомца больше", Price = 199, Glyph = "Paw", Color = { 255, 130, 60 }, Id = 0 },
	{ Key = "Storage100", Name = "+100 мест", Desc = "Инвентарь питомцев больше на 100 мест", Price = 149, Glyph = "Chest", Color = { 150, 100, 230 }, Id = 0 },
	{ Key = "BigBackpack", Name = "x2 Рюкзак", Desc = "Рюкзак вмещает в 2 раза больше руды", Price = 149, Glyph = "Backpack", Color = { 60, 150, 255 }, Id = 0 },
	{ Key = "AutoHatch", Name = "Автооткрытие", Desc = "Кнопка «Авто» в окне яйца: яйца открываются сами", Price = 299, Glyph = "Bolt", Color = { 40, 200, 190 }, Id = 0 },
	{ Key = "InfiniteBackpack", Name = "Бесконечный рюкзак", Desc = "ЭКСКЛЮЗИВ: рюкзак никогда не заполняется", Price = 3999, Glyph = "Backpack", Color = { 255, 70, 140 }, Id = 0, Exclusive = true },
	{ Key = "Speed", Name = "Быстрые ноги", Desc = "+30% к скорости бега", Price = 99, Glyph = "Rocket", Color = { 255, 100, 170 }, Id = 0 },
	{ Key = "Incubator", Name = "Слот инкубатора", Desc = "3-й слот для семян в инкубаторе", Price = 149, Glyph = "Sprout", Color = { 110, 200, 70 }, Id = 0 },
}

-- силы пассов (используются в Stats)
local Effects = {
	VIPCoins = 1.25,
	VIPDamage = 1.25,
	VIPSlots = 1,
	Coins2x = 2,
	Damage2x = 2,
	LuckyMult = 2,
	PetSlots = 2,
	BigBackpack = 2,
	Speed = 1.3,
}

local ById, ByKey = {}, {}
for i, p in ipairs(List) do
	p.Order = i
	ByKey[p.Key] = p
end

-- ID пасса (для слота инкубатора берём старое поле Balance.IncubatorGamepassId, если тут 0)
local function idOf(key)
	local p = ByKey[key]
	if not p then
		return 0
	end
	if p.Key == "Incubator" and (p.Id or 0) == 0 then
		local ok, Balance = pcall(function()
			return require(script.Parent.Balance)
		end)
		if ok and Balance.IncubatorGamepassId then
			return Balance.IncubatorGamepassId
		end
	end
	return p.Id or 0
end

local function rebuildIds()
	for k in pairs(ById) do
		ById[k] = nil
	end
	for _, p in ipairs(List) do
		local id = idOf(p.Key)
		if id ~= 0 then
			ById[id] = p
		end
	end
end
rebuildIds()

return {
	List = List,
	ByKey = ByKey,
	ById = ById,
	IdOf = idOf,
	Effects = Effects,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000008"><Properties><string name="Name">IconAtlas</string><ProtectedString name="Source"><![CDATA[-- IconAtlas: раскладка атласа цветных иконок (Icons/ChronoDrill_Icons.png).
-- Файл собирает tools/make_icons.py — раскладку руками не править.
--
-- Как включить: в Studio View -> Asset Manager -> Bulk Import -> Icons/ChronoDrill_Icons.png,
-- затем ПКМ по картинке -> Copy Asset ID и впиши его в Id ниже (можно просто число):
--   Id = "rbxassetid://1234567890",
-- Пока Id пустой, игра рисует прежние векторные иконки (UI/Icons2D).
-- Важно: нужен ID картинки (Image), а не декали (Decal) — подробности в README.
return {
	Id = "",
	Cell = 146,
	Columns = 7,
	Icons = {
		Coin = 0,
		Shard = 1,
		Paw = 2,
		Chest = 3,
		ShopBag = 4,
		Stats = 5,
		Gift = 6,
		Wheel = 7,
		Sprout = 8,
		Hourglass = 9,
		Globe = 10,
		Quest = 11,
		Pickaxe = 12,
		Home = 13,
		Clock = 14,
		Star = 15,
		Lock = 16,
		Bolt = 17,
		Clover = 18,
		Drop = 19,
		Flask = 20,
		Backpack = 21,
		Egg = 22,
		Sword = 23,
		Crown = 24,
		Rocket = 25,
		Gear = 26,
		Note = 27,
		Diamond = 28,
		Bone = 29,
		Snowflake = 30,
		Flame = 31,
		Saturn = 32,
		Shield = 33,
		Person = 34,
		Flag = 35,
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000009"><Properties><string name="Name">PetLooks</string><ProtectedString name="Source"><![CDATA[-- PetLooks: внешний вид каждого питомца для процедурного PetBuilder.
-- A  = архетип (quad, blob, bird, bug, crab, fish, dino, dragon, golem, orb, serpent, wisp, bat)
-- C  = основной цвет, C2 = акцентный цвет (живот, уши, когти), C3 = цвет деталей
-- M  = материал корпуса (SmoothPlastic по умолчанию), M2 = материал акцентов
-- X  = детали (уши, рога, крылья, ...), E = стиль глаз ("glow" — светящиеся)
-- Fly = летает ли питомец (по умолчанию определяется архетипом)
local function c(r, g, b) return { r, g, b } end

return {
	-- БИОМ 1 — Земляное яйцо
	Worm = { A = "serpent", C = c(240, 150, 160), C2 = c(255, 196, 200), X = { "cheeks" }, Fly = false },
	Mouse = { A = "quad", C = c(170, 172, 184), C2 = c(255, 190, 200), X = { "ears_round_big", "tail_thin", "whiskers", "nose", "cheeks" } },
	Mole = { A = "quad", C = c(94, 70, 62), C2 = c(255, 160, 180), X = { "claws", "nose_big", "whiskers" }, E = "small" },
	Hedgehog = { A = "quad", C = c(150, 104, 70), C2 = c(246, 220, 180), C3 = c(96, 64, 44), X = { "spikes_back", "nose", "cheeks" } },
	Armadillo = { A = "quad", C = c(200, 160, 120), C2 = c(236, 206, 170), C3 = c(160, 120, 86), X = { "shell", "ears_pointy", "tail_thin" } },

	-- Каменное яйцо
	Scarab = { A = "bug", C = c(46, 170, 140), C2 = c(30, 110, 96), C3 = c(255, 210, 80), M = "Metal", X = { "antennae", "horn_single" } },
	StoneCrab = { A = "crab", C = c(130, 140, 160), C2 = c(200, 120, 90), X = { "spots" } },
	CaveBat = { A = "bat", C = c(110, 80, 150), C2 = c(255, 170, 200), X = { "ears_pointy_big", "fangs" } },
	Badger = { A = "quad", C = c(60, 60, 68), C2 = c(244, 244, 246), X = { "stripe_head", "ears_round", "claws", "nose" } },
	IronPup = { A = "quad", C = c(150, 156, 170), C2 = c(90, 96, 110), C3 = c(255, 200, 60), M = "Metal", X = { "ears_pointy", "tail_thin", "bolts" }, E = "glow", EyeColor = c(100, 220, 255) },
	MicroGolem = { A = "golem", C = c(130, 126, 136), C2 = c(90, 220, 255), X = { "crystals", "moss" }, E = "glow", EyeColor = c(90, 230, 255) },

	-- БИОМ 2 — Окаменелое яйцо
	Anomalo = { A = "fish", C = c(230, 110, 70), C2 = c(255, 190, 120), X = { "feelers", "segments" } },
	Trilobite = { A = "bug", C = c(170, 140, 110), C2 = c(120, 96, 76), X = { "segments", "antennae" } },
	BabyRaptor = { A = "dino", C = c(100, 190, 90), C2 = c(236, 230, 160), X = { "crest_small", "claws", "stripes" } },
	Ptero = { A = "bird", C = c(150, 120, 190), C2 = c(255, 200, 140), X = { "wings_bat", "crest_long", "beak_long" } },
	Stego = { A = "dino", C = c(90, 160, 120), C2 = c(255, 150, 80), X = { "plates_back", "tail_spikes" } },
	SaberPup = { A = "quad", C = c(236, 160, 70), C2 = c(255, 236, 200), C3 = c(120, 70, 40), X = { "tusks_down", "ears_round", "stripes", "tail_thin" } },

	-- Янтарное яйцо
